---
/**
 * Planning di un centro — destinazione dei redirect da `/planning`,
 * `/planning-macerata` e `/planning-montecassiano`.
 *
 * Una pagina per centro invece di una sola con le tab: l'URL è condivisibile
 * (lo staff manda l'orario su WhatsApp) e "planning corsi Macerata" è una
 * ricerca che la gente fa davvero, quindi conviene avere una pagina indicizzabile
 * per ciascuno.
 */
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BandaCta from '../../components/BandaCta.astro';
import PlanningSettimana from '../../components/planning/PlanningSettimana.astro';
import { getCollection } from 'astro:content';
import { SEDI } from '../../config/forms';
import { slugSezione } from '../../config/planning';
import { PLANNING_ESEMPIO } from '../../data/planning-esempio';

export async function getStaticPaths() {
  const centri = await getCollection('centri', ({ data }) => data.stato === 'aperto');
  return centri.map((entry) => ({ params: { centro: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const c = entry.data;

const altri = (await getCollection('centri', ({ data }) => data.stato === 'aperto'))
  .sort((a, b) => a.data.ordine - b.data.ordine);

/** Le schede dei corsi: il componente tiene solo quelle che l'orario cita. */
const discipline = await getCollection('discipline');

/**
 * Un centro senza planning mostra i dati di esempio in sviluppo, e su un deploy
 * solo se qualcuno ha messo `PUBLIC_PLANNING_ESEMPIO=1` fra le variabili
 * d'ambiente.
 *
 * Serve a vedere il layout su un'anteprima finché PerfectGym non è collegato.
 * Non è il default e non lo diventa per sbaglio: un orario inventato su una
 * pagina pubblica indicizzata è peggio di una pagina vuota — chi lo legge esce
 * di casa per un corso che non esiste. La variabile va togliuta prima di
 * mandare online il dominio vero; l'avviso rosso in pagina resta visibile
 * intanto, e `docs/PLANNING.md` lo mette in checklist.
 */
const esempioAmmesso = import.meta.env.DEV || import.meta.env.PUBLIC_PLANNING_ESEMPIO === '1';
const usaEsempio = esempioAmmesso && c.planning.length === 0;
const lezioni = usaEsempio ? (PLANNING_ESEMPIO[entry.id] ?? []) : c.planning;

/**
 * Le lezioni con `sezione` escono dalla griglia principale e finiscono in una
 * sezione a parte in fondo (es. il CrossFit, che ha box, ritmi e prenotazioni
 * diversi dai corsi di sala). La chiave è il testo della sezione, così com'è
 * scritto nei contenuti: per questo gli schemi avvisano di non variarlo.
 */
const sezioni = new Map<string, typeof lezioni>();
const principali = lezioni.filter((l) => {
  const s = (l.sezione ?? '').trim();
  if (!s) return true;
  const gruppo = sezioni.get(s) ?? [];
  gruppo.push(l);
  sezioni.set(s, gruppo);
  return false;
});

/**
 * Accesso libero: la sala pesi ha gli orari del centro (`orari`), le altre
 * fasce (nuoto libero…) arrivano da `aperture`. Le fasce con lo stesso titolo
 * si raccolgono in una card sola, una riga per combinazione giorni-orario.
 */
const aperture = new Map<string, { giorni: string; orario: string; nota?: string | null }[]>();
for (const a of c.aperture ?? []) {
  const gruppo = aperture.get(a.titolo) ?? [];
  gruppo.push({ giorni: a.giorni, orario: a.orario, nota: a.nota });
  aperture.set(a.titolo, gruppo);
}
const chiuso = (v: string) => v.trim().toLowerCase().startsWith('chiuso');

const nome = c.nome.replace('Lume ', '');
const raccogliLead = Boolean(SEDI[entry.id]);
---

<Layout
  title={`Planning corsi ${nome} — Lume Fitness Club`}
  description={`Orario settimanale dei corsi del centro Lume di ${c.citta}: sala, acqua, Reformer e discipline su prenotazione. Prenota dal portale.`}
>
  <Header />

  <main>
    <section class="sec">
      <div class="wrap">
        <div class="sec-head">
          <span class="label">Planning</span>
          <h1 class="d">Corsi a {nome}</h1>
          <p>
            L’orario della settimana tipo. Le variazioni del giorno — una lezione spostata, un
            festivo — le trovi sul portale, dove prenoti il posto.
          </p>
        </div>

        {
          altri.length > 1 && (
            <nav class="pl-sedi" aria-label="Scegli il centro">
              {altri.map((a) => (
                <a
                  href={`/planning/${a.id}`}
                  class:list={['pl-sede', { on: a.id === entry.id }]}
                  aria-current={a.id === entry.id ? 'page' : undefined}
                >
                  {a.data.nome.replace('Lume ', '')}
                </a>
              ))}
            </nav>
          )
        }

        {c.planningNota && <p class="pl-nota">{c.planningNota}</p>}

        {
          (c.orari || aperture.size > 0) && (
            <section class="pl-aperture" aria-label="Accesso libero">
              <h2 class="pl-aperture-titolo">Accesso libero</h2>
              <div class="pl-aperture-grid">
                {c.orari && (
                  <div class="pl-apertura">
                    <h3>Sala pesi</h3>
                    <p>
                      <span>Lun – Ven</span>
                      <b>{c.orari.feriali}</b>
                    </p>
                    <p>
                      <span>Sabato</span>
                      <b>{c.orari.sabato}</b>
                    </p>
                    {!chiuso(c.orari.domenica) && (
                      <p>
                        <span>Domenica</span>
                        <b>{c.orari.domenica}</b>
                      </p>
                    )}
                  </div>
                )}
                {[...aperture].map(([titolo, fasce]) => (
                  <div class="pl-apertura">
                    <h3>{titolo}</h3>
                    {fasce.map((f) => (
                      <p>
                        <span>{f.giorni}</span>
                        <b>{f.orario}</b>
                      </p>
                    ))}
                    {fasce.map((f) => f.nota).filter(Boolean)[0] && (
                      <small>{fasce.map((f) => f.nota).filter(Boolean)[0]}</small>
                    )}
                  </div>
                ))}
              </div>
            </section>
          )
        }

        <PlanningSettimana
          centro={entry.id}
          lezioni={principali}
          aggiornatoIl={c.planningAggiornatoIl}
          prenotaUrl={c.perfectgymCorsiUrl}
          esempio={usaEsempio}
          schede={discipline}
          pdfUrl={lezioni.length > 0 ? `/planning/${entry.id}.pdf` : null}
        />

        {
          [...sezioni].map(([titolo, ll]) => (
            <section class="pl-sezione" aria-label={titolo}>
              <h2 class="pl-aperture-titolo">{titolo}</h2>
              <PlanningSettimana
                centro={entry.id}
                lezioni={ll}
                aggiornatoIl={c.planningAggiornatoIl}
                prenotaUrl={c.perfectgymCorsiUrl}
                esempio={usaEsempio}
                schede={discipline}
                pdfUrl={`/planning/${entry.id}/${slugSezione(titolo)}.pdf`}
                pdfLabel={`Scarica "${titolo}" in PDF`}
              />
            </section>
          ))
        }

        {
          raccogliLead && (
            <div style="margin-top:44px">
              <BandaCta
                titolo="Prova un corso prima di iscriverti"
                testo="Con il pass di una settimana entri in tutti quelli che vedi qui sopra, prenotazione inclusa."
              >
                <button
                  type="button"
                  class="btn btn-red btn-full"
                  data-open-form="prova"
                  data-medium={`Planning:${entry.id}`}
                  data-centro={entry.id}
                >
                  Prova 7 giorni
                </button>
                <button
                  type="button"
                  class="btn btn-out btn-full"
                  data-open-form="info"
                  data-medium={`PlanningInfo:${entry.id}`}
                  data-centro={entry.id}
                >
                  Chiedi informazioni
                </button>
              </BandaCta>
            </div>
          )
        }
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .pl-sedi {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 26px;
  }
  .pl-sede {
    border: 1px solid var(--line);
    border-radius: var(--lf-r-s);
    padding: 10px 18px;
    font-size: 14px;
    color: #bbb;
    transition: 0.15s;
  }
  .pl-sede:hover {
    border-color: #4a4a4a;
    color: #fff;
  }
  .pl-sede.on {
    border-color: var(--red);
    background: rgba(196, 0, 66, 0.14);
    color: #fff;
  }
  .pl-aperture {
    margin-bottom: 34px;
  }
  .pl-aperture-titolo {
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #8a8a8a;
    margin: 40px 0 14px;
  }
  .pl-aperture:first-of-type .pl-aperture-titolo {
    margin-top: 0;
  }
  .pl-aperture-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 12px;
  }
  .pl-apertura {
    border: 1px solid var(--line);
    border-radius: var(--lf-r-s);
    padding: 16px 18px;
  }
  .pl-apertura h3 {
    font-size: 16px;
    margin-bottom: 10px;
    color: #fff;
  }
  .pl-apertura p {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 14px;
    color: #b9b9b9;
    padding: 4px 0;
  }
  .pl-apertura p b {
    color: #fff;
    font-weight: 600;
    white-space: nowrap;
  }
  .pl-apertura small {
    display: block;
    margin-top: 8px;
    font-size: 12px;
    color: #8a8a8a;
  }
</style>

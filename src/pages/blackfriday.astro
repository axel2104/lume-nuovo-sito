---
/**
 * Landing delle ads Black Week Red Pass (23–30/11/2026).
 *
 * Struttura: hero con countdown → Lume Gold (un abbonamento, quattro club) →
 * Reformer (promo comune, in vista) → una sezione per club con la sua promo.
 * Testi e prezzi vengono da «BLACK WEEK aggiornata 2026.docx»: non cambiarli
 * qui senza cambiarli lì. Ogni sezione-club ha un'ancora (#macerata, ...) usata
 * dalle ads. I pulsanti vanno al calendario interno (/prenota) con centro e tipo
 * già scelti; gli UTM si propagano da soli (tracking.js).
 * Dopo FINE la pagina mostra «offerta terminata» da sola.
 */
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BfBento from '../components/BfBento.astro';

const FINE = '2026-11-30'; // lunedì, ore 20:00
// Prima di SVELA i prezzi del Reformer sono sfocati (valori finti nel markup, quelli veri in data-v, sostituiti dallo script).
// Prevendita Lume Val di Chienti: stessa scadenza della pagina promo.lumefitness.it/val-di-chienti
const PREVENDITA_FINE = '2026-11-29T19:00:00+01:00';
const PREVENDITA_URL = 'https://promo.lumefitness.it/val-di-chienti?utm_source=lumefitness&utm_medium=landing&utm_campaign=black-week-red-pass&utm_content=countdown-prevendita';
const SVELA = '2026-11-26T00:00:00+01:00'; // giovedì, mezzanotte: 24 ore prima dell'apertura del venerdì

// Tutti i pulsanti vanno al calendario interno (interna=1) con sede, tipo e offerta già scelti:
// l'offerta finisce nelle note dell'appuntamento, gli UTM li propaga tracking.js.
const pren = (centro: string, tipo: string, offerta: string) =>
  `/prenota?centro=${centro}&tipo=${tipo}&interna=1&offerta=${encodeURIComponent('Black Week Red Pass · ' + offerta)}`;

const servizi = ['Sala attrezzi', 'Piscina', 'Corsi di gruppo', 'Box CrossFit'];

const fasce = [
  { orario: '00:00 – 11:59', soci: '410 €', esterni: '555 €' },
  { orario: '12:00 – 17:59', soci: '440 €', esterni: '598 €' },
  { orario: '18:00 – 23:59', soci: '470 €', esterni: '639 €' },
];

// Ogni club usa lo STESSO schema (sezione, foto, tessere, nota Gold, pulsanti):
// per cambiare un'offerta si tocca solo questo elenco.
interface Tessera { segreto?: string; notaVera?: string; nome: string; prezzo: string; prima?: string; badge?: string; nota?: string; top?: boolean }
const clubs: { id: string; nome: string; label: string; lead: string; foto: { src: string; alt: string }[]; tessere: Tessera[] }[] = [
  {
    id: 'macerata',
    nome: 'Macerata',
    label: 'Club · Il centro completo',
    lead: 'Sala attrezzi, corsi di gruppo, Box CrossFit: vieni a scoprire il centro. Attiva qui o nelle altre sedi il tuo Gold.',
    foto: [
      { src: '/media/crossfit.jpg', alt: 'Il Box CrossFit di Lume Macerata' },
      { src: '/media/reformer.jpg', alt: 'La sala Reformer di Lume Macerata' },
      { src: '/media/weights.jpg', alt: 'La sala attrezzi di Lume Macerata' },
    ],
    tessere: [
      { nome: 'Lume Gold', prezzo: '800 €', prima: '900 €', nota: 'Quattro club, un solo abbonamento · soci: Gold Upgrade a 720 €', top: true },
      { nome: 'Black Reformer Friday', prezzo: '000 €', segreto: 'da 410 €', nota: 'Solo venerdì 27/11 · prezzo per fascia oraria · pacchetti limitati', notaVera: 'Solo venerdì 27/11 · prezzo per fascia oraria (esterni da 555 €) · pacchetti limitati' },
    ],
  },
  {
    id: 'montecassiano',
    nome: 'Montecassiano',
    label: 'Club · Palestra e piscina',
    lead: 'Iscrizione annuale di 12 mesi con la quota di attivazione <b>dimezzata: 25 € invece di 50 €</b>. In più, un ulteriore vantaggio sull’abbonamento che scegli.',
    foto: [
      { src: '/media/montecassiano-sala.jpg', alt: 'La sala attrezzi di Lume Montecassiano' },
      { src: '/media/gym1.jpg', alt: 'Attrezzi e macchinari di Lume Montecassiano' },
      { src: '/media/gym2.jpg', alt: 'La sala di Lume Montecassiano vista dal fondo' },
    ],
    tessere: [
      { nome: 'Sala pesi', prezzo: '440 €', prima: '468 €', badge: 'Risparmi 53 €', nota: '12 mesi + attivazione 25 € invece di 50 €' },
      { nome: 'All in palestra', prezzo: '530 €', prima: '576 €', badge: 'Risparmi 71 €', nota: '12 mesi + attivazione 25 € invece di 50 €' },
      { nome: 'All in piscina', prezzo: '576 €', prima: '640 €', badge: 'Risparmi 89 €', nota: '12 mesi + attivazione 25 € invece di 50 €' },
      { nome: 'All in palestra + piscina', prezzo: '608 €', prima: '690 €', badge: 'Risparmi 107 €', nota: '12 mesi + attivazione 25 € invece di 50 €', top: true },
    ],
  },
  {
    id: 'urban',
    nome: 'Urban',
    label: 'Il nuovo club · Nel cuore del centro storico di Macerata',
    lead: 'Scopri il nuovo club Lume Urban. Vieni a scoprire il centro: attiva qui o nelle altre sedi il tuo Gold.',
    foto: [
      { src: '/media/urban-ingresso.jpg', alt: 'L’ingresso di Lume Urban' },
      { src: '/media/urban-reformer.jpg', alt: 'La sala Reformer di Lume Urban' },
      { src: '/media/urban-murale.jpg', alt: 'Il murale all’ingresso delle sale di Lume Urban' },
      { src: '/media/urban-spogliatoi.jpg', alt: 'Gli spogliatoi di Lume Urban' },
    ],
    tessere: [
      { nome: '12 mesi + 1 · Under 30', prezzo: '399 €', prima: '420 €', badge: 'Risparmi 71 €', nota: 'Quota di attivazione omaggio (valore 50 €)', top: true },
      { nome: '12 mesi + 1 · Over 30', prezzo: 'Attivazione gratis', prima: '50 €', badge: 'Risparmi 50 €', nota: 'Quota di attivazione omaggio invece di 50 € · puoi dividere il pagamento in 2 o 3 rate senza costi aggiuntivi', top: true },
    ],
  },
];

const fotoHero = [
  { src: '/media/crossfit.jpg', alt: 'Il Box CrossFit di Lume Macerata' },
  { src: '/media/urban-murale.jpg', alt: 'Lume Urban' },
  { src: '/media/gym1.jpg', alt: 'Lume Montecassiano' },
];
const fotoGold = [
  { src: '/media/montecassiano-sala.jpg', alt: 'Lume Montecassiano' },
  { src: '/media/urban-ingresso.jpg', alt: 'Lume Urban' },
  { src: '/media/weights.jpg', alt: 'Lume Macerata' },
];
const fotoReformer = [
  { src: '/media/reformer.jpg', alt: 'Reformer a Lume Macerata' },
  { src: '/media/urban-reformer.jpg', alt: 'Reformer a Lume Urban' },
];

---

<Layout
  title="Black Week Red Pass — Lume Fitness Club"
  description="Dal 23 al 30 novembre: Lume Gold a 800 € per tutti e quattro i club, Black Reformer Friday e le promo di ogni centro. Prenota una chiamata o una visita."
>
  <Header />

  <main>
    <section class="bf-hero">
      <div class="wrap bf-split">
        <div>
          <span class="label">Dal 23 al 30 novembre</span>
          <h1 class="d">Black Week<br /><em>Red Pass</em></h1>
          <p class="bf-lead">
            Il tuo benessere, un’opportunità da non perdere. Una promo per ogni club Lume, più il Gold che li apre tutti.
          </p>
          <div class="bf-count" data-count aria-live="off">
            <div><b data-d>--</b><span>giorni</span></div>
            <div><b data-h>--</b><span>ore</span></div>
            <div><b data-m>--</b><span>minuti</span></div>
            <div><b data-s>--</b><span>secondi</span></div>
          </div>
          <p class="bf-fine">alla fine delle offerte · lunedì 30 novembre, ore 20:00</p>
          <a class="btn btn-red" href="#gold">Scopri il Gold</a>
          <a class="btn btn-out" href={pren('macerata', 'visita', 'visita dalla pagina (hero)')}>Prenota una visita</a>
          <p class="bf-scad" data-scad hidden>L’offerta è terminata. Scrivici e ti diciamo cosa c’è di nuovo.</p>
        </div>
        <BfBento foto={fotoHero} />
      </div>
    </section>

    <div data-offerte>
      <!-- GOLD: valido in tutti i club -->
      <section class="sec bf-gold" id="gold">
        <div class="wrap bf-split">
          <div>
          <span class="label">Un abbonamento · tutti i club</span>
          <h2 class="d">Lume Gold:<br />quattro club,<br /><em>un solo abbonamento!</em></h2>
          <p class="bf-lead">
            Con il Gold hai libero accesso a tutti e quattro i club Lume e puoi vivere liberamente tutti i servizi,
            scegliendo ogni giorno ciò che preferisci. Lo puoi attivare in qualsiasi club, anche a Urban, e lo usi ovunque.
          </p>
          <ul class="bf-serv">
            {servizi.map((s) => <li>{s}</li>)}
          </ul>
          </div>
          <BfBento foto={fotoGold} />
        </div>
        <div class="wrap">
          <div class="bf-gold-grid">
            <article class="bf-gold-card">
              <h3>Nuove iscrizioni</h3>
              <p class="bf-prezzo-big"><s>900 €</s> <b>800 €</b></p>
              <p>Un anno per vivere tutta l’esperienza Lume: tutte le proposte di allenamento e tutti i centri. Sconto di 100 €, più un vantaggio speciale sulla quota di attivazione iniziale.</p>
              <a class="btn btn-red btn-full" href={pren('macerata', 'visita', 'Gold 800 €')}>Attiva il Gold</a>
            </article>
            <article class="bf-gold-card">
              <h3>Gold Upgrade · per i soci</h3>
              <p class="bf-prezzo-big"><s>900 €</s> <b>720 €</b></p>
              <p>Per chi vuole passare al Gold al termine dell’abbonamento attuale: blocchi ora la tariffa speciale, versando la differenza rispetto al valore del tuo abbonamento; alla scadenza versi solo la somma già prevista per il rinnovo.</p>
              <p class="bf-esempio">Esempio: abbonamento attivo da 600 € → oggi 120 €, alla scadenza 600 €. Totale Gold: 720 €.</p>
              <a class="btn btn-out btn-full" href={pren('macerata', 'richiamata', 'Gold Upgrade soci 720 €')}>Prenota il tuo upgrade</a>
            </article>
          </div>
        </div>
      </section>

      <!-- REFORMER: promo comune, in vista -->
      <section class="sec bf-ref" id="reformer">
        <div class="wrap bf-split">
          <div>
            <span class="label">Solo venerdì 27 novembre · pacchetti limitati</span>
            <h2 class="d">Black <em>Reformer</em> Friday</h2>
            <p class="bf-lead" data-bf-prima>Una sola notte. <b>Rimani connesso: lo sveleremo solamente 24 ore prima. Pacchetti limitati.</b></p>
            <p class="bf-lead" data-bf-dopo hidden>Il prezzo cambia in base all’orario di acquisto: più sei veloce, più risparmi. Si parte dalla mezzanotte!</p>
            <table class="bf-fasce">
              <thead><tr><th>Orario di acquisto</th><th>Soci</th><th>Esterni</th></tr></thead>
              <tbody>
                {fasce.map((f) => <tr><td>{f.orario}</td><td><b class="bf-sv" data-v={f.soci}>000 €</b></td><td><b class="bf-sv" data-v={f.esterni}>000 €</b></td></tr>)}
              </tbody>
            </table>
            <a class="btn btn-red" data-bf-prima href={pren('macerata', 'richiamata', 'Black Reformer Friday')}>Avvisami quando si apre</a>
            <button type="button" class="btn btn-red" data-bf-dopo data-reformer-apri hidden>Voglio il Reformer</button>
          </div>
          <BfBento foto={fotoReformer} />
        </div>
      </section>

      <!-- Popup Reformer: la mail decide codice e video (soci o esterni), il codice arriva dal server -->
      <dialog class="bf-dlg" id="reformer-dlg" aria-labelledby="reformer-dlg-t">
        <button type="button" class="bf-dlg-x" data-reformer-chiudi aria-label="Chiudi">×</button>
        <form data-reformer-form>
          <h3 id="reformer-dlg-t">La tua mail</h3>
          <p>Quella con cui accedi al portale Lume, se sei già socio.</p>
          <input type="email" name="email" required autocomplete="email" placeholder="nome@email.it" />
          <p class="bf-dlg-err" data-reformer-err hidden></p>
          <button class="btn btn-red btn-full" type="submit">Continua</button>
        </form>
        <div data-reformer-esito hidden>
          <h3>Il tuo codice</h3>
          <button type="button" class="bf-codice" data-reformer-copia><b data-reformer-codice></b><small data-reformer-copiato>Tocca per copiare</small></button>
          <video data-reformer-video controls playsinline preload="metadata"></video>
          <a class="btn btn-red btn-full" href="https://lumefitness.perfectgym.com/ClientPortal2/" target="_blank" rel="noopener">Vai al portale e incolla il codice</a>
        </div>
      </dialog>

      <!-- UN BLOCCO PER CLUB, tutti uguali -->
      {
        clubs.map((c) => (
          <section class="sec bf-club" id={c.id}>
            <div class="wrap bf-split">
              <div>
                <span class="label">{c.label}</span>
                <h2 class="d">Lume <em>{c.nome}</em></h2>
                <p class="bf-lead" set:html={c.lead} />
                <p class="bf-gold-nota">Incluso nel <a href="#gold">Lume Gold</a>: libero accesso anche a Lume {c.nome}.</p>
                <div class="bf-cta bf-cta-row">
                  <a class="btn btn-red" href={pren(c.id, 'visita', 'Lume ' + c.nome + ' · vieni in sede')}>Vieni in sede</a>
                  <a class="btn btn-out" href={pren(c.id, 'richiamata', 'Lume ' + c.nome + ' · fatti chiamare')}>Fatti chiamare</a>
                </div>
              </div>
              <BfBento foto={c.foto} />
            </div>
            <div class="wrap">
              <div class="bf-tiles">
                {c.tessere.map((t) => (
                  <div class={t.top ? 'bf-tile top' : 'bf-tile'}>
                    {t.badge && <span class="bf-sconto">{t.badge}</span>}
                    <span class="bf-nome">{t.nome}</span>
                    <b class={[t.prezzo.length > 9 ? 'long' : '', t.segreto ? 'bf-sv' : ''].join(' ').trim() || undefined} data-v={t.segreto}>
                      {t.prima && <s>{t.prima}</s>} {t.prezzo}
                    </b>
                    {t.nota && <small data-v={t.notaVera}>{t.nota}</small>}
                    <a class="bf-tile-cta" href={pren(c.id, 'visita', c.nome + ' · ' + t.nome)}>Prenota una visita →</a>
                  </div>
                ))}
              </div>
            </div>
          </section>
        ))
      }

      <section class="sec bf-club" data-vdc>
        <div class="wrap bf-split">
          <div>
            <span class="label">Prevendita · Lume Val di Chienti</span>
            <h2 class="d">La prevendita<br /><em>sta per chiudere</em></h2>
            <p class="bf-lead">Il nuovo club di Piediripa apre a novembre: <b>blocca ora la tua tariffa in prevendita</b> prima che scada.</p>
            <div class="bf-count" data-vdc-count aria-live="off">
              <div><b data-d>--</b><span>giorni</span></div>
              <div><b data-h>--</b><span>ore</span></div>
              <div><b data-m>--</b><span>minuti</span></div>
              <div><b data-s>--</b><span>secondi</span></div>
            </div>
            <p class="bf-fine">alla fine della prevendita · domenica 29 novembre, ore 19:00</p>
            <a class="btn btn-red" href={PREVENDITA_URL} data-vdc-link>Attiva la prevendita</a>
          </div>
          <div class="bf-vdc-video">
            <video autoplay muted loop playsinline preload="metadata" poster="/media/vdc/val-di-chienti-poster.webp" aria-label="Il nuovo club Lume Val di Chienti">
              <source src="/media/vdc/val-di-chienti.webm" type="video/webm" />
              <source src="/media/vdc/val-di-chienti.mp4" type="video/mp4" />
            </video>
          </div>
        </div>
      </section>

      <section class="sec bf-passi">
        <div class="wrap">
          <p class="bf-note">Offerte valide fino al 30 novembre alle ore 20:00 e fino a esaurimento posti, soggette a condizioni. Prezzi per i nuovi iscritti; i soci chiedano al centro.</p>
        </div>
      </section>
    </div>
  </main>

  <Footer />
</Layout>

<script is:inline>
  (function () {
    var dlg = document.getElementById('reformer-dlg');
    if (!dlg) return;
    var $ = function (a) { return dlg.querySelector('[' + a + ']'); };
    var form = $('data-reformer-form'), esito = $('data-reformer-esito'), err = $('data-reformer-err'), cod = $('data-reformer-codice'), vid = $('data-reformer-video'), cop = $('data-reformer-copiato');
    document.querySelector('[data-reformer-apri]').addEventListener('click', function () { dlg.showModal(); });
    $('data-reformer-chiudi').addEventListener('click', function () { dlg.close(); });
    dlg.addEventListener('click', function (e) { if (e.target === dlg) dlg.close(); });
    dlg.addEventListener('close', function () { vid.pause(); });
    form.addEventListener('submit', function (e) {
      e.preventDefault(); err.hidden = true;
      var btn = form.querySelector('button[type=submit]'); btn.disabled = true;
      fetch('/api/reformer', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email: form.email.value }) })
        .then(function (r) { return r.json().then(function (j) { if (!r.ok) throw new Error(j.error || 'Riprova'); return j; }); })
        .then(function (j) { cod.textContent = j.codice; vid.poster = j.poster; vid.src = j.video; form.hidden = true; esito.hidden = false; })
        .catch(function (x) { err.textContent = x.message === 'Failed to fetch' ? 'Connessione assente, riprova' : x.message; err.hidden = false; })
        .finally(function () { btn.disabled = false; });
    });
    $('data-reformer-copia').addEventListener('click', function () {
      var ok = function () { cop.textContent = 'Copiato ✓'; setTimeout(function () { cop.textContent = 'Tocca per copiare'; }, 2000); };
      (navigator.clipboard ? navigator.clipboard.writeText(cod.textContent) : Promise.reject()).then(ok, function () {});
    });
  })();
</script>

<script is:inline define:vars={{ SVELA }}>
  (function () {
    var t0 = new Date(SVELA).getTime();
    var q = function (sel) { return [].slice.call(document.querySelectorAll(sel)); };
    var p = function (n) { return String(n).padStart(2, '0'); };
    function svela() {
      q('.bf-sv').forEach(function (e) { e.textContent = e.dataset.v; e.classList.remove('bf-sv'); });
      q('small[data-v]').forEach(function (e) { e.textContent = e.dataset.v; });
      q('[data-bf-prima]').forEach(function (e) { e.hidden = true; });
      q('[data-bf-dopo]').forEach(function (e) { e.hidden = false; });
      q('[data-svela]').forEach(function (e) { e.hidden = true; });
    }
    if (Date.now() >= t0) return svela();
    setTimeout(svela, Math.min(t0 - Date.now(), 2147483647));
  })();
</script>

<script is:inline define:vars={{ PREVENDITA_FINE }}>
  (function () {
    var sez = document.querySelector('[data-vdc]');
    var box = document.querySelector('[data-vdc-count]');
    if (!sez || !box) return;
    var end = new Date(PREVENDITA_FINE).getTime();
    if (Date.now() > end) { sez.hidden = true; return; }
    var q = function (k) { return box.querySelector('[data-' + k + ']'); };
    var p = function (n) { return String(n).padStart(2, '0'); };
    function tick() {
      var t = end - Date.now();
      if (t <= 0) { sez.hidden = true; return; }
      q('d').textContent = Math.floor(t / 864e5);
      q('h').textContent = p(Math.floor(t / 36e5) % 24);
      q('m').textContent = p(Math.floor(t / 6e4) % 60);
      q('s').textContent = p(Math.floor(t / 1e3) % 60);
    }
    tick(); setInterval(tick, 1000);
  })();
</script>

<script is:inline define:vars={{ FINE }}>
  (function () {
    var box = document.querySelector('[data-count]');
    var end = new Date(FINE + 'T20:00:00+01:00').getTime();
    if (Date.now() > end) {
      var s = document.querySelector('[data-scad]');
      var o = document.querySelector('[data-offerte]');
      if (s) s.hidden = false;
      if (o) o.hidden = true;
      if (box) box.hidden = true;
      return;
    }
    if (!box) return;
    var q = function (k) { return box.querySelector('[data-' + k + ']'); };
    var p = function (n) { return String(n).padStart(2, '0'); };
    function tick() {
      var t = Math.max(0, end - Date.now());
      q('d').textContent = Math.floor(t / 864e5);
      q('h').textContent = p(Math.floor(t / 36e5) % 24);
      q('m').textContent = p(Math.floor(t / 6e4) % 60);
      q('s').textContent = p(Math.floor(t / 1e3) % 60);
    }
    tick(); setInterval(tick, 1000);
  })();
</script>

<style>
  .bf-hero { padding: 72px 0 40px; background: radial-gradient(120% 90% at 50% 0%, rgba(196, 0, 66, 0.28), transparent 70%); }
  .bf-hero h1 { font-size: clamp(56px, 11vw, 140px); margin: 14px 0 18px; }
  .bf-hero em, .bf-gold em, .bf-ref em, .bf-club em { color: var(--red-txt); font-style: normal; }
  .bf-lead { max-width: 560px; color: var(--mut); font-size: 18px; line-height: 1.5; margin: 0 0 28px; }
  .bf-scad { margin-top: 20px; color: var(--cream); font-weight: 600; }

  .bf-count { display: flex; gap: 10px; margin: 0 0 8px; }
  .bf-count[hidden] { display: none; }
  .bf-count div { min-width: 72px; padding: 12px 8px; text-align: center; background: var(--card); border: 1px solid var(--line); border-radius: 12px; }
  .bf-count b { display: block; font-family: 'Anton', sans-serif; font-weight: 400; font-size: clamp(28px, 6vw, 44px); line-height: 1; color: var(--cream); font-variant-numeric: tabular-nums; }
  .bf-count span { font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--mut); }
  .bf-fine { margin: 0 0 28px; font-size: 13px; color: var(--mut); }

  /* Gold */
  .bf-gold { background: linear-gradient(180deg, rgba(196, 0, 66, .16), transparent 80%); border-top: 1px solid var(--line); }
  .bf-gold h2 { font-size: clamp(40px, 7vw, 84px); margin: 12px 0 18px; }
  .bf-serv { list-style: none; display: flex; flex-wrap: wrap; gap: 10px; margin: 0 0 32px; padding: 0; }
  .bf-serv li { padding: 9px 16px; border: 1px solid var(--red); border-radius: 999px; font-weight: 600; color: var(--cream); }

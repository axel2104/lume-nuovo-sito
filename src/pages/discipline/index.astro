---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BandaCta from '../../components/BandaCta.astro';
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';

const discipline = (await getCollection('discipline')).sort(
  (a, b) => a.data.ordine - b.data.ordine,
);

// Categorie nell'ordine in cui compaiono le schede, non alfabetico: l'ordine
// delle discipline è già curato e i filtri devono seguirlo.
const categorie = [...new Set(discipline.map((d) => d.data.categoria))];

const centri = (await getCollection('centri', ({ data }) => data.stato === 'aperto')).sort(
  (a, b) => a.data.ordine - b.data.ordine,
);
const nomeCentro = (id: string) =>
  centri.find((c) => c.id === id)?.data.nome.replace('Lume ', '') ?? id;
---

<Layout
  title="Discipline — Lume Fitness Club"
  description="Oltre trenta attività fra corsi Les Mills, funzionale, mente e corpo, Reformer e acqua fitness. Ogni disciplina ha la sua scheda."
>
  <Header />
  <main id="contenuto">
  <section class="sec">
    <div class="wrap">
      <div class="sec-head">
        <span class="label">Discipline</span>
        <h2 class="d">Allenati come vuoi</h2>
        <p>
          {discipline.length} attività fra corsi di gruppo, funzionale, mente e corpo, Reformer e
          acqua fitness. Filtra per tipo o per centro, e apri una tessera per leggerne la scheda
          senza perdere il posto.
        </p>
      </div>

      <div class="disc-filtri">
        <div class="hd-filtri" role="group" aria-label="Filtra per tipo">
          <button type="button" class="hd-f on" data-cat="">Tutte</button>
          {categorie.map((c) => <button type="button" class="hd-f" data-cat={c}>{c}</button>)}
        </div>
        <div class="hd-filtri" role="group" aria-label="Filtra per centro">
          <button type="button" class="hd-f on" data-centro="">Ogni centro</button>
          {
            centri.map((c) => (
              <button type="button" class="hd-f" data-centro={c.id}>
                {c.data.nome.replace('Lume ', '')}
              </button>
            ))
          }
        </div>
      </div>

      <div class="bento" id="disc-bento">
        {
          discipline.map((d) => (
            <a
              class:list={['tessera', d.data.rilievo]}
              href={`/discipline/${d.id}/`}
              data-cat={d.data.categoria}
              data-centri={d.data.centri.join(' ')}
              data-titolo={d.data.nome}
              data-video={d.data.video || undefined}
              aria-expanded="false"
            >
              {d.data.immagine && (
                <Picture
                  class="t-foto"
                  src={d.data.immagine}
                  alt=""
                  widths={[400, 800, 1200]}
                  sizes="(min-width:1024px) 25vw, (min-width:640px) 50vw, 100vw"
                  loading="lazy"
                  formats={['avif', 'webp']}
                />
              )}
              <span class="t-velo" aria-hidden="true" />
              <span class="t-cat">{d.data.categoria}</span>
              <span class="t-piu" aria-hidden="true">
                +
              </span>
              <h3>{d.data.nome}</h3>
              {d.data.rilievo === 'grande' && <p class="t-breve">{d.data.breve}</p>}
              <div class="t-meta">
                {d.data.centri.map((c) => (
                  <span>{nomeCentro(c)}</span>
                ))}
                {d.data.varianti.length > 0 && (
                  <span class="t-var">+{d.data.varianti.length} varianti</span>
                )}
              </div>
            </a>
          ))
        }
      </div>

      <p class="ed-vuoto" id="disc-vuoto" hidden>
        Nessuna disciplina con questi filtri. Prova ad allargare la ricerca.
      </p>

      {/* Il catalogo mostrava trentatré discipline e nessun modo di provarne
          una: qui l'interesse accumulato scorrendo trova uno sbocco. */}
      <div style="margin-top:44px">
        <BandaCta
          titolo="Provale davvero"
          testo="Una settimana di pass ti dà accesso a tutte: corsi, sala, acqua e discipline su prenotazione."
        >
          <button type="button" class="btn btn-red btn-full" data-open-form="prova" data-medium="IndiceDiscipline">
            Prova 7 giorni
          </button>
          <button type="button" class="btn btn-out btn-full" data-open-form="info" data-medium="IndiceDisciplineInfo">
            Chiedi consiglio
          </button>
        </BandaCta>
      </div>
    </div>
  </section>
  </main>
  <Footer />
</Layout>

<script>
  import { initPannelli } from '../../lib/pannelloEspandibile.client.js';
  import { initAnteprimeVideo, avviaVideoHero } from '../../lib/anteprimaVideo.client.js';

  const griglia = document.getElementById('disc-bento');
  const vuoto = document.getElementById('disc-vuoto');

  if (griglia) {
    const pannelli = initPannelli(griglia, {
      selettoreCella: '.tessera',
      onAperto: (pannello: HTMLElement) => avviaVideoHero(pannello),
    });
    const anteprime = initAnteprimeVideo(griglia, { selettoreCella: '.tessera' });

    const tessere = Array.from(griglia.querySelectorAll<HTMLElement>('.tessera'));
    const bottoniCat = Array.from(document.querySelectorAll<HTMLElement>('.hd-f[data-cat]'));
    const bottoniCentro = Array.from(document.querySelectorAll<HTMLElement>('.hd-f[data-centro]'));
    let categoria = '';
    let centro = '';

    const applica = () => {
      // Un pannello aperto su una tessera che sta per sparire resterebbe
      // orfano in mezzo alla griglia: prima si chiude.
      pannelli?.chiudi();
      anteprime?.ferma();
      let visibili = 0;
      tessere.forEach((t) => {
        const okCat = !categoria || t.dataset.cat === categoria;
        const okCentro = !centro || (t.dataset.centri || '').split(' ').includes(centro);
        const mostra = okCat && okCentro;
        t.hidden = !mostra;
        if (mostra) visibili++;
      });
      if (vuoto) vuoto.hidden = visibili > 0;
    };

    const collega = (bottoni: HTMLElement[], chiave: 'cat' | 'centro') => {
      bottoni.forEach((b) => {
        b.addEventListener('click', () => {
          const valore = (chiave === 'cat' ? b.dataset.cat : b.dataset.centro) || '';
          if (chiave === 'cat') categoria = valore;
          else centro = valore;
          bottoni.forEach((x) => x.classList.toggle('on', x === b));
          applica();
        });
      });
    };

    collega(bottoniCat, 'cat');
    collega(bottoniCentro, 'centro');
  }
</script>

<style>
  .disc-filtri {
    display: grid;
    gap: 10px;
    margin-bottom: 28px;
  }
  /* Una tessera nascosta dai filtri non deve occupare la sua cella di griglia. */
  .tessera[hidden] {
    display: none;
  }
</style>

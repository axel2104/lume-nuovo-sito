---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const discipline = await getCollection('discipline');
  return discipline.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);

const centri = await getCollection('centri');
const disponibile = centri.filter((c) => d.centri.includes(c.id));
const livelli = [1, 2, 3, 4, 5];

// Gli indicatori esistono solo dove il dato c'è: se mancano tutti, la colonna
// laterale resta comunque utile con varianti e call to action.
const haIndicatori = d.difficolta != null || d.intensita != null || d.durata != null;

// Altre discipline della stessa categoria, per non lasciare la pagina cieca.
const simili = (await getCollection('discipline'))
  .filter((x) => x.id !== entry.id && x.data.categoria === d.categoria)
  .sort((a, b) => a.data.ordine - b.data.ordine)
  .slice(0, 4);
---

<Layout title={`${d.nome} — LUMe Fitness Club`} description={d.breve}>
  <Header />
  <section class="sec" style="padding-top:0">
    <div class="wrap">
      <div
        class:list={['disc-hero', { 'senza-media': !d.video && !d.immagine }]}
        data-cat={d.categoria}
      >
        {
          d.video ? (
            <video autoplay muted loop playsinline poster={d.immagine ?? undefined}>
              <source src={d.video} type="video/mp4" />
            </video>
          ) : (
            d.immagine && <img src={d.immagine} alt={d.nome} />
          )
        }
        <div class="disc-hero-in">
          <span class="label">{d.categoria}</span>
          <h1 class="d">{d.nome}</h1>
        </div>
      </div>

      {/*
        Tutto ciò che sta qui dentro viene riusato: la griglia bento della
        pagina Discipline scarica questa pagina e mostra questo frammento nel
        pannello che si apre sotto la tessera. Se aggiungi qualcosa fuori da
        `data-pannello`, nel pannello non comparirà.
      */}
      <div data-pannello data-cat={d.categoria}>
        <div class="pan-testa">
          <span class="label">{d.categoria}</span>
          <h2 class="d">{d.nome}</h2>
        </div>

        <div class="disc-body">
          <div>
            <p class="lead">{d.breve}</p>
            <div class="prose"><Content /></div>

            {
              disponibile.length > 0 && (
                <div style="margin-top:26px">
                  <span class="label">Dove praticarla</span>
                  <div class="chips" style="margin-top:12px">
                    {disponibile.map((c) => (
                      <a class="chip" href={`/centri/${c.id}/`}>
                        {c.data.nome.replace('Lume ', '')}
                      </a>
                    ))}
                  </div>
                </div>
              )
            }
          </div>

          <aside class="disc-meta">
            {
              haIndicatori && (
                <>
                  {d.difficolta != null && (
                    <div class="meter-row">
                      <span>Difficoltà</span>
                      <div class="meter">
                        {livelli.map((n) => <i class={n <= (d.difficolta ?? 0) ? 'on' : ''} />)}
                      </div>
                    </div>
                  )}
                  {d.intensita != null && (
                    <div class="meter-row">
                      <span>Intensità</span>
                      <div class="meter">
                        {livelli.map((n) => <i class={n <= (d.intensita ?? 0) ? 'on' : ''} />)}
                      </div>
                    </div>
                  )}
                  {d.durata != null && (
                    <div class="meter-row">
                      <span>Durata</span>
                      <b>{d.durata} min</b>
                    </div>
                  )}
                </>
              )
            }

            {
              d.varianti.length > 0 && (
                <div class="varianti">
                  <span class="label">Livelli e varianti</span>
                  <ul>
                    {d.varianti.map((v) => (
                      <li>
                        <b>{v.nome}</b>
                        {v.nota && <span>{v.nota}</span>}
                      </li>
                    ))}
                  </ul>
                </div>
              )
            }

            <button type="button" class="btn btn-red btn-full" data-open-modal="modal-contatti">
              Prova {d.nome}
            </button>
            {/* Visibile solo dentro il pannello: sulla pagina saremmo già qui. */}
            <a class="btn btn-out btn-full solo-pannello" href={`/discipline/${entry.id}/`}>
              Apri la scheda intera
            </a>
            <a href="/#abbonamenti" class="btn btn-out btn-full" style="margin-top:10px">
              Vedi gli abbonamenti
            </a>
          </aside>
        </div>
      </div>

      {
        simili.length > 0 && (
          <div style="margin-top:56px">
            <span class="label">{d.categoria}</span>
            <div class="bento" style="margin-top:16px">
              {simili.map((s) => (
                <a
                  class:list={['tessera', s.data.rilievo === 'grande' ? 'largo' : s.data.rilievo]}
                  href={`/discipline/${s.id}/`}
                  data-cat={s.data.categoria}
                >
                  <span class="t-cat">{s.data.categoria}</span>
                  <h3>{s.data.nome}</h3>
                  {s.data.varianti.length > 0 && (
                    <div class="t-meta">
                      <span class="t-var">+{s.data.varianti.length} varianti</span>
                    </div>
                  )}
                </a>
              ))}
            </div>
          </div>
        )
      }
    </div>
  </section>
  <Footer />
</Layout>

<style>
  .disc-hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 46vh;
    margin-top: 18px;
    border: 1px solid var(--line);
    border-radius: 22px;
    overflow: hidden;
    background:
      radial-gradient(90% 130% at 10% 0%, rgba(var(--tinta), 0.34), transparent 60%),
      linear-gradient(160deg, #1a1a1a, #0c0c0c);
  }
  .disc-hero.senza-media {
    min-height: 30vh;
  }
  .disc-hero img,
  .disc-hero video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .disc-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle at 1px 1px, rgba(255, 255, 255, 0.09) 1px, transparent 0);
    background-size: 24px 24px;
    opacity: 0.4;
  }
  .disc-hero:has(img)::after,
  .disc-hero:has(video)::after {
    background: linear-gradient(180deg, rgba(10, 10, 10, 0.2), rgba(10, 10, 10, 0.9));
    opacity: 1;
  }
  .disc-hero-in {
    position: relative;
    z-index: 2;
    padding: 30px;
  }
  .disc-hero-in h1 {
    margin-top: 10px;
    font-size: clamp(38px, 8vw, 74px);
  }
</style>

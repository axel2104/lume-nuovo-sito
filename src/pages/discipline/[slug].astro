---
import { Picture } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection, render } from 'astro:content';
import { interesseDisciplina, SEDI } from '../../config/forms';

export async function getStaticPaths() {
  const discipline = await getCollection('discipline');
  return discipline.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);

const centri = await getCollection('centri');
const disponibile = centri.filter((c) => d.centri.includes(c.id));
const livelli = [1, 2, 3, 4, 5];

// Gli indicatori esistono solo dove il dato c'è: se mancano tutti, la colonna
// laterale resta comunque utile con varianti e call to action.
const haIndicatori = d.difficolta != null || d.intensita != null || d.durata != null;

// Altre discipline della stessa categoria, per non lasciare la pagina cieca.
const simili = (await getCollection('discipline'))
  .filter((x) => x.id !== entry.id && x.data.categoria === d.categoria)
  .sort((a, b) => a.data.ordine - b.data.ordine)
  .slice(0, 4);

// Chi arriva qui ha già scelto cosa vuole fare: il form si apre con l'attività
// spuntata, e se la disciplina si tiene in un solo centro anche con la sede.
const interesse = interesseDisciplina(d);
const sediDisponibili = disponibile.filter((c) => SEDI[c.id]);
const centroUnico = sediDisponibili.length === 1 ? sediDisponibili[0].id : '';
---

<Layout title={`${d.nome} — LUMe Fitness Club`} description={d.breve}>
  <Header />
  <main id="contenuto">
  <section class="sec" style="padding-top:0">
    <div class="wrap">
      {/*
        Tutto ciò che sta qui dentro viene riusato: la griglia bento della
        pagina Discipline scarica questa pagina e mostra questo frammento nel
        pannello che si apre sotto la tessera. Se aggiungi qualcosa fuori da
        `data-pannello`, nel pannello non comparirà.
      */}
      <div data-pannello data-cat={d.categoria}>
        <div
          class:list={['disc-hero', { 'senza-media': !d.video && !d.immagine }]}
          data-cat={d.categoria}
        >
          {
            d.video ? (
              <video
                data-hero-video
                data-sorgente={d.video}
                muted
                loop
                playsinline
                preload="none"
                poster={d.immagine?.src ?? undefined}
              />
            ) : (
              d.immagine && (
                <Picture
                  src={d.immagine}
                  alt={d.nome}
                  widths={[800, 1400, 2000]}
                  sizes="100vw"
                  loading="eager"
                  fetchpriority="high"
                  formats={['avif', 'webp']}
                />
              )
            )
          }
          <div class="disc-hero-in">
            <span class="label">{d.categoria}</span>
            <h1 class="d">{d.nome}</h1>
          </div>
        </div>

        <div class="disc-body">
          <div>
            <p class="lead">{d.breve}</p>
            <div class="prose"><Content /></div>

            {
              disponibile.length > 0 && (
                <div style="margin-top:26px">
                  <span class="label">Dove praticarla</span>
                  <div class="chips" style="margin-top:12px">
                    {disponibile.map((c) => (
                      <a class="chip" href={`/centri/${c.id}/`}>
                        {c.data.nome.replace('Lume ', '')}
                      </a>
                    ))}
                  </div>
                </div>
              )
            }
          </div>

          <aside class="disc-meta">
            {
              haIndicatori && (
                <>
                  {d.difficolta != null && (
                    <div class="meter-row">
                      <span>Difficoltà</span>
                      <div class="meter">
                        {livelli.map((n) => <i class={n <= (d.difficolta ?? 0) ? 'on' : ''} />)}
                      </div>
                    </div>
                  )}
                  {d.intensita != null && (
                    <div class="meter-row">
                      <span>Intensità</span>
                      <div class="meter">
                        {livelli.map((n) => <i class={n <= (d.intensita ?? 0) ? 'on' : ''} />)}
                      </div>
                    </div>
                  )}
                  {d.durata != null && (
                    <div class="meter-row">
                      <span>Durata</span>
                      <b>{d.durata} min</b>
                    </div>
                  )}
                </>
              )
            }

            {
              d.varianti.length > 0 && (
                <div class="varianti">
                  <span class="label">Livelli e varianti</span>
                  <ul>
                    {d.varianti.map((v) => (
                      <li>
                        <b>{v.nome}</b>
                        {v.nota && <span>{v.nota}</span>}
                      </li>
                    ))}
                  </ul>
                </div>
              )
            }

            {/*
              Il bottone diceva "Prova" e apriva il form informazioni: ora apre
              davvero il flusso del pass prova, con l'attività già spuntata.
              `data-medium` porta lo slug della disciplina, così su Airtable si
              vede quale scheda converte invece di un generico "sito".
            */}
            <button
              type="button"
              class="btn btn-red btn-full"
              data-open-form="prova"
              data-medium={`Disciplina:${entry.id}`}
              data-interesse={interesse}
              data-centro={centroUnico}
            >
              Prova {d.nome}
            </button>
            <button
              type="button"
              class="btn btn-out btn-full"
              style="margin-top:10px"
              data-open-form="info"
              data-medium={`DisciplinaInfo:${entry.id}`}
              data-interesse={interesse}
              data-centro={centroUnico}
            >
              Chiedi informazioni
            </button>
            {/* Visibile solo dentro il pannello: sulla pagina saremmo già qui. */}
            <a class="btn btn-out btn-full solo-pannello" href={`/discipline/${entry.id}/`}>
              Apri la scheda intera
            </a>
            <a href="/abbonamenti" class="btn btn-out btn-full" style="margin-top:10px">
              Vedi gli abbonamenti
            </a>
          </aside>
        </div>
      </div>

      {
        simili.length > 0 && (
          <div style="margin-top:56px">
            <span class="label">{d.categoria}</span>
            <div class="bento" style="margin-top:16px">
              {simili.map((s) => (
                <a
                  class="tessera"
                  href={`/discipline/${s.id}/`}
                  data-cat={s.data.categoria}
                  data-video={s.data.video || undefined}
                >
                  {s.data.immagine && (
                    <Picture
                      class="t-foto"
                      src={s.data.immagine}
                      alt=""
                      widths={[400, 800]}
                      sizes="(min-width:1024px) 25vw, 100vw"
                      loading="lazy"
                      formats={['avif', 'webp']}
                    />
                  )}
                  <span class="t-velo" aria-hidden="true" />
                  <span class="t-cat">{s.data.categoria}</span>
                  <h3>{s.data.nome}</h3>
                  {s.data.varianti.length > 0 && (
                    <div class="t-meta">
                      <span class="t-var">+{s.data.varianti.length} varianti</span>
                    </div>
                  )}
                </a>
              ))}
            </div>
          </div>
        )
      }
    </div>
  </section>
  </main>
  <Footer />
</Layout>

<script>
  import { avviaVideoHero, initAnteprimeVideo } from '../../lib/anteprimaVideo.client.js';

  avviaVideoHero(document);

  // Anche le correlate in fondo alla scheda hanno l'anteprima al passaggio.
  const correlate = document.querySelector('.bento');
  if (correlate) initAnteprimeVideo(correlate, { selettoreCella: '.tessera' });
</script>

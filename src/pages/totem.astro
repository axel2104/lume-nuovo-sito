---
/**
 * /totem — la home pensata per gli schermi nei centri (verticali, touch, a schermo intero).
 *
 * Ogni totem apre il proprio indirizzo: /totem?t=macerata-ingresso. Il pezzo prima del primo "-"
 * è il centro, l'intero valore identifica il totem nelle statistiche del CRM (/totem nel CRM).
 *
 * Niente Layout del sito: qui non servono banner cookie, assistente, GTM né menu. Il video del
 * centro gira sempre sullo sfondo; sopra c'è una schermata d'attesa che torna dopo un minuto
 * senza tocchi. I dati dei centri sono incorporati in pagina: il totem non dipende dalla rete
 * per mostrare prezzi e orari (solo il video e le statistiche la usano).
 */
import '@fontsource/anton/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/700.css';
import '../styles/totem.css';
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import piscina from '../assets/centri/montecassiano-piscina.jpg';
import { campo } from '../lib/copy';
import totemJson from '../content/pagine/totem.json';
import { unisci } from '../lib/totemTesti.js';
import { testiScuolaNuoto as sn } from '../data/testi';

export const prerender = true;

// Foto scelte da Keystatic (src/assets/totem): si ottimizzano in build come le altre.
const fotoEditor = import.meta.glob('../assets/totem/*.{jpg,jpeg,png,webp}', { eager: true, import: 'default' }) as Record<string, any>;
const fotoRisolte = new Map(await Promise.all(Object.entries(fotoEditor).map(async ([p, img]) => [p.split('/').pop(), (await getImage({ src: img, width: 900, format: 'jpg' })).src] as const)));
const testi = unisci(totemJson, (percorso: string) => fotoRisolte.get(percorso.split('/').pop() ?? '') ?? '');

const fotoPiscina = (await getImage({ src: piscina, width: 900, format: 'jpg' })).src;

const centri = (await getCollection('centri')).filter((c) => c.data.stato === 'aperto').sort((a, b) => a.data.ordine - b.data.ordine);

const dati = await Promise.all(
  centri.map(async (c) => {
    const d = c.data;
    return {
      slug: c.id,
      nome: d.nome,
      video: d.video ?? '',
      poster: d.videoPoster ? (await getImage({ src: d.videoPoster, width: 1080, format: 'webp' })).src : '',
      servizi: d.servizi ?? [],
      orari: d.orari ?? null,
      indirizzo: d.indirizzo ?? '',
      telefono: d.telefono ?? '',
      piani: (d.listino?.piani ?? []).map((p) => ({
        nome: p.nome,
        per: p.per ?? '',
        annuale: p.annuale,
        rate: p.rate,
        mensile: p.mensile ?? null,
        // Indirizzi del ClientPortal già sulla formula: dove manca, la formula si mostra ma non si apre.
        pgm: { annuale: p.pgm?.annuale ?? null, rate: p.pgm?.rate ?? null, mensile: p.pgm?.mensile ?? null },
        evidenza: !!p.evidenza,
      })),
      attivazione: d.listino?.attivazione ?? null,
      // La scuola nuoto bambini vive solo a Montecassiano (stessi dati della pagina /scuola-nuoto).
      scuolaNuoto:
        c.id === 'montecassiano'
          ? {
              foto: fotoPiscina,
              stagione: [campo(sn.stagione, 'inizio'), campo(sn.stagione, 'fine')].filter(Boolean).join(' — '),
              fasce: sn.fasce.voci.map((f: any) => ({ eta: f.eta, livelli: f.livelli, href: f.href ?? null })),
            }
          : null,
      lezioni: (d.planning ?? []).map((l) => ({ giorno: Number(l.giorno), inizio: l.inizio, fine: l.fine, corso: l.corso })),
    };
  }),
);
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Lume Fitness Club</title>
  </head>
  <body class="totem" data-centri={JSON.stringify(dati)} data-testi={JSON.stringify(testi)}>
    <video class="tt-video" muted loop playsinline autoplay preload="auto" aria-hidden="true"></video>
    <div class="tt-velo"></div>
    <main class="tt-app" id="app"></main>
    <script>
      import { avviaTotem } from '../lib/totem.client.js';
      avviaTotem();
    </script>
  </body>
</html>

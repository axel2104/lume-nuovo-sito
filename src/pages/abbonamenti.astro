---
/**
 * Pagina abbonamenti.
 *
 * ─── Il selettore di formula non usa JavaScript ───────────────────────────
 *
 * I prezzi di tutte e tre le formule sono nel markup, e tre radio li scambiano
 * con `:has()`. Su un sito che spedisce 658 byte di JS non ha senso aggiungere
 * un listener per una cosa che il CSS fa da solo. E se `:has()` non c'è, resta
 * visibile l'annuale — cioè la formula predefinita, non una pagina rotta.
 *
 * ─── Perché il selettore e non le formule impilate nella scheda ───────────
 *
 * Chi arriva qui ha una domanda sola: **quale piano prendo**. Il selettore
 * mette i tre piani a confronto a parità di formula, che è la forma di quella
 * domanda. Impilare le tre formule dentro ogni scheda risponde a una domanda
 * diversa — «come pago» — che viene dopo, e in cambio triplica l'altezza
 * della pagina proprio nel punto in cui si decide.
 *
 * ─── Le schede mostrano il delta, non l'elenco intero ─────────────────────
 *
 * Fra All Lume e GOLD ci sono sei voci di differenza su tredici. Tre elenchi
 * completi affiancati costringono a leggerli riga per riga per trovarle. La
 * verità completa sta nella tabella qui sotto.
 */
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';
import SelettoreFormula from '../components/SelettoreFormula.astro';
import SchedePiani from '../components/SchedePiani.astro';
import {
  FORMULE,
  alCentro,
  formulaDi,
  pianoPiuEconomicoCon,
  righeConfronto,
  include,
  sintesiVoci,
  euro,
  alMese,
  PASS,
} from '../data/abbonamenti';
import { siteConfig } from '../config/site';
import { SEDI } from '../config/forms';

const piani = alCentro(
  (await getCollection('abbonamenti'))
    .filter((p) => p.data.pubblicato)
    .sort((a, b) => a.data.ordine - b.data.ordine),
  (p) => p.data.consigliato,
);

/** Le righe della tabella: l'unione delle attività, senza tassonomia da mantenere. */
const righe = righeConfronto(piani);

const centri = (await getCollection('centri')).sort((a, b) => a.data.ordine - b.data.ordine);
const aperti = centri.filter((c) => c.data.stato === 'aperto');
const inArrivo = centri.filter((c) => c.data.stato !== 'aperto');

/**
 * Il listino di ogni centro che ne ha uno, per la sezione in fondo.
 *
 * Macerata resta fuori: e' il listino stampato in cima alla pagina, e
 * ristamparlo qui vorrebbe dire due volte gli stessi prezzi con due nomi
 * diversi per gli stessi piani ("Sala pesi" sopra, "Sala" sotto). Il suo Box
 * CrossFit invece entra, perche' in cima non c'e' e altrimenti sarebbe
 * l'unico abbonamento Lume che questa pagina non mostra.
 *
 * Niente filtro sullo stato: Urban non ha ancora aperto e il suo listino
 * esiste gia', con la nota che dice da quando vale. Nasconderlo vorrebbe
 * dire che chi valuta la prevendita non trova il prezzo.
 */
const altriListini = centri.filter((c) => c.id !== 'macerata' && c.data.listino);

const boxMacerata = centri.find((c) => c.id === 'macerata')?.data.listino?.box;

const faq = (await getCollection('helpdesk'))
  .filter((v) => v.data.pubblicato && ['abbonamenti', 'pagamenti'].includes(v.data.categoria))
  .sort((a, b) => a.data.ordine - b.data.ordine);


/**
 * Quanto si risparmia a pagare l'anno in una volta invece che mese per mese.
 *
 * Confronta l'annuale col mensile dello **stesso** piano, e solo dove esistono
 * entrambi: sul Sala Pesi, che non ha un mensile, un risparmio non è
 * calcolabile e inventarne uno con la formula a rate significherebbe far
 * passare per sconto una differenza di dodici euro di commissioni.
 */
function risparmioAnnuale(p: (typeof piani)[number]): number {
  const annuale = formulaDi(p, 'annuale');
  const mensile = formulaDi(p, 'mensile');
  if (!annuale || !mensile) return 0;
  return mensile.prezzo * 12 - annuale.prezzo;
}

// Il risparmio massimo va nell'occhiello: è la leva della pagina, e
// nasconderla dietro un click la rende inutile.
const risparmioMax = Math.max(...piani.map(risparmioAnnuale), 0);

/** Per il rimando del Sala Pesi, che il mensile non ce l'ha. */
const mensilePiuEconomico = pianoPiuEconomicoCon(piani, 'mensile');
---

<Layout
  title="Abbonamenti — Lume Fitness Club"
  description="I piani Lume nella versione Macerata, che dà ingresso a tutti i centri: sala, corsi, acqua e Box CrossFit. Soluzione unica, dodici rate o mensile. Montecassiano ha un listino suo."
>
  <Header />

  <main id="contenuto">
    <!-- ─── Hero ──────────────────────────────────────────────────── -->
    <header class="ab-hero">
      <div class="wrap">
        <span class="label">Abbonamenti</span>
        <h1 class="d">Scegli quanto<br /><em>ti serve</em></h1>
        <p class="ab-lede">
          Tre piani e tre modi di pagarli: tutto in una volta, in dodici rate senza interessi, o
          mese per mese senza vincolo. La quota di attivazione è {euro(piani[0].data.attivazione)} €
          una sola volta, uguale per tutti.
        </p>
        {/*
          Questi sono i prezzi di Macerata, che apre tutti i centri. Dal
          listino 2026/27 non sono piu' uguali dappertutto — a Montecassiano
          la stessa sala costa 468 € invece di 660 — e una pagina che li
          presenta come «i prezzi Lume» manda in reception gente convinta di
          una cifra sbagliata. Il rimando alle sedi non e' una nota a pie' di
          pagina: e' l'unico posto dove l'altro listino esiste.
        */}
        <p class="ab-sedi">
          Sono i prezzi di <b>Lume Macerata</b>, che con un solo abbonamento apre tutti i centri.
          Gli altri centri hanno un listino loro, valido lì: li trovi{' '}
          <a href="#listini">più sotto in questa pagina</a>.
        </p>
        <ul class="ab-punti">
          <li><strong>{piani.length} piani</strong><span>dalla sola sala pesi a tutto il club</span></li>
          <li><strong>7 giorni</strong><span>di prova prima di scegliere</span></li>
          <li>
            <strong>fino a {euro(risparmioMax)} €</strong>
            <span>di risparmio pagando l'anno in una volta</span>
          </li>
        </ul>
      </div>
    </header>

    <!-- ─── Piani ─────────────────────────────────────────────────── -->
    <section class="sec" style="padding-top:0" aria-labelledby="tit-piani">
      <div class="wrap">
        <h2 id="tit-piani" class="sr-only">I piani</h2>

        <div class="listino pf-scope">
          {/*
            Le radio precedono le schede nel DOM perché `:has()` sul contenitore
            deve poterle vedere. `annuale` è la predefinita: è la formula che
            conviene, ed è quella che resta se `:has()` non è supportato.
          */}
          <SelettoreFormula />

          <div class="plans">
            {
              piani.map((p, i) => {
                const { base, voci: nuove } = sintesiVoci(piani, i);
                return (
                  <article class={`plan ${p.data.consigliato ? 'hot' : ''}`}>
                    {p.data.consigliato && <span class="plan-tag">Il più scelto</span>}

                    <div class="plan-testa">
                      <h3 class="pn">{p.data.nome}</h3>
                      <p class="plan-per">{p.data.per}</p>
                    </div>

                    <div class="plan-prezzo">
                      {FORMULE.map((f) => {
                        const formula = formulaDi(p, f.id);

                        // Il piano non offre questa formula: al posto del
                        // prezzo, dove andare. Un prezzo mancante senza
                        // spiegazione si legge come un errore della pagina.
                        if (!formula) {
                          return (
                            <div class="plan-altrove" data-formula={f.id}>
                              <p class="pa-tit">Non c'è {f.label.toLowerCase()}</p>
                              <p class="pa-txt">
                                {p.data.nome} esiste solo a dodici mesi.
                                {mensilePiuEconomico && f.id === 'mensile' && (
                                  <>
                                    {' '}Senza vincolo il piano è{' '}
                                    <b>{mensilePiuEconomico.data.nome}</b>, a{' '}
                                    {euro(formulaDi(mensilePiuEconomico, 'mensile')!.prezzo)} € al
                                    mese.
                                  </>
                                )}
                              </p>
                              {/*
                                Una `<label>` e non un pulsante: seleziona la
                                radio dell'annuale, quindi riporta la pagina
                                sulla formula che questo piano ha davvero,
                                senza una riga di JavaScript. Senza di essa
                                questa scheda resta l'unica senza un'azione.
                              */}
                              <label class="btn btn-out btn-full pa-torna" for="f-annuale">
                                Vedi {p.data.nome} annuale
                              </label>
                            </div>
                          );
                        }

                        /*
                          In evidenza sempre il costo al mese, anche per
                          l'annuale: e' la cifra con cui si sceglie una
                          palestra, e un totale a tre cifre accanto a un
                          concorrente che ne scrive due sembra caro anche
                          quando non lo e'. Il totale sta nella riga subito
                          sotto, perche' 75 €/mese in soluzione unica non e'
                          una rata e chi legge deve saperlo qui, non in
                          reception.

                          Per le rate il totale non e' nei dati: il listino
                          dichiara la rata, e dodici rate sono il totale.
                        */
                        const alMese =
                          formula.periodo === 'mese'
                            ? formula.prezzo
                            : Math.round(formula.prezzo / 12);
                        const totale =
                          f.id === 'annuale'
                            ? formula.prezzo
                            : f.id === 'rate'
                              ? formula.prezzo * 12
                              : null;
                        return (
                          <div data-formula={f.id}>
                            <div class="pr">
                              {euro(alMese)}&nbsp;€<small>/mese</small>
                            </div>
                            <p class="plan-nota">
                              {f.id === 'annuale' && (
                                <>
                                  <b>{euro(totale!)} €</b> in unica soluzione.{' '}
                                </>
                              )}
                              {f.id === 'rate' && (
                                <>
                                  <b>{euro(totale!)} €</b> in tutto.{' '}
                                </>
                              )}
                              {formula.pagamento}. Attivazione {euro(p.data.attivazione)} € una
                              volta sola.

                            </p>
                            <ul class="plan-cond">
                              <li>Durata minima: {formula.durataMinima}</li>
                              <li>Preavviso di disdetta: {p.data.preavviso}</li>
                              {formula.condizioni.map((c) => (
                                <li>{c}</li>
                              ))}
                            </ul>
                          </div>
                        );
                      })}
                    </div>

                    <div class="plan-voci">
                      <p class="plan-delta">
                        {base ? `Tutto di ${base.data.nome}, più` : 'Comprende'}
                      </p>
                      <ul>{nuove.map((v) => <li>{v}</li>)}</ul>
                    </div>

                    {/*
                      Un pulsante per formula, così il lead porta con sé anche
                      **come** vuole pagare: senza JavaScript la pagina non può
                      sapere quale radio è selezionata, e chiederlo di nuovo al
                      telefono è una domanda che l'utente ha già risposto.
                    */}
                    <div class="plan-azioni">
                      {FORMULE.filter((f) => formulaDi(p, f.id)).map((f) => {
                        const portale = formulaDi(p, f.id)?.pgmUrl;
                        return (
                          <div data-formula={f.id}>
                            <div class="plan-coppia">
                            {/*
                              Col link del portale si va dritti al checkout di
                              quella formula. Dove il piano sul portale non
                              c'e' — il mensile esiste solo per il GOLD —
                              resta il form: un «Attiva ora» che apre un
                              carrello vuoto e' peggio di nessun pulsante.
                            */}
                            {portale && (
                              <a
                                href={portale}
                                class={`btn ${p.data.consigliato ? 'btn-red' : 'btn-out'} btn-full`}
                                rel="noopener"
                              >
                                Attiva ora ↗
                              </a>
                            )}
                            {/*
                              La richiamata resta sempre, sotto al checkout:
                              chi ha una domanda lascia un contatto invece di
                              uscire dal sito.
                            */}
                            <button
                              type="button"
                              class={portale ? 'btn-lieve' : `btn ${p.data.consigliato ? 'btn-red' : 'btn-out'} btn-full`}
                              data-open-form="iscrizione"
                              data-medium={`Abbonamenti:${p.data.nome}:${f.label}`}
                              data-abbonamento={p.data.nome}
                            >
                              {portale ? 'Fatti richiamare' : `Richiedi ${p.data.nome}`}
                            </button>
                            </div>
                          </div>
                        );
                      })}
                    </div>
                  </article>
                );
              })
            }
          </div>
        </div>

        <p class="pg-note">
          Ti richiamiamo per scegliere insieme il piano, poi iscrizione e pagamenti si completano
          sul portale <b>PerfectGym</b>.
        </p>
      </div>
    </section>

    <!-- ─── Tabella comparativa ───────────────────────────────────── -->
    <section class="sec band" id="confronto" aria-labelledby="tit-confronto">
      <div class="wrap">
        <div class="sec-head">
          <span class="label">Confronto</span>
          <h2 id="tit-confronto" class="d">Cosa cambia, riga per riga</h2>
        </div>

        <div class="tab-scroll">
          <table class="tab-conf">
            <caption class="sr-only">
              Cosa include ogni piano. Scorri in orizzontale per vedere tutte le colonne.
            </caption>
            <thead>
              <tr>
                <th scope="col">Cosa include</th>
                {
                  piani.map((p) => (
                    <th scope="col" class={p.data.consigliato ? 'hot' : ''}>
                      {p.data.nome}
                    </th>
                  ))
                }
              </tr>
            </thead>
            <tbody>
              {
                righe.map((voce) => (
                  <tr>
                    <th scope="row">{voce}</th>
                    {
                      piani.map((p) => (
                        <td class={p.data.consigliato ? 'hot' : ''}>
                          {include(p, voce) ? (
                            <span class="si" aria-label="Incluso">
                              ✓
                            </span>
                          ) : (
                            <span class="no" aria-label="Non incluso">
                              —
                            </span>
                          )}
                        </td>
                      ))
                    }
                  </tr>
                ))
              }
              {/*
                I prezzi chiudono la tabella invece di aprirla: si scorre per
                capire cosa cambia, e il prezzo è la risposta, non la domanda.
              */}
              <tr class="tab-prezzi">
                <th scope="row">Annuale, in una volta</th>
                {
                  piani.map((p) => {
                    const f = formulaDi(p, 'annuale');
                    return (
                      <td class={p.data.consigliato ? 'hot' : ''}>
                        {f ? `${euro(f.prezzo)} €` : <span class="no">—</span>}
                      </td>
                    );
                  })
                }
              </tr>
              <tr class="tab-prezzi">
                <th scope="row">In 12 rate</th>
                {
                  piani.map((p) => {
                    const f = formulaDi(p, 'rate');
                    return (
                      <td class={p.data.consigliato ? 'hot' : ''}>
                        {f ? `${euro(f.prezzo)} €/mese` : <span class="no">—</span>}
                      </td>
                    );
                  })
                }
              </tr>
              <tr class="tab-prezzi">
                <th scope="row">Mensile, senza vincolo</th>
                {
                  piani.map((p) => {
                    const f = formulaDi(p, 'mensile');
                    return (
                      <td class={p.data.consigliato ? 'hot' : ''}>
                        {f ? `${euro(f.prezzo)} €/mese` : <span class="no">—</span>}
                      </td>
                    );
                  })
                }
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ─── Il listino di ogni centro ─────────────────────────────── -->
    {
      (altriListini.length > 0 || boxMacerata) && (
        <section class="sec" id="listini" aria-labelledby="tit-listini">
          <div class="wrap">
            <span class="label">Gli altri listini</span>
            <h2 id="tit-listini" class="d">Centro per centro</h2>
            <p class="listino-nota" style="max-width:64ch">
              Dal listino 2026/27 i prezzi non sono piu' uguali dappertutto: la stessa sala costa
              660 € a Macerata e 468 € a Montecassiano, e Urban ha due fasce d'eta' invece dei
              piani. Ogni centro ha qui il suo listino, con il suo selettore.
            </p>

            {/*
              Un centro per blocco, uno sotto l'altro, ognuno nel suo
              `.pf-scope`: il selettore di Montecassiano non deve muovere i
              prezzi di Urban.
            */}
            {altriListini.map((c) => {
              const l = c.data.listino!;
              const pianiCentro = alCentro(l.piani, (p) => p.evidenza);
              if (pianiCentro.length === 0) return null;
              return (
                <div class="listino-sede pf-scope" style="margin-top:52px">
                  <span class="label">{c.data.nome}</span>
                  {l.nota && <p class="listino-nota">{l.nota}</p>}

                  <SelettoreFormula prefisso={`f-${c.id}`} />

                  <SchedePiani
                    piani={pianiCentro}
                    attivazione={l.attivazione}
                    centro={c.id}
                    raccogliLead={Boolean(SEDI[c.id])}
                  />

                  {l.over65?.annuale && (
                    <p class="listino-over">
                      <b>{l.over65.titolo}</b>
                      {l.over65.per && <> — {l.over65.per}</>}:{' '}
                      <span data-formula="annuale">
                        {alMese(l.over65.annuale)} € al mese, {l.over65.annuale} € in unica
                        soluzione.
                      </span>
                      {l.over65.rate && (
                        <span data-formula="rate">
                          {alMese(l.over65.rate)} € al mese, {l.over65.rate} € in tutto in 12 rate.
                        </span>
                      )}
                      {l.over65.mensile && (
                        <span data-formula="mensile">
                          {l.over65.mensile} € al mese, senza vincolo di durata.
                        </span>
                      )}
                    </p>
                  )}
                </div>
              );
            })}

            {/*
              Il Box di Macerata chiude la sezione: e' un listino a se', con
              la sua quota di attivazione e la sua scadenza.
            */}
            {boxMacerata && boxMacerata.piani.length > 0 && (
              <div class="listino-sede pf-scope" style="margin-top:52px">
                <span class="label">Lume Macerata — {boxMacerata.titolo}</span>
                {boxMacerata.nota && <p class="listino-avviso">{boxMacerata.nota}</p>}

                <SelettoreFormula prefisso="f-box" />

                <SchedePiani
                  piani={alCentro(boxMacerata.piani, (p) => p.evidenza)}
                  attivazione={boxMacerata.attivazione}
                  centro="macerata"
                  raccogliLead={Boolean(SEDI.macerata)}
                />

                {boxMacerata.pacchetti && boxMacerata.pacchetti.voci.length > 0 && (
                  <p class="listino-over">
                    {boxMacerata.pacchetti.voci.map((v, i) => (
                      <>
                        {i > 0 && ' '}
                        <b>{v.nome}</b>
                        {v.per && <> — {v.per}</>}: {v.mensile} € al mese.{' '}
                      </>
                    ))}
                    {boxMacerata.pacchetti.nota && (
                      <>
                        <br />
                        {boxMacerata.pacchetti.nota}
                      </>
                    )}
                  </p>
                )}
              </div>
            )}
          </div>
        </section>
      )
    }

    <!-- ─── Guest Pass ────────────────────────────────────────────── -->
    <section class="sec" style="padding-top:56px;padding-bottom:56px">
      <div class="wrap">
        <div class="gp-strip">
          <div>
            <span class="label">Prima di decidere</span>
            <h2 class="d">Sette giorni di Guest Pass</h2>
            <p>
              Accesso completo al centro per una settimana a {euro(PASS.pieno)} €, con un istruttore
              che ti accompagna al primo ingresso. Solo per chi non ha mai avuto un abbonamento
              Lume.
            </p>
          </div>
          {/*
            Puntava a /guest-pass, che non esiste: la pagina del pass è /prova.
            Un 404 proprio sul pulsante che chiude la pagina dei prezzi.
          */}
          <a href="/prova" class="btn btn-cream">Attiva il pass</a>
        </div>
      </div>
    </section>

    {
      inArrivo.length > 0 && (
        <section class="sec" style="padding-top:0">
          <div class="wrap">
            <div class="promo">
              <div>
                <span class="label" style="color:#fff">
                  Prevendita attiva
                </span>
                <h2 class="d" style="margin-top:12px">
                  Tariffa lancio nei nuovi centri
                </h2>
                <p>
                  {inArrivo.map((c) => c.data.nome).join(' e ')} aprono presto. Chi si iscrive
                  adesso blocca la tariffa lancio e la tiene anche dopo l'apertura.
                </p>
              </div>
              <a
                href={siteConfig.prevenditaUrl}
                class="btn btn-cream btn-full"
                style="max-width:340px"
                target="_blank"
                rel="noopener"
              >
                Blocca la tariffa lancio ↗
              </a>
            </div>
          </div>
        </section>
      )
    }

    {
      faq.length > 0 && (
        <section class="sec" style="padding-top:0" aria-labelledby="tit-faq">
          <div class="wrap">
            <div class="sec-head">
              <span class="label">Domande frequenti</span>
              <h2 id="tit-faq" class="d">
                Prima che tu lo chieda
              </h2>
            </div>
            <div class="faq">
              {faq.map((v) => (
                <details>
                  <summary>{v.data.titolo}</summary>
                  <div class="faq-in">
                    <p>{v.data.sintesi}</p>
                    <a href={`/lume-life/help/${v.id}`}>Leggi la risposta completa</a>
                  </div>
                </details>
              ))}
            </div>
            <p class="pg-note" style="margin-top:26px">
              Durata, rinnovi, disdette e sospensioni sono scritti per esteso nella{' '}
              <a href="/lume-life">wiki Lume</a>.
            </p>
          </div>
        </section>
      )
    }
  </main>

  <Footer />
</Layout>

---
import Layout from '../layouts/Layout.astro';
import { LINK_BOTTONI } from '../config/linktree';
---

<Layout
  title="Link — Lume Fitness Club"
  description="Tutti i link di Lume Fitness Club: prevendita, informazioni, planning e sedi."
>
  <main id="contenuto" class="lk">
    <header class="lk-head">
      <img src="/logo-lume.png" alt="" width="88" height="88" onerror="this.remove()" />
      <h1>Lume Fitness Club</h1>
      <p>Benessere a 360°</p>
    </header>

    <nav class="lk-list" aria-label="Link">
      {
        LINK_BOTTONI.map((b) => (
          <a
            class={`lk-btn${b.evidenza ? ' lk-btn--on' : ''}`}
            href={b.href}
            data-slug={b.slug}
            data-vid={b.vid ? '1' : undefined}
          >
            {b.label}
          </a>
        ))
      }
    </nav>
  </main>
</Layout>

<style>
  .lk { max-width: 480px; margin: 0 auto; padding: 48px 16px 64px; min-height: 100vh; }
  .lk-head { text-align: center; margin-bottom: 32px; }
  .lk-head img { border-radius: 50%; margin-bottom: 12px; }
  .lk-head h1 { font-family: 'Anton', sans-serif; font-weight: 400; font-size: 2rem; margin: 0; text-transform: uppercase; }
  .lk-head p { color: var(--mut); margin: 4px 0 0; }
  .lk-list { display: flex; flex-direction: column; gap: 12px; }
  .lk-btn {
    display: block; padding: 16px 20px; text-align: center; font-weight: 600; text-decoration: none;
    color: var(--txt); background: var(--card); border: 1px solid var(--line); border-radius: 12px;
  }
  .lk-btn:hover, .lk-btn:focus-visible { border-color: var(--red-txt); }
  .lk-btn--on { background: var(--red); border-color: var(--red); }
</style>

<script>
  // Un click = un beacon verso /api/click. Il beacon sopravvive alla navigazione.
  // vid e UTM esistono solo dopo il consenso analytics: senza, il click è anonimo.
  const w = window as any;
  document.querySelectorAll<HTMLAnchorElement>('.lk-btn').forEach((a) => {
    a.addEventListener('click', () => {
      const vid = w.lumeGetVid?.() ?? null;
      const utm = w.lumeGetUtm?.() ?? null;
      navigator.sendBeacon(
        '/api/click',
        new Blob(
          [JSON.stringify({ slug: a.dataset.slug, vid, utm, referrer: document.referrer || null })],
          { type: 'text/plain;charset=UTF-8' },
        ),
      );
      if (vid && a.dataset.vid) {
        const u = new URL(a.href);
        u.searchParams.set('vid', vid);
        a.href = u.toString();
      }
    });
  });
</script>

    font-size: 14px;
    font-weight: 600;
    color: #eee;
  }
  .lp-tel span {
    color: var(--red);
    font-size: 10px;
  }

  /* ─── Hero ────────────────────────────────────────────────────────────── */
  .lp-hero {
    position: relative;
    padding: 40px 0 56px;
  }
  .lp-hero-sfondo,
  .lp-banda-sfondo,
  .lp-chiusura-sfondo {
    position: absolute;
    inset: 0;
    z-index: 0;

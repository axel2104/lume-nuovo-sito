  .lp-banda-sfondo::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(10, 10, 10, 0.82), rgba(10, 10, 10, 0.92));
  }
  .lp-banda-in {
    position: relative;
    z-index: 2;
    text-align: center;
  }
  .lp-banda-numeri {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 26px 16px;
    margin-top: 30px;
  }
  .lp-banda-numeri b {
    display: block;
    font-family: 'Anton', sans-serif;
    font-weight: 400;
    font-size: clamp(38px, 9vw, 58px);
    line-height: 1;
    color: #fff;
  }
  .lp-banda-numeri span {
    display: block;
    margin-top: 6px;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--mut);
    line-height: 1.5;
  }

  /* ─── Cosa è incluso, con foto ────────────────────────────────────────── */
  .lp-griglia {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
    margin-top: 30px;
  }
  .lp-card {
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--lf-r-m, 10px);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .lp-card :global(img),
  .lp-card-grafica {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .lp-card-grafica {
    display: grid;
    place-content: center;
    text-align: center;
    gap: 4px;
    background:
      radial-gradient(80% 80% at 30% 20%, rgba(196, 0, 66, 0.35), transparent 70%),
      linear-gradient(140deg, #16181c, #0d0f12 60%, #1a1d22);
    border-bottom: 1px solid var(--line);
  }
  .lp-card-grafica b {
    font-family: 'Anton', sans-serif;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: clamp(26px, 5vw, 40px);
    color: #fff;
  }
  .lp-card-grafica span {
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--mut);
  }
  .lp-card-testo {
    padding: 22px;
  }
  .lp-card p {
    font-size: 14px;
    margin: 0;
  }

  .lp-due {
    display: grid;
    grid-template-columns: 1fr;
    gap: 36px;
  }
  .lp-foto-coppia {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .lp-foto-coppia :global(img) {
    width: 100%;
    height: 100%;
    /* Verticali: due foto orizzontali basse lasciavano vuota mezza colonna
       accanto a un testo lungo. */
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: var(--lf-r-m, 10px);
  }
  /* Nello scatto del corridoio la prospettiva sta a sinistra e le macchine a
     destra: ritagliato al centro si vede solo il ferro scuro, che in verticale
     non dice niente. */
  .lp-foto-coppia :global(img.lp-foto-sinistra) {
    object-position: 18% center;
  }

  .lp-passi {
    list-style: none;
    padding: 0;
    margin: 30px 0 0;
    display: grid;
    gap: 16px;
  }
  .lp-passi li {
    display: grid;
    grid-template-columns: 54px 1fr;
    gap: 16px;
    align-items: start;
    padding: 22px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--lf-r-m, 10px);
  }
  .lp-passi b {
    font-family: 'Anton', sans-serif;
    font-weight: 400;
    font-size: 34px;
    line-height: 1;
    color: var(--red-txt);
  }
  .lp-passi p {
    font-size: 14px;
    margin: 0;
  }

  /* ─── I centri ────────────────────────────────────────────────────────── */
  .lp-sedi {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
    margin-top: 28px;
  }
  .lp-sede {
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--lf-r-m, 10px);
    overflow: hidden;
  }
  .lp-sede :global(img) {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }
  .lp-sede-testo {
    padding: 22px;
  }
  .lp-sede p {
    font-size: 14px;
    margin: 0 0 4px;
  }
  .lp-orari {
    color: var(--mut) !important;
    font-size: 13px !important;
  }
  .lp-sede-nota {
    margin-top: 10px !important;
    font-size: 13px !important;
    color: var(--red-txt) !important;
  }

  .lp-regole {
    margin: 0;
    padding-left: 20px;
    display: grid;
    gap: 10px;
  }
  .lp-regole li {
    color: #ddd;
    font-size: 15px;
    line-height: 1.5;
  }

  .lp-faq {
    margin-top: 26px;
    border-top: 1px solid var(--line);
  }
  .lp-faq details {
    border-bottom: 1px solid var(--line);
  }
  .lp-faq summary {
    cursor: pointer;
    padding: 20px 34px 20px 0;
    font-size: 16px;
    font-weight: 600;
    color: #fff;
    position: relative;
    list-style: none;
    min-height: 44px;
  }
  .lp-faq summary::-webkit-details-marker {
    display: none;
  }
  .lp-faq summary::after {
    content: '+';
    position: absolute;
    right: 4px;
    top: 18px;
    font-size: 22px;
    line-height: 1;
    color: var(--red-txt);
  }
  .lp-faq details[open] summary::after {
    content: '–';
  }
  .lp-faq p {
    margin: 0 0 22px;
    font-size: 15px;
    max-width: 68ch;
  }

  /* ─── Chiusura ────────────────────────────────────────────────────────── */
  .lp-chiusura {
    position: relative;
    padding: 84px 0 120px;
    border-top: 1px solid var(--line);
    text-align: center;
  }
  .lp-chiusura-sfondo :global(img) {
    opacity: 0.26;
  }
  .lp-chiusura-sfondo::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(70% 60% at 50% 0%, rgba(196, 0, 66, 0.2), transparent 70%),
      linear-gradient(180deg, rgba(10, 10, 10, 0.86), rgba(10, 10, 10, 0.94));
  }
  .lp-chiusura-in {
    position: relative;
    z-index: 2;
  }
  .lp-chiusura p {
    max-width: 58ch;
    margin: 0 auto 28px;
  }
  .lp-cta-grande {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 56px;
    padding: 0 34px;
    font-size: 15px;
  }
  .lp-chiusura-tel {
    margin-top: 24px !important;
    font-size: 14px;
    color: var(--mut) !important;
  }
  .lp-chiusura-tel a {
    color: var(--red-txt);
    text-decoration: underline;
  }

  /* ─── Barra di richiamo ───────────────────────────────────────────────── */
  .lp-barra {
    position: fixed;
    z-index: 40;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 12px 16px;
    background: rgba(10, 10, 10, 0.92);
    backdrop-filter: blur(10px);
    border-top: 1px solid var(--line);
    transform: translateY(110%);
    transition: transform 0.3s ease;
  }
  .lp-barra.si-vede {
    transform: translateY(0);
  }
  .lp-barra b {
    font-family: 'Anton', sans-serif;
    font-weight: 400;
    font-size: 22px;
    color: #fff;
    margin-right: 10px;
  }
  .lp-barra span {
    font-size: 12px;
    color: var(--mut);
  }
  .lp-barra .btn {
    min-height: 44px;
    padding: 0 20px;
    white-space: nowrap;
  }

  @media (min-width: 700px) {
    .lp-griglia,
    .lp-sedi {
      grid-template-columns: 1fr 1fr;
    }
    .lp-passi {
      grid-template-columns: repeat(3, 1fr);
    }
    .lp-banda-numeri {
      grid-template-columns: repeat(4, 1fr);
    }
    .lp-barra b {
      font-size: 26px;
    }
  }

  @media (min-width: 1000px) {
    .lp-hero {
      padding: 30px 0 80px;
      min-height: 92dvh;
      display: flex;
      align-items: center;
    }
    .lp-hero-in {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 56px;
      align-items: center;
    }
    .lp-sez {
      padding: 92px 0;
    }
    .lp-banda {
      padding: 96px 0;
    }
    .lp-due {
      grid-template-columns: 1fr 1fr;
      gap: 64px;
      align-items: start;
    }
    .lp-passi li {
      grid-template-columns: 1fr;
      gap: 10px;
    }
    /* Il mosaico su desktop: quattro colonne, la prima tessera occupa due
       colonne e due righe. */
    /* Tre colonne per sei tessere: due righe piene, nessuna orfana. La
       striscia panoramica sopra fa da tessera grande, e lo fa meglio — le
       foto vere della sala pesi sono panoramiche. */
    .lp-mosaico {
      grid-template-columns: repeat(3, 1fr);
      grid-auto-rows: 230px;
    }
    .lp-tessera {
      min-height: 0;
    }
    .lp-striscia {
      aspect-ratio: 3 / 1;
      margin-bottom: 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lp-barra {
      transition: none;
    }
    .lp-tessera:hover :global(img) {
      transform: none;
    }
  }
</style>

<script>
  /* La barra appare quando il form dell'hero è uscito dallo schermo: mentre il
     form si vede, un pulsante che dice «vai al form» è rumore. */
  const barra = document.querySelector('[data-lp-barra]');
  const form = document.getElementById('richiedi');

  if (barra instanceof HTMLElement && form) {
    if ('IntersectionObserver' in window) {
      const osserva = new IntersectionObserver(
        ([voce]) => barra.classList.toggle('si-vede', !voce.isIntersecting),
        { rootMargin: '-80px 0px 0px 0px' },
      );
      osserva.observe(form);
    } else {
      // Senza IntersectionObserver la barra resta visibile: meglio un pulsante
      // in più che nessun modo di tornare al form.
      barra.classList.add('si-vede');
    }
  }

  /*
    Solo chi arriva con un invito vede il prezzo dell'invito.

    Due posti dove guardare, non uno: `?ref=` nell'URL, e l'attribuzione che
    `tracking.js` tiene in sessionStorage. Serve il secondo perché chi apre il
    link di un amico, gira per il sito e poi torna qui arriva senza `?ref=`
    nell'URL ma col suo invito ancora addosso — il lead lo porta comunque, e
    allora tanto vale dirglielo anche in pagina.
  */
  const mostraInvito = () => {
    let ref = '';
    try {
      ref = (new URLSearchParams(location.search).get('ref') || '').trim();
    } catch (e) {}
    if (!ref) {
      try {
        ref = String((window.lumeGetUtm && window.lumeGetUtm().ref) || '').trim();
      } catch (e) {}
    }
    if (!ref) return;
    document.querySelectorAll('[data-prova-ref]').forEach((el) => {
      if (el instanceof HTMLElement) el.hidden = false;
    });
  };

  // `tracking.js` può non essere ancora arrivato: si riprova a caricamento finito.
  mostraInvito();
  window.addEventListener('load', mostraInvito, { once: true });
</script>

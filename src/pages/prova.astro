  .lp-hero-sfondo :global(img),
  .lp-banda-sfondo :global(img),
  .lp-chiusura-sfondo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .lp-hero-sfondo :global(img) {
    opacity: 0.34;
  }
  /* Il gradiente non è decorazione: senza, il titolo bianco su una foto chiara
     diventa illeggibile a metà. */
  .lp-hero-sfondo::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(10, 10, 10, 0.5) 0%, rgba(10, 10, 10, 0.9) 72%, var(--bg) 100%),
      radial-gradient(60% 50% at 20% 20%, rgba(196, 0, 66, 0.24), transparent 70%);
  }
  .lp-hero-in {
    position: relative;
    z-index: 2;
    width: min(1180px, 92vw);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    align-items: start;
  }
  /* 66px e non 76: sopra, «Tutto Lume.» e la riga del prezzo perdono il ritmo
     e il titolo va a capo dove non deve. */
  .lp-hero h1 {
    font-size: clamp(36px, 8.4vw, 66px);
    margin: 14px 0 18px;
  }
  .lp-hero h1 em {
    color: var(--red-txt);
    font-style: normal;
  }
  .lp-lead {
    font-size: 17px;
    max-width: 46ch;
    margin-bottom: 26px;
  }
  .lp-prezzo {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 18px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    margin-bottom: 22px;
  }
  .lp-prezzo b {
    font-family: 'Anton', sans-serif;
    font-weight: 400;
    font-size: clamp(44px, 10vw, 64px);
    line-height: 1;
    color: var(--red-txt);
  }
  .lp-prezzo span {
    font-size: 13px;
    line-height: 1.45;
    color: var(--mut);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .lp-punte {
    list-style: none;
    padding: 0;
    margin: 0 0 26px;
    display: grid;
    gap: 9px;
  }
  .lp-punte li {
    position: relative;
    padding-left: 24px;
    font-size: 15px;
    color: #ddd;
  }
  .lp-punte li::before {
    content: '';
    position: absolute;
    left: 4px;
    top: 8px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--red);
  }
  .lp-numeri {
    display: grid;
    grid-template-columns: repeat(3, auto);
    /* Allineati in alto: le etichette hanno lunghezze diverse, e su schermo
       stretto una che va a capo non deve trascinare giù la cifra accanto. */
    align-items: start;
    justify-content: start;
    gap: 22px;
  }
  .lp-numeri b {
    display: block;
    font-family: 'Anton', sans-serif;
    font-weight: 400;
    font-size: 30px;
    line-height: 1;
    color: #fff;
  }
  .lp-numeri span {
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--mut);
  }
  /* Il form ha un fondo pieno: sopra una foto, un form trasparente non si legge
     e non sembra un posto dove scrivere. */
  .lp-form {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--lf-r-m, 10px);
    padding: 6px;
    scroll-margin-top: 20px;
  }

  /* ─── Sezioni ─────────────────────────────────────────────────────────── */
  .lp-sez {
    padding: 62px 0;
    border-top: 1px solid var(--line);
  }
  .lp-sez-scura {
    background: var(--card);
  }
  .lp-sez-foto {
    background: var(--card);
  }
  .lp-sez-regole {
    background: linear-gradient(180deg, rgba(196, 0, 66, 0.06), transparent);
  }

  /* ─── Mosaico ─────────────────────────────────────────────────────────── */
  .lp-mosaico {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .lp-tessera {
    position: relative;
    margin: 0;
    overflow: hidden;
    border-radius: var(--lf-r-m, 10px);
    border: 1px solid var(--line);
    min-height: 190px;
  }
  .lp-tessera :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .lp-tessera:hover :global(img) {
    transform: scale(1.04);
  }
  /* Il velo scuro in basso: le etichette bianche su una foto chiara
     spariscono, e un'etichetta illeggibile è peggio di nessuna etichetta. */
  .lp-tessera figcaption {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 2;
    padding: 34px 16px 14px;
    background: linear-gradient(180deg, transparent, rgba(10, 10, 10, 0.88));
  }
  .lp-tessera figcaption b {
    display: block;
    font-family: 'Anton', sans-serif;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    font-size: 15px;
    color: #fff;
  }
  .lp-tessera figcaption span {
    font-size: 12px;
    color: #cfcfcf;
  }
  /* La striscia: le panoramiche sono 3:1 e vanno mostrate per quello che sono.
     Su telefono il rapporto si stringe a 2:1, altrimenti alta 90px non
     racconta niente. */
  .lp-striscia {
    position: relative;
    margin: 28px 0 10px;
    overflow: hidden;
    border-radius: var(--lf-r-m, 10px);
    border: 1px solid var(--line);
    aspect-ratio: 2 / 1;
  }
  .lp-striscia :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  /* Come nelle tessere: una sfumatura, non un'ombra. Su una sala pesi chiara
     e piena di dettagli il testo con la sola ombra non si legge. */
  .lp-striscia figcaption {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 2;
    padding: 44px 18px 14px;
    background: linear-gradient(180deg, transparent, rgba(10, 10, 10, 0.9));
    font-size: 12px;
    color: #cfcfcf;
  }
  .lp-striscia figcaption b {
    display: block;
    font-family: 'Anton', sans-serif;
    font-weight: 400;
    font-size: 17px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: #fff;
  }

  /* ─── Banda dei numeri su foto ────────────────────────────────────────── */
  .lp-banda {
    position: relative;
    padding: 70px 0;
    border-top: 1px solid var(--line);

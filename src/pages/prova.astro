       sotto di lei e diventano irraggiungibili proprio in fondo alla pagina. */
    padding: 8px 24px 84px;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.4);
  }
  .lp-legale nav {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
  }
  .lp-legale a {
    /* Bersaglio da pollice: il testo resta piccolo, l'area cliccabile no.
       In fondo alla pagina, su telefono, un link alto 21px si sbaglia. */
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: inherit;
    text-decoration: none;
  }
  .lp-legale a span {
    border-bottom: 1px solid rgba(255, 255, 255, 0.18);
  }
  .lp-legale a:hover,
  .lp-legale a:focus-visible {
    color: #fff;
  }
  .lp-legale a:hover span,
  .lp-legale a:focus-visible span {
    border-bottom-color: #fff;
  }

  /* La landing non usa .sec/.wrap del sito: ha una scala sua, più larga, perché
     non deve convivere con header e footer. */
  .lp {
    background: var(--bg);
    overflow-x: clip;
  }
  .lp-wrap {
    width: min(1180px, 92vw);
    margin: 0 auto;
  }
  .lp-stretto {
    width: min(760px, 92vw);
  }
  .lp-eyebrow {
    display: block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--red-txt);
    margin-bottom: 14px;
  }
  .lp h2.d {
    font-size: clamp(30px, 5.4vw, 50px);
    margin: 0 0 16px;
  }
  .lp h3 {
    font-family: 'Anton', sans-serif;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    font-size: 17px;
    margin: 0 0 8px;
  }
  .lp p {
    color: #cfcfcf;
    line-height: 1.6;
  }
  .lp-sub {
    max-width: 60ch;
    color: var(--mut) !important;
  }
  .lp-nota {
    font-size: 13px;
    color: var(--mut) !important;
  }

  /* ─── Barra in cima: logo e telefono, niente navigazione ─────────────── */
  .lp-top {
    position: relative;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    width: min(1180px, 92vw);
    margin: 0 auto;
    padding: 18px 0 0;
  }
  .lp-logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    white-space: nowrap;
    font-family: 'Anton', sans-serif;
    font-size: 24px;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: #fff;
  }
  .lp-logo img {
    display: block;
  }
  .lp-logo-txt {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }
  .lp-logo-sub {
    color: var(--red-txt);

---
/**
 * Landing del pass prova — la pagina che deve vendere i sette giorni.
 *
 * Destinazione dei redirect da `/provagratis` e da
 * `n8n.lumeflow.it/form/guest-pass`, e delle campagne a pagamento. È l'unica
 * pagina del sito **senza header e senza footer**: chi arriva da un'inserzione
 * ha una domanda sola in testa, e ogni link che porta altrove è un modo di
 * perderlo. La navigazione ricompare quando ha deciso.
 *
 * ─── L'ordine, e perché è questo ───────────────────────────────────────────
 * Il form sta **nell'hero**: su desktop è la colonna destra, su mobile è la
 * prima cosa dopo il prezzo. Chi è già convinto non deve scorrere niente.
 * Sotto, in ordine: cosa si apre (foto, non elenchi), cosa entra nei sette
 * giorni, i numeri, chi è Lume, come funziona, dove, le regole senza
 * asterischi, le domande. Una barra in basso riporta al form da qualunque
 * punto.
 *
 * **Un solo form in pagina.** Due istanze dello stesso flusso significano id
 * duplicati e due lead dalla stessa persona: tutti i pulsanti portano allo
 * stesso `#richiedi`.
 *
 * ─── Le foto ───────────────────────────────────────────────────────────────
 * Sono quelle vere delle sale, prese dagli asset delle discipline e dei
 * centri: ogni etichetta dice quello che si vede. Dell'acqua non c'è uno
 * scatto in repository, quindi quel riquadro è testo — una foto della sala
 * pesi con scritto «piscina» sarebbe una bugia detta con un'immagine, che è
 * la più difficile da smentire. Quando arriva la foto della piscina, entra lì.
 *
 * ─── Cosa NON si dichiara ──────────────────────────────────────────────────
 * Nessun contatore di posti rimasti, nessuna scadenza inventata. I numeri —
 * ore di corsi, discipline, media recensioni — sono gli stessi dei contenuti
 * del sito, calcolati dove è possibile calcolarli. Su un'offerta da 15 € la
 * fiducia è l'unica leva che conta davvero.
 */
import Layout from '../layouts/Layout.astro';
import FormInline from '../components/forms/FormInline.astro';
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import { SEDI } from '../config/forms';
import { PASS } from '../data/abbonamenti';

// Foto vere dei due centri, arrivate dalle PSD e dagli scatti della piscina.
// Sono la ragione per cui in questa pagina lo stock è ridotto al minimo: una
// panoramica della sala pesi con la gente dentro vende più di qualsiasi
// immagine comprata.
import panoSalaPesi from '../assets/centri/macerata-sala-pesi-pano.jpg';
import panoGymFloor from '../assets/centri/macerata-gymfloor-pano.jpg';
import interniMacerata from '../assets/centri/macerata-interni.jpg';
import piscina from '../assets/centri/montecassiano-piscina.jpg';
import acquabike from '../assets/centri/montecassiano-acquabike.jpg';
import bodycombat from '../assets/discipline/lesmills-bodycombat.jpg';
import salaCorsi from '../assets/discipline/sala-corsi.jpg';
// Stock, per le sale di cui non abbiamo ancora uno scatto nostro.
import functional from '../assets/pagine/functional.jpg';
import gymFloor from '../assets/discipline/gym-floor.jpg';
import crossfit from '../assets/discipline/crossfit.jpg';
import reformer from '../assets/discipline/reformer.jpg';
import bodypump from '../assets/discipline/lesmills-bodypump.jpg';
import boxing from '../assets/discipline/boxing-hero.jpg';
import intensityou from '../assets/discipline/intensityou.jpg';
import pilates from '../assets/discipline/pilates.jpg';
import walking from '../assets/discipline/walking.jpg';

const centri = (await getCollection('centri'))
  .filter((c) => SEDI[c.id])
  .sort((a, b) => a.data.ordine - b.data.ordine);

const discipline = await getCollection('discipline');

/**
 * Le ore di corsi della settimana tipo, contate dal planning dei centri.
 *
 * Lo stesso numero della home, calcolato allo stesso modo: un corso aggiunto
 * lo aggiorna da sé. Su una landing un numero scritto a mano invecchia e
 * diventa una bugia — e qui è uno degli argomenti di vendita.
 */
const minutiDi = (ora: string) => {
  const [h, m] = ora.split(':').map(Number);
  return (h || 0) * 60 + (m || 0);
};
const oreCorsi = Math.round(
  (await getCollection('centri'))
    .flatMap((c) => c.data.planning ?? [])
    .reduce((tot, l) => tot + Math.max(0, minutiDi(l.fine) - minutiDi(l.inizio)), 0) / 60,
);

/**
 * Il mosaico: ogni riquadro è una sala vera, con l'etichetta di quello che si
 * vede. L'etichetta non abbellisce lo scatto, lo dichiara — un riquadro che
 * promette una sala e ne mostra un'altra è la bugia più facile da raccontare
 * su una landing, e la più facile da smascherare all'ingresso.
 *
 * In testa c'è una striscia panoramica: le foto vere della sala pesi sono
 * 3:1, e ritagliarle dentro una tessera quadrata butterebbe via proprio la
 * cosa che le rende utili, cioè quanto è grande la sala.
 */
const mosaico = [
  { foto: bodycombat, tag: 'Corsi Les Mills', nota: 'BodyPump, BodyCombat, RPM' },
  { foto: piscina, tag: 'Piscina', nota: '6 corsie a Montecassiano' },
  { foto: salaCorsi, tag: 'Sala corsi', nota: 'Neon, specchi, impianto' },
  { foto: reformer, tag: 'Sala Reformer', nota: 'Peak Pilates e Wellback' },
  { foto: boxing, tag: 'Boxing Hero', nota: 'Tecnica e sacchi' },
  { foto: intensityou, tag: 'IntensitYOU', nota: 'Circuito funzionale' },
];

const incluso = [
  {
    foto: gymFloor,
    titolo: 'Sala pesi e cardio',
    testo:
      'Gym floor Technogym. Il primo ingresso lo fai con un tecnico che ti imposta la scheda: non ti lasciamo davanti a una macchina a indovinare.',
  },
  {
    foto: bodypump,
    titolo: `${discipline.length} discipline, corsi inclusi`,
    testo: `Tutti i corsi di gruppo in licenza Les Mills, prenotabili da app. ${oreCorsi} ore di lezione a settimana fra i due centri: il problema è scegliere.`,
  },
  {
    foto: crossfit,
    titolo: 'CrossFit e Reformer',
    testo:
      'Anche le discipline su prenotazione. Non sono un extra da pagare a parte: nei sette giorni sono dentro come tutto il resto.',
  },
  {
    foto: acquabike,
    titolo: 'Acqua',
    testo:
      'Nuoto libero assistito, acquagym, acquabike, AcquaWalk. La piscina è a Montecassiano, e il pass vale anche lì.',
  },
];

const passi = [
  {
    n: '1',
    titolo: 'Compili il form',
    testo: 'Trenta secondi: dove vuoi allenarti, come ti chiami, dove ti richiamiamo.',
  },
  {
    n: '2',
    titolo: 'Ti richiamiamo e attivi',
    testo:
      `Ti chiamiamo per fissare il primo ingresso. Il pass si attiva in reception con un documento e ${PASS.pieno} €, entro 30 giorni dalla richiesta.`,
  },
  {
    n: '3',
    titolo: 'Sette giorni pieni',
    testo:
      'Dal primo ingresso, sette giorni consecutivi di accesso completo. Nessun rinnovo automatico: quando finiscono, finiscono.',
  },
];

const domande = [
  {
    d: 'Cosa costa esattamente, e cosa no?',
    r: 'Quindici euro, una volta sola, per sette giorni consecutivi. Nessuna quota di attivazione, nessun rinnovo automatico, nessuna carta da lasciare. La quota di attivazione da 50 € riguarda gli abbonamenti, non il pass.',
  },
  {
    d: 'Chi può richiederlo?',
    r: 'Chi non ha mai avuto un abbonamento o un pass Lume. È una prova, non una tariffa: per questo è uno per persona. Se sei già stato nostro socio, in reception ti dicono le condizioni per rientrare.',
  },
  {
    d: 'Devo sapere già cosa fare in palestra?',
    r: 'No, ed è il punto. Al primo ingresso un tecnico ti accompagna, guarda come ti muovi e ti imposta una scheda. Nei sette giorni provi i corsi che vuoi: nessuno si aspetta che tu sappia già usare tutto.',
  },
  {
    d: 'Posso allenarmi in entrambi i centri?',
    r: 'Sì. Il pass vale su Macerata e Montecassiano, con gli orari di ciascuno. La piscina è a Montecassiano, il Box CrossFit a Macerata.',
  },
  {
    d: 'E se dopo volessi abbonarmi?',
    r: 'Se decidi di restare, gli abbonamenti partono da 52 € al mese in dodici rate. Ma non è una cosa da decidere adesso: i sette giorni servono a capirlo, e nessuno ti chiederà di firmare niente prima.',
  },
];
---

<Layout
  title={`7 giorni a Lume per ${PASS.pieno} € — tutto aperto, poi decidi`}
  description={`Sette giorni di accesso completo ai centri Lume a ${PASS.pieno} €: sala pesi Technogym, ${discipline.length} discipline, corsi Les Mills, piscina, CrossFit e Reformer. Una volta sola, nessun rinnovo automatico.`}
  image={bodycombat}
>
  <main class="lp" id="contenuto">
    {/*
      Non è un header: nessuna navigazione, nessun link che porti fuori. Il
      logo dice dove si è arrivati, il telefono serve a chi preferisce
      chiamare — che su una landing è la seconda conversione più frequente.
    */}
    <div class="lp-top">
      {/*
        Il marchio nella forma decisa a monte: logo, LUME tutto bianco, e
        «Fitness Club» in piccolo sotto con l'accento rosso. Qui non è un
        link — su una landing il logo che riporta alla home è una via
        d'uscita, e l'unica uscita che vogliamo offrire è il telefono.
      */}
      <span class="lp-logo">
        <img src="/logo-lume.png" alt="" width="30" height="30" />
        <span class="lp-logo-txt">LUME<span class="lp-logo-sub">Fitness Club</span></span>
      </span>
      <a class="lp-tel" href="tel:+390733232905">
        <span aria-hidden="true">●</span> 0733 232905
      </a>
    </div>

    <header class="lp-hero">
      <div class="lp-hero-sfondo" aria-hidden="true">
        <Picture
          src={panoSalaPesi}
          alt=""
          widths={[720, 1200, 1800]}
          sizes="100vw"
          formats={['avif', 'webp']}
          loading="eager"
          fetchpriority="high"
        />
      </div>

      <div class="lp-hero-in">
        <div class="lp-hero-copy">
          <span class="lp-eyebrow">Pass prova · 7 giorni · {PASS.pieno} €</span>
          <h1 class="d">
            Sette giorni.<br />
            Tutto Lume.<br />
            {/*
              Scritto a parole, non da `PASS.pieno`: in un titolo su tre righe
              «Quindici euro» batte «15 €» di distacco. Va da sé che se il
              prezzo cambia questa riga si cambia a mano — ed è giusto, perché
              a quel punto cambia il titolo, non un numero.
            */}
            <em>Quindici euro.</em>
          </h1>
          <p class="lp-lead">
            Sala pesi, {discipline.length} discipline, corsi Les Mills, piscina, CrossFit,
            Reformer. Tutto aperto, per sette giorni consecutivi. Poi decidi tu.
          </p>

          <div class="lp-prezzo">
            <b>{PASS.pieno} €</b>
            <span>
              una volta sola<br />
              7 giorni consecutivi
            </span>
          </div>

          {/*
            L'invito di un socio: sta nel markup ma parte nascosto, e lo
            accende solo `ref`. La pagina è statica e servita identica a
            tutti, quindi il prezzo ridotto non può essere tolto dal
            sorgente — può però non stare in vetrina accanto al prezzo
            pieno, che è il punto. Il codice qui non lo verifica nessuno:
            lo sconto vero lo applica n8n sul lead.
          */}
          <p class="lp-invito" data-prova-ref hidden>
            <b>Ti ha invitato un socio Lume</b>
            Con questo invito la settimana ti costa {PASS.referral} € invece di {PASS.pieno} €.
            {/* Non «qui accanto» né «qui sotto»: il form sta a destra su
                schermo grande e sotto sul telefono. */}
            Compila il form: in reception ti aspettano già scontato.
          </p>

          <ul class="lp-punte">
            <li>Nessun rinnovo automatico</li>
            <li>Accesso completo, non ridotto</li>
            <li>Primo ingresso con un tecnico</li>
          </ul>

          <div class="lp-numeri">
            <div><b>{oreCorsi}</b><span>ore di corsi<br />a settimana</span></div>
            <div><b>{discipline.length}</b><span>discipline<br />in licenza</span></div>
            <div><b>4.97</b><span>media<br />recensioni</span></div>
          </div>
        </div>

        {/*
          Il form nell'hero, non in fondo: chi è già convinto non deve
          scorrere. È l'unica istanza in pagina.
        */}
        <div class="lp-form" id="richiedi">
          <FormInline flusso="prova" medium="PaginaProva" />
        </div>
      </div>
    </header>

    {/* ─── Il mosaico: si vede prima di leggere ──────────────────────────── */}
    <section class="lp-sez" id="dove-entri">
      <div class="lp-wrap">
        <span class="lp-eyebrow">Guarda dove entri</span>
        <h2 class="d">Questo è quello che apri</h2>
        <p class="lp-sub">
          Sei sale, un pass. Nei sette giorni non ci sono aree riservate a chi ha
          l'abbonamento: si apre tutto.
        </p>

        <figure class="lp-striscia">
          <Picture
            src={panoGymFloor}
            alt="La sala pesi di Lume Macerata vista dall'alto, con i soci che si allenano"
            widths={[900, 1600, 2400]}
            sizes="(min-width: 1100px) 1040px, 96vw"
            formats={['avif', 'webp']}
            loading="lazy"
          />
          <figcaption>
            <b>Sala pesi Technogym</b>
            <span>Macerata · cardio, isotonica, pesi liberi</span>
          </figcaption>
        </figure>

        <div class="lp-mosaico">
          {mosaico.map((m) => (
            <figure class="lp-tessera">
              <Picture
                src={m.foto}
                alt={m.tag}
                widths={[400, 800]}
                sizes="(min-width: 1000px) 33vw, 46vw"
                formats={['avif', 'webp']}
                loading="lazy"
              />
              <figcaption>
                <b>{m.tag}</b>
                <span>{m.nota}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    {/* ─── La banda dei numeri, su foto ──────────────────────────────────── */}
    <section class="lp-banda">
      <div class="lp-banda-sfondo" aria-hidden="true">
        <Picture
          src={walking}
          alt=""
          widths={[900, 1600]}
          sizes="100vw"
          formats={['avif', 'webp']}
          loading="lazy"
        />
      </div>
      <div class="lp-wrap lp-banda-in">
        <h2 class="d">Non devi scegliere cosa provare</h2>
        <div class="lp-banda-numeri">
          <div><b>{oreCorsi}</b><span>ore di corsi<br />a settimana</span></div>
          <div><b>{discipline.length}</b><span>discipline<br />in licenza</span></div>
          <div><b>2</b><span>centri<br />un solo pass</span></div>
          <div><b>7</b><span>giorni<br />consecutivi</span></div>
        </div>
      </div>
    </section>

    <section class="lp-sez lp-sez-scura" id="incluso">
      <div class="lp-wrap">
        <span class="lp-eyebrow">Cosa entra nei sette giorni</span>
        <h2 class="d">Tutto aperto. Niente escluso.</h2>

        <div class="lp-griglia">
          {incluso.map((i) => (
            <article class={i.foto ? 'lp-card lp-card-foto' : 'lp-card'}>
              {i.foto ? (
                <Picture
                  src={i.foto}
                  alt={i.titolo}
                  widths={[400, 800]}
                  sizes="(min-width: 700px) 45vw, 92vw"
                  formats={['avif', 'webp']}
                  loading="lazy"
                />
              ) : (
                /*
                  Ripiego, oggi non usato: tutte e quattro le schede hanno la
                  loro foto. Resta perché è la regola da seguire quando una
                  foto manca — un pannello che si vede per quello che è, non
                  lo scatto di un'altra sala con sopra l'etichetta giusta.
                */
                <div class="lp-card-grafica" aria-hidden="true">
                  <b>{i.titolo}</b>
                  <span>Lume</span>
                </div>
              )}
              <div class="lp-card-testo">
                <h3>{i.titolo}</h3>
                <p>{i.testo}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="lp-sez lp-sez-foto" id="lume">
      <div class="lp-wrap lp-due">
        <div>
          <span class="lp-eyebrow">Chi siamo</span>
          <h2 class="d">Benessere a 360°, detto senza retorica</h2>
          <p>
            Lume non è una sala pesi con qualche corso attorno. Sono due centri aperti nelle
            Marche — Macerata e Montecassiano — con {oreCorsi} ore di lezione a settimana,
            attrezzature Technogym, licenze Les Mills, una piscina, un Box CrossFit,
            una sala Reformer e una sala olistica.
          </p>
          <p>
            La differenza però non la fanno i metri quadri: la fa chi c'è dentro. Il primo
            ingresso lo fai con un tecnico che ti guarda muovere e ti imposta una scheda, e
            nelle sale trovi qualcuno che corregge, non solo qualcuno che apre il tornello.
            È la ragione per cui la media delle recensioni sta a 4.97.
          </p>
          <p class="lp-nota">
            Altri due centri, Piediripa e Urban, apriranno presto. Il pass prova vale sui
            due aperti.
          </p>
        </div>
        <div class="lp-foto-coppia">
          <Picture
            class="lp-foto-sinistra"
            src={interniMacerata}
            alt="Il corridoio delle sale di Lume Macerata"
            widths={[400, 800]}
            sizes="(min-width: 1000px) 22vw, 45vw"
            formats={['avif', 'webp']}
            loading="lazy"
          />
          <Picture
            src={pilates}
            alt="Un istruttore corregge la posizione durante un esercizio"
            widths={[400, 800]}
            sizes="(min-width: 1000px) 22vw, 45vw"
            formats={['avif', 'webp']}
            loading="lazy"
          />
        </div>
      </div>
    </section>

    <section class="lp-sez" id="come">
      <div class="lp-wrap">
        <span class="lp-eyebrow">Come funziona</span>
        <h2 class="d">Tre passaggi, nessuna sorpresa</h2>
        <ol class="lp-passi">
          {passi.map((p) => (
            <li>
              <b aria-hidden="true">{p.n}</b>
              <div>
                <h3>{p.titolo}</h3>
                <p>{p.testo}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {/* ─── I due centri, con la loro foto ────────────────────────────────── */}
    <section class="lp-sez lp-sez-scura" id="dove">
      <div class="lp-wrap">
        <span class="lp-eyebrow">Dove</span>
        <h2 class="d">Due centri, un pass</h2>
        <div class="lp-sedi">
          {centri.map((c, i) => (
            <article class="lp-sede">
              {c.data.immagine && (
                <Picture
                  src={c.data.immagine}
                  alt={c.data.nome}
                  widths={[500, 1000]}
                  sizes="(min-width: 700px) 45vw, 92vw"
                  formats={['avif', 'webp']}
                  loading="lazy"
                />
              )}
              <div class="lp-sede-testo">
                <h3>{c.data.nome}</h3>
                {c.data.indirizzo && <p>{c.data.indirizzo}</p>}
                {c.data.orari && (
                  <p class="lp-orari">
                    Lun–Ven {c.data.orari.feriali} · Sab {c.data.orari.sabato} · Dom{' '}
                    {c.data.orari.domenica}
                  </p>
                )}
                <p class="lp-sede-nota">
                  {i === 0 ? 'Qui c’è il Box CrossFit.' : 'Qui c’è la piscina.'}
                </p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="lp-sez lp-sez-regole" id="regole">
      <div class="lp-wrap lp-stretto">
        <span class="lp-eyebrow">Le regole, senza asterischi</span>
        <h2 class="d">Quello che c'è da sapere prima</h2>
        <p class="lp-sub">
          Preferiamo dirlo qui che in reception: se una di queste condizioni non torna, il
          pass non è la strada giusta, e te lo diciamo subito.
        </p>
        <ul class="lp-regole">
          <li>Riservato a chi non ha mai avuto un abbonamento o un pass Lume.</li>
          <li>Un solo pass per persona.</li>
          <li>Il codice va attivato entro 30 giorni dalla richiesta.</li>
          <li>Il primo ingresso si fa in reception con un documento.</li>
          <li>Sette giorni consecutivi dal primo ingresso, non sette ingressi sparsi.</li>
        </ul>
      </div>
    </section>

    <section class="lp-sez" id="domande">
      <div class="lp-wrap lp-stretto">
        <span class="lp-eyebrow">Domande</span>
        <h2 class="d">Prima che tu lo chieda</h2>
        <div class="lp-faq">
          {domande.map((q) => (
            <details>
              <summary>{q.d}</summary>
              <p>{q.r}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="lp-chiusura">
      <div class="lp-chiusura-sfondo" aria-hidden="true">
        <Picture
          src={functional}
          alt=""
          widths={[900, 1600]}
          sizes="100vw"
          formats={['avif', 'webp']}
          loading="lazy"
        />
      </div>
      <div class="lp-wrap lp-stretto lp-chiusura-in">
        <h2 class="d">Decidi dopo sette giorni. Non adesso.</h2>
        <p>
          Una visita non dice niente, un mese è un impegno. Sette giorni sono la misura
          giusta: entri, provi i corsi, sbagli qualche esercizio, ti fai correggere. Poi
          decidi — e se decidi che non è il posto giusto, hai speso quindici euro.
        </p>
        <a class="btn btn-red lp-cta-grande" href="#richiedi">Richiedi il pass · {PASS.pieno} €</a>
        <p class="lp-chiusura-tel">
          Preferisci parlare con qualcuno? <a href="tel:+390733232905">0733 232905</a>,
          Macerata e Montecassiano.
        </p>
      </div>
    </section>

    {/*
      Non è il footer del sito: nessuna navigazione, nessuna sitemap. È la riga
      legale minima, che serve comunque — le piattaforme pubblicitarie
      pretendono privacy e cookie raggiungibili dalla pagina su cui atterra
      l'annuncio, e un consenso cookie senza modo di cambiarlo non è consenso.
    */}
    <div class="lp-legale">
      <span>© {new Date().getFullYear()} Lume Fitness Club</span>
      <nav aria-label="Informative">
        <a href="/privacy"><span>Privacy</span></a>
        <a href="/cookie-policy"><span>Cookie</span></a>
        <a href="#" class="iubenda-cs-preferences-link"><span>Preferenze cookie</span></a>
      </nav>
    </div>

    {/*
      La barra compare quando il form dell'hero è uscito dallo schermo, e
      riporta lì. Senza JavaScript resta visibile: un pulsante in più in fondo
      non ha mai fatto danni, un pulsante che non c'è sì.
    */}
    <div class="lp-barra" data-lp-barra>
      <div>
        <b>{PASS.pieno} €</b>
        <span>7 giorni, tutto incluso</span>
      </div>
      <a class="btn btn-red" href="#richiedi">Richiedi il pass</a>
    </div>
  </main>
</Layout>

<style>
  /* L'invito non è un avviso di sistema: è un benvenuto. Barra rossa a
     sinistra come le citazioni editoriali del sito, non un riquadro d'errore. */
  .lp-invito {
    border-left: 3px solid var(--red);

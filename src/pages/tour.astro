---
/**
 * Pagina "Lasciaci i tuoi dati" — sostituisce `n8n.lumeflow.it/form/iscrizioni`.
 *
 * Nessun appuntamento: registra sede, dati, interessi e consensi. /api/lead salva il lead nel CRM e lancia
 * il flusso n8n di sempre (mail, recap, Spoki); poi /api/tour-dati chiede al CRM, da server a server, di
 * controllare PerfectGym, creare il lead se manca e lasciare la nota. Le chiavi di PerfectGym non toccano il sito.
 */
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const SEDI = [
  { id: 'macerata', nome: 'Macerata' },
  { id: 'montecassiano', nome: 'Montecassiano' },
  { id: 'urban', nome: 'Urban' },
  { id: 'piediripa', nome: 'Val di Chienti' },
];
const INTERESSI = [
  'Sala Pesi', 'Corsi Fitness', 'Pilates Reformer', 'Personal Training', 'CrossFit/Hyrox', 'Scuola Nuoto Adulti',
  'Acqua Fitness', 'Nuoto Libero', 'Acqua Mamma', 'Scuola Nuoto Bambini', 'Acqua Nido',
];
---

<Layout
  title="Scopri Lume — Lume Fitness Club"
  description="Lasciaci i tuoi dati e gli interessi: ti mandiamo informazioni, proposte e novità del centro Lume che preferisci. Un minuto, senza impegno."
>
  <Header />

  <main id="contenuto">
    <section class="sec">
      <div class="wrap">
        <div class="sec-head">
          <span class="label">Scopri Lume</span>
          <h1 class="d">Resta in <em>contatto</em></h1>
          <p>Dicci dove ti alleni e cosa ti interessa: ti mandiamo le informazioni sul centro, gli orari e le proposte giuste per te. Non si firma niente.</p>
        </div>

        <form class="tr" data-tour novalidate>
          <fieldset class="tr-dati" data-tour-dati>
            <div class="tr-gruppo" role="group" aria-label="Scegli la sede">
              <span class="label">Dove</span>
              <div class="tr-chips">
                {SEDI.map((s, i) => (
                  <button type="button" class="tr-chip" data-sede={s.id} aria-pressed={i === 0 ? 'true' : 'false'}>{s.nome}</button>
                ))}
              </div>
            </div>

            <div class="tr-griglia">
              <label class="tr-campo"><span>Nome</span><input name="nome" autocomplete="given-name" required /></label>
              <label class="tr-campo"><span>Cognome</span><input name="cognome" autocomplete="family-name" required /></label>
              <label class="tr-campo"><span>Email</span><input name="email" type="email" autocomplete="email" inputmode="email" required /></label>
              <label class="tr-campo"><span>Cellulare</span><input name="telefono" type="tel" autocomplete="tel" inputmode="tel" required /></label>
            </div>

            <div class="tr-gruppo" role="group" aria-label="A cosa sei interessato">
              <span class="label">Cosa ti interessa <small>(anche più di una)</small></span>
              <div class="tr-chips">
                {INTERESSI.map((i) => (
                  <button type="button" class="tr-chip" data-interesse={i} aria-pressed="false">{i}</button>
                ))}
              </div>
            </div>

            <label class="tr-campo"><span>Vuoi dirci qualcosa? <small>(facoltativo)</small></span><textarea name="note" rows="2" placeholder="Obiettivi, orari che preferisci…"></textarea></label>

            <label class="tr-privacy">
              <input type="checkbox" name="consenso" required />
              <span>Ho letto l’<a href="/privacy" target="_blank" rel="noopener">informativa privacy</a> e acconsento al trattamento dei miei dati per essere ricontattato.</span>
            </label>
            <label class="tr-privacy">
              <input type="checkbox" name="marketing" />
              <span>Voglio ricevere novità, promozioni ed eventi di Lume. <small>(facoltativo)</small></span>
            </label>

            {/* Trappola per i bot: un campo che una persona non vede e non compila. */}
            <input class="tr-esca" name="sito_web" tabindex="-1" autocomplete="off" aria-hidden="true" />

            <p class="tr-errore" data-tour-errore role="alert" hidden></p>
            <button type="submit" class="btn btn-red btn-full" data-tour-avanti>Invia</button>
          </fieldset>

          <div class="tr-grazie" data-tour-grazie hidden role="status">
            <h2>Ci siamo, grazie!</h2>
            <p data-tour-recap></p>
            <p>Ti scriviamo presto con le informazioni. Se vuoi, puoi anche <a data-tour-prenota href="/prenota">fissare una visita</a>.</p>
          </div>
        </form>

        <p class="tr-nota">Preferisci parlarne? Chiamaci allo <a href="tel:+390733232905">0733 232905</a>.</p>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .sec-head h1 em { color: var(--red-txt); font-style: normal; }
  .tr { max-width: 760px; }
  .tr-dati { border: 0; padding: 0; margin: 0; display: grid; gap: 22px; min-width: 0; }
  .tr-dati[hidden] { display: none; }
  .tr-gruppo .label { display: block; margin-bottom: 10px; }
  .tr-gruppo small, .tr-campo small, .tr-privacy small { color: var(--mut); font-weight: 400; text-transform: none; letter-spacing: 0; }
  .tr-chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .tr-chip {
    min-height: 44px; padding: 10px 16px; border: 1px solid var(--line); border-radius: var(--lf-r-s, 6px);
    background: transparent; color: #ddd; font-size: 14px; font-weight: 600; cursor: pointer;
    transition: border-color .2s ease, background .2s ease, color .2s ease;
  }
  .tr-chip:hover { border-color: #555; }
  .tr-chip[aria-pressed='true'] { background: var(--red); border-color: var(--red); color: #fff; }
  .tr-griglia { display: grid; gap: 14px; grid-template-columns: 1fr; }
  .tr-campo { display: grid; gap: 6px; font-size: 13px; color: var(--mut); }
  .tr-campo span { font-weight: 600; color: #cfcfcf; }
  .tr-campo input, .tr-campo textarea {
    width: 100%; min-height: 48px; padding: 12px 14px; border: 1px solid var(--line); border-radius: var(--lf-r-s, 6px);
    background: var(--card); color: #fff; font: inherit; font-size: 16px;
  }
  .tr-campo textarea { resize: vertical; }
  .tr-campo input:focus-visible, .tr-campo textarea:focus-visible { outline: 2px solid var(--red-txt); outline-offset: 1px; }
  .tr-privacy { display: grid; grid-template-columns: 22px 1fr; gap: 10px; font-size: 13px; color: #cfcfcf; align-items: start; }
  .tr-privacy input { width: 20px; height: 20px; margin-top: 2px; accent-color: var(--red); }
  .tr-privacy a { color: var(--red-txt); text-decoration: underline; }
  .tr-esca { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .tr-errore { margin: 0; font-size: 14px; color: var(--red-txt); }
  .tr-grazie { border: 1px solid var(--line); border-radius: var(--lf-r-m); background: var(--card); padding: 24px; }
  .tr-grazie h2 { font-family: 'Anton', sans-serif; font-weight: 400; text-transform: uppercase; font-size: 22px; letter-spacing: .03em; margin: 0 0 10px; }
  .tr-grazie p { font-size: 14px; color: #cfcfcf; margin: 0 0 8px; }
  .tr-grazie a { color: var(--red-txt); text-decoration: underline; }
  .tr-nota { margin-top: 28px; font-size: 14px; color: var(--mut); }
  .tr-nota a { color: var(--red-txt); text-decoration: underline; }
  @media (min-width: 640px) { .tr-griglia { grid-template-columns: 1fr 1fr; } }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-tour]');
  if (form) {
    const dati = form.querySelector<HTMLFieldSetElement>('[data-tour-dati]')!;
    const grazie = form.querySelector<HTMLElement>('[data-tour-grazie]')!;
    const errore = form.querySelector<HTMLElement>('[data-tour-errore]')!;
    const avanti = form.querySelector<HTMLButtonElement>('[data-tour-avanti]')!;
    const sedi = Array.from(form.querySelectorAll<HTMLButtonElement>('[data-sede]'));
    const interessi = Array.from(form.querySelectorAll<HTMLButtonElement>('[data-interesse]'));
    const w = window as any;

    // ?centro=montecassiano (come /prenota) o ?sede=… scelgono la sede di partenza
    const q = new URLSearchParams(location.search);
    const iniziale = (q.get('centro') || q.get('sede') || '').toLowerCase();
    const scegliSede = (id: string) => sedi.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.sede === id)));
    if (sedi.some((b) => b.dataset.sede === iniziale)) scegliSede(iniziale);
    sedi.forEach((b) => b.addEventListener('click', () => scegliSede(b.dataset.sede!)));
    interessi.forEach((b) => b.addEventListener('click', () => b.setAttribute('aria-pressed', String(b.getAttribute('aria-pressed') !== 'true'))));

    const campo = (n: string) => (form.elements.namedItem(n) as HTMLInputElement).value.trim();
    const spunta = (n: string) => !!(form.elements.namedItem(n) as HTMLInputElement).checked;
    const mostraErrore = (t: string) => { errore.textContent = t; errore.hidden = !t; };
    const post = (url: string, corpo: unknown) => fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(corpo) });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      mostraErrore('');
      if (campo('sito_web')) { dati.hidden = true; grazie.hidden = false; return; } // un bot: finto successo, nessun invio
      if (!form.reportValidity()) return;
      const chip = sedi.find((b) => b.getAttribute('aria-pressed') === 'true')!;
      const sede = chip.dataset.sede === 'piediripa' ? 'VALDICHIENTI' : chip.dataset.sede!.toUpperCase();
      const scelti = interessi.filter((b) => b.getAttribute('aria-pressed') === 'true').map((b) => b.dataset.interesse!);
      const email = campo('email');
      const note = campo('note');

      avanti.disabled = true;
      avanti.textContent = 'Invio…';
      // chi ha già un account lo sa il server: se è già iscritto va alla segreteria, come negli altri form
      let verifica = 'nuovo';
      try { verifica = (await (await post('/api/verifica', { email })).json()).stato || 'nuovo'; } catch { /* come per i nuovi */ }

      const corpo = {
        flusso: 'tour', tipoRichiesta: verifica === 'iscritto' ? 'ASSISTENZA' : 'TOUR', modalita: '', agenda: null,
        email, nome: campo('nome'), cognome: campo('cognome'), cellulare: campo('telefono'), prefisso: '',
        sede, centro: chip.dataset.sede, centroLabel: chip.textContent?.trim() || '',
        attivita: scelti, abbonamento: '', messaggio: [scelti.length ? 'Interessi: ' + scelti.join(', ') : '', note].filter(Boolean).join('. '),
        privacy: spunta('consenso'), marketing: spunta('marketing'),
        nuovo: verifica === 'nuovo' ? 'NUOVO' : 'ESISTE', verifica, gruppo: '', cta: '', ctaMedium: '', pagina: location.pathname,
        source: 'SitoWeb', medium: 'PaginaTour',
        utm: typeof w.lumeGetUtm === 'function' ? w.lumeGetUtm() : {}, vid: typeof w.lumeGetVid === 'function' ? w.lumeGetVid() : null,
        inviatoIl: new Date().toISOString(), sospetto: false,
      };
      try {
        const r = await post('/api/lead', corpo);
        if (!r.ok) throw new Error('lead ' + r.status);
      } catch {
        avanti.disabled = false;
        avanti.textContent = 'Invia';
        mostraErrore('Invio non riuscito. Riprova fra qualche istante o chiamaci allo 0733 232905.');
        return;
      }
      // da server a server: il CRM controlla PerfectGym, crea il lead se manca e scrive la nota. Se non riesce, il lead è già salvato.
      void post('/api/tour-dati', { email, sede, interessi: scelti, note, consenso: spunta('consenso') }).catch(() => {});
      w.lumeTrack?.('generate_lead', { lead_flusso: 'tour', lead_tipo: corpo.tipoRichiesta, lead_sede: sede, lead_pagina: '/tour', lead_medium: 'PaginaTour', lead_attivita: scelti.join(', ') });
      try { w.lumeSetEmail?.(email); } catch { /* il tracciamento non ferma la conferma */ }

      form.querySelector('[data-tour-recap]')!.textContent = [chip.textContent?.trim(), scelti.join(', '), email].filter(Boolean).join(' · ');
      form.querySelector('[data-tour-prenota]')?.setAttribute('href', '/prenota?centro=' + chip.dataset.sede);
      dati.hidden = true;
      grazie.hidden = false;
      grazie.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  }
</script>

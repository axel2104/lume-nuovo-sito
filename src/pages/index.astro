---
import { Picture, getImage } from 'astro:assets';
// La foto vera della sala pesi di Macerata, la stessa caricata nei contenuti.
import salaPesi from '../assets/centri/macerata-sala-pesi.jpg';
import reformerFoto from '../assets/pagine/reformer.jpg';
import functional from '../assets/pagine/functional.jpg';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BandaCta from '../components/BandaCta.astro';
import { getCollection } from 'astro:content';
import { formulaDi, euro } from '../data/abbonamenti';
import { conValori, righe } from '../lib/copy';
import { siteConfig } from '../config/site';
import { testiHome as testi } from '../data/testi';

const centri = (await getCollection('centri')).sort((a, b) => a.data.ordine - b.data.ordine);
const discipline = (await getCollection('discipline')).sort((a, b) => a.data.ordine - b.data.ordine);

/**
 * I centri che possono entrare nella galleria dell'hero: aperti e con una
 * foto. Piediripa e Urban non ce l'hanno ancora, e un riquadro vuoto in
 * apertura di homepage e' peggio di un riquadro in meno.
 */
const vetrinaCentri = await Promise.all(
  centri
    .filter((c) => c.data.stato === 'aperto' && c.data.immagine)
    .map(async (c) => ({
      nome: c.data.nome,
      foto: c.data.immagine!,
      video: c.data.video ?? '',
      // Fermo immagine scelto dal CMS (per Macerata è la foto vera della sala
      // pesi); senza, il video si apre sulla foto del centro già visibile.
      poster: c.data.videoPoster
        ? (await getImage({ src: c.data.videoPoster, width: 1280, format: 'webp' })).src
        : '',
    })),
);

/**
 * Le ore di corsi di tutto l'ecosistema, contate dal planning dei centri
 * invece che scritte a mano: un corso aggiunto o spostato aggiorna il numero
 * da se', e nessuno resta con una cifra vecchia in prima pagina.
 *
 * E' la settimana tipo, non un totale annuale. Piscina, scuola nuoto e sala
 * pesi non stanno nel planning dei corsi, quindi qui non sono contate: il
 * numero dice quante ore di lezione a calendario ci sono, ed e' verificabile.
 */
const minutiDi = (ora: string) => {
  const [h, m] = ora.split(':').map(Number);
  return (h || 0) * 60 + (m || 0);
};
const oreCorsi = Math.round(
  centri
    .flatMap((c) => c.data.planning ?? [])
    .reduce((tot, l) => tot + Math.max(0, minutiDi(l.fine) - minutiDi(l.inizio)), 0) / 60,
);

// In homepage una vetrina, non il catalogo: una disciplina per categoria, così
// si capisce l'ampiezza dell'offerta senza srotolare trenta card.
// Sei e non otto: la griglia è a tre colonne, sei riempiono due righe piene
// mentre otto lasciavano un'ultima riga spaiata da due tessere.
const vetrina = Object.values(
  discipline.reduce<Record<string, (typeof discipline)[number]>>((acc, d) => {
    acc[d.data.categoria] ??= d;
    return acc;
  }, {}),
).slice(0, 6);

// I piani non stanno più qui: erano tre oggetti cablati che nessuno fuori dal
// repo poteva cambiare, e che divergevano da /abbonamenti al primo ritocco.
const piani = (await getCollection('abbonamenti'))
  .filter((p) => p.data.pubblicato)
  .sort((a, b) => a.data.ordine - b.data.ordine);

/**
 * In home il prezzo mostrato è **il più basso del piano**, con la sua formula
 * accanto: è quello che permette di farsi un'idea in tre secondi. Il confronto
 * fra le formule vive su /abbonamenti, dove c'è il selettore.
 *
 * Il prezzo mensile non si confronta con l'annuale guardandolo — 90 € al mese
 * sembra meno di 675 € e sono 405 € in più — quindi accanto alla cifra ci va
 * sempre su cosa è calcolata.
 */
function prezzoVetrina(p: (typeof piani)[number]) {
  const rate = formulaDi(p, 'rate');
  const scelta = rate ?? p.data.formule[0];
  return {
    prezzo: scelta.prezzo,
    unita: scelta.periodo === 'mese' ? '/mese' : '/12 mesi',
    spiega: scelta.id === 'rate' ? 'in 12 rate senza interessi' : scelta.pagamento.toLowerCase(),
  };
}

/**
 * Quattro voci per scheda, scegliendo prima quelle che **distinguono** il piano.
 *
 * Prendendo semplicemente le prime quattro, le tre schede della home
 * mostravano quasi le stesse righe — «accesso senza limiti orari», «sala pesi
 * e cardio», «Technogym APP» le hanno tutti — e una fila di prezzi in cui i
 * piani sembrano identici non aiuta a scegliere: fa solo guardare la cifra.
 * Le voci comuni restano, ma dopo, a riempire.
 */
function assaggio(p: (typeof piani)[number]) {
  const comuni = new Set(
    piani[0].data.attivita.filter((v) => piani.every((q) => q.data.attivita.includes(v))),
  );
  const proprie = p.data.attivita.filter((v) => !comuni.has(v));
  return [...proprie, ...p.data.attivita.filter((v) => comuni.has(v))].slice(0, 4);
}
---

<Layout title={testi.seo.titolo} description={testi.seo.descrizione}>
  <Header />
  <main id="contenuto">

  <header class="hero">
    {/*
      L'hero occupa tutto il primo schermo: il video del centro (o la sua
      foto) e' lo sfondo a piena larghezza e il testo gli sta sopra, in basso
      a sinistra. Il gradiente di .hero-video::after e' tarato per tenere
      leggibile il titolo anche sui fotogrammi chiari del drone.
    */}
    <div class="hero-video" data-hero-galleria>
      {/*
        Le foto dei centri fanno da fondo e da fermo immagine: chi arriva
        vede dove metterà piede anche prima che parta il video, e le
        immagini sono ottimizzate da Astro, impilate nello stesso riquadro
        e scambiate in dissolvenza, quindi non c'è mai un salto di altezza
        mentre cambiano.
      */}
      {vetrinaCentri.map((c, i) => (
        <Picture
          class:list={['hero-slide', { 'is-attiva': i === 0 }]}
          src={c.foto}
          alt={c.nome}
          widths={[768, 1280, 1920]}
          sizes="100vw"
          formats={['avif', 'webp']}
          loading={i === 0 ? 'eager' : 'lazy'}
          data-hero-slide={c.nome}
          data-hero-video={c.video}
          data-hero-poster={c.poster}
        />
      ))}
      {/*
        Il video del centro visibile parte da sé, muto, sopra la sua foto.
        Un solo elemento per tutta la galleria e nessun `src` nel markup:
        lo mette il JavaScript e lo cambia a ogni centro, quindi scarica
        un video alla volta e solo quello che si sta guardando. Resta la
        foto, e nient'altro, per chi ha chiesto meno movimento, per chi
        naviga col risparmio dati e se l'autoplay viene negato.
      */}
      <video class="hero-clip" data-hero-clip muted playsinline preload="none" aria-hidden="true"></video>
      {/*
        La chip dice quale centro si sta guardando, e il testo lo cambia
        il JavaScript insieme alla foto. Senza JavaScript resta il nome
        del primo: incompleto sì, sbagliato mai.
      */}
      <div class="hero-chip">
        <b />
        <span data-hero-nome>{vetrinaCentri[0]?.nome ?? 'Lume Fitness Club'}</span>
      </div>
      <div class="hero-copy">
        <span class="label">{testi.hero.label}</span>
        <h1 class="d">
          {righe(testi.hero.titolo).map((r, i) => (
            <>
              {i > 0 && <br />}
              {r}
            </>
          ))}
          {/*
            L'evidenza sta sull'ultima riga per conto suo: «Un solo mondo,»
            e sotto «il tuo» in rosso. L'andata a capo è una scelta grafica,
            quindi vive qui e non in un campo del CMS.
          */}
          <br />
          <em>{testi.hero.evidenza}</em>
        </h1>
        <p>{testi.hero.testo}</p>
        {/*
          La CTA primaria della home è il pass prova, non gli abbonamenti: a
          chi arriva per la prima volta si chiede di provare, non di firmare.
          Il listino resta un ancoraggio più in basso, per chi ha già deciso.
        */}
        <div class="hero-cta">
          <button type="button" class="btn btn-red btn-full" data-open-form="prova" data-medium="HeroHome">
            {testi.hero.ctaProva}
          </button>
          <a href="/centri" class="btn btn-out btn-full">{testi.hero.ctaCentri}</a>
        </div>
      </div>
      <div class="hero-tools">
        {vetrinaCentri.length > 1 && (
          <div class="hero-punti" role="group" aria-label="Foto dei centri">
            {vetrinaCentri.map((c, i) => (
              <button
                type="button"
                data-hero-punto={i}
                aria-current={i === 0 ? 'true' : 'false'}
                aria-label={`Mostra ${c.nome}`}
              >
                <i />
              </button>
            ))}
          </div>
        )}
        {/*
          Il video con l'audio resta a richiesta, in un riquadro: quello sullo
          sfondo e' muto. Il pulsante apre il video drone del centro che si
          sta guardando, non un montaggio unico per tutti — il vecchio
          showreel (girato a Urban) non è più in pagina.
        */}
        <button type="button" class="hero-vcap" data-hero-showreel aria-haspopup="dialog">
          <svg class="ico-play" width="11" height="11" viewBox="0 0 12 12" aria-hidden="true" fill="currentColor">
            <path d="M2 1l9 5-9 5z" />
          </svg>
          Video del centro
        </button>
      </div>
    </div>
    {/*
      Un <dialog> nativo: focus intrappolato, chiusura con Esc, backdrop e
      `inert` sul resto della pagina in regalo dal browser. Sta fuori dal
      riquadro della galleria, che ha `overflow:hidden`.
    */}
    <dialog class="hero-reel" data-hero-reel aria-label="Video drone del centro">
      <button type="button" class="hero-reel-x" data-hero-reel-x aria-label="Chiudi il video">
        &times;
      </button>
      {/* Nessun `src` qui: lo mette il click sul pulsante, ed è quello del
          centro la cui foto è visibile in quel momento. */}
      <video
        data-hero-reel-video
        controls
        playsinline
        preload="none"
        poster="/media/hero-poster.jpg"
      />
    </dialog>
    <div class="wrap">
      <div class="stats">
        {testi.stats.map((s: any) => (
          <div class="stat">
            <b>
              {conValori(s.numero, { discipline: discipline.length, centri: centri.length, oreCorsi })}
              {s.suffisso && <em>{s.suffisso}</em>}
            </b>
            <span>{s.etichetta}</span>
          </div>
        ))}
      </div>
    </div>
  </header>

  <section class="sec band">
    <div class="wrap about">
      <div>
        <span class="label">{testi.chiSiamo.label}</span>
        <h2 class="d">
          {righe(testi.chiSiamo.titolo).map((r, i) => (
            <>
              {i > 0 && <br />}
              {r}
            </>
          ))}
        </h2>
        {testi.chiSiamo.paragrafi.map((par: any) => (
          <p>{par}</p>
        ))}
        <a href="/centri" class="btn btn-out" style="margin-top:12px">{testi.chiSiamo.cta}</a>
      </div>
      <div class="about-imgs">
        <Picture class="tall" src={salaPesi} alt="Sala pesi Lume" widths={[500, 1000]} sizes="(min-width:1024px) 40vw, 100vw" formats={['avif', 'webp']}
      />
        <Picture src={reformerFoto} alt="Reformer Pilates" widths={[300, 600]} sizes="20vw" style="height:180px" formats={['avif', 'webp']}
      />
        <Picture src={functional} alt="Area functional" widths={[300, 600]} sizes="20vw" style="height:180px" formats={['avif', 'webp']}
      />
      </div>
    </div>
  </section>

  <section class="sec" id="centri">
    <div class="wrap">
      <div class="sec-head">
        <span class="label">{testi.centri.label}</span>
        <h2 class="d">{testi.centri.titolo}</h2>
        <p>{testi.centri.testo}</p>
      </div>
      <div class="grid4">
        {centri.map((c) => (
          <a class={`centro ${c.data.stato === 'aperto' ? '' : 'soon'}`} href={`/centri/${c.id}`}>
            {/* Anche i centri in prevendita mostrano la loro immagine: quella
                di Urban è il render del progetto, ed è quello che c'è da far
                vedere finché il cantiere non diventa foto. Come in /centri. */}
            {c.data.immagine && (
              <Picture src={c.data.immagine} alt={c.data.nome} widths={[400, 800]} sizes="(min-width:1024px) 25vw, 100vw" formats={['avif', 'webp']}
            />
            )}
            <span class={`badge ${c.data.stato === 'aperto' ? 'open' : 'wait'}`}>
              {c.data.stato === 'aperto' ? 'Aperto' : 'Prossima apertura'}
            </span>
            <div class="centro-in">
              <h3>{c.data.nome.replace('Lume ', '')}</h3>
              <p>{c.data.servizi.slice(0, 4).join(' · ')}</p>
              <div class="lnk">{c.data.stato === 'aperto' ? 'Scopri →' : 'Iscriviti alla prevendita →'}</div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="sec band" id="discipline">
    <div class="wrap">
      <div class="sec-head">
        <span class="label">{testi.discipline.label}</span>
        <h2 class="d">{testi.discipline.titolo}</h2>
        <p>{conValori(testi.discipline.testo, { discipline: discipline.length })}</p>
      </div>
      <div class="grid3">
        {vetrina.map((d) => (
          <a class="card-d" href={`/discipline/${d.id}`} data-cat={d.data.categoria}>
            {d.data.immagine && (
              <Picture src={d.data.immagine} alt={d.data.nome} widths={[400, 800]} sizes="(min-width:1024px) 25vw, 100vw" formats={['avif', 'webp']}
            />
            )}
            <div class="card-d-in">
              <span>{d.data.categoria}</span>
              <h3>{d.data.nome}</h3>
            </div>
          </a>
        ))}
      </div>
      <div style="margin-top:26px">
        <a href="/discipline" class="btn btn-out">
          {conValori(testi.discipline.cta, { discipline: discipline.length })}
        </a>
      </div>
    </div>
  </section>

  {/*
    Il pass prova ha una sezione sua, prima del listino: è il passo più piccolo
    che possiamo chiedere a chi non ci conosce, e sul vecchio sito era la CTA più
    cliccata. Due porte diverse di proposito — il modal per chi ha già capito,
    la pagina per chi vuole leggere le condizioni prima di lasciare l'email.
  */}
  <section class="sec" id="prova">
    <div class="wrap">
      <BandaCta
        label={testi.bandaProva.label}
        titolo={testi.bandaProva.titolo}
        testo={testi.bandaProva.testo}
      >
        <button type="button" class="btn btn-red btn-full" data-open-form="prova" data-medium="BandHome">
          {testi.bandaProva.ctaForm}
        </button>
        <a href="/prova" class="btn btn-out btn-full">{testi.bandaProva.ctaPagina}</a>
      </BandaCta>
    </div>
  </section>

  <section class="sec" id="abbonamenti">
    <div class="wrap">
      <div class="sec-head center" style="margin-left:auto;margin-right:auto">
        <span class="label">{testi.abbonamenti.label}</span>
        <h2 class="d">{testi.abbonamenti.titolo}</h2>
        <p>{testi.abbonamenti.testo}</p>
      </div>
      <div class="plans">
        {piani.map((p) => {
          const v = prezzoVetrina(p);
          return (
            <article class={`plan ${p.data.consigliato ? 'hot' : ''}`}>
              {p.data.consigliato && <span class="plan-tag">Il più scelto</span>}
              <div class="plan-testa">
                <h3 class="pn">{p.data.nome}</h3>
                <p class="plan-per">{p.data.per}</p>
              </div>
              <div class="plan-prezzo">
                <div class="pr">{euro(v.prezzo)}&nbsp;€<small>{v.unita}</small></div>
                <p class="plan-nota">{v.spiega}</p>
              </div>
              <div class="plan-voci">
                <ul>{assaggio(p).map((voce) => <li>{voce}</li>)}</ul>
              </div>
              <a href="/abbonamenti" class={`btn ${p.data.consigliato ? 'btn-red' : 'btn-out'} btn-full`}>
                Vedi il piano {p.data.nome}
              </a>
            </article>
          );
        })}
      </div>
      <p class="pg-note">
        {testi.abbonamenti.nota}{' '}
        <a href="/abbonamenti" style="color:var(--red-txt);text-decoration:underline">
          {testi.abbonamenti.notaLink}
        </a>.
      </p>
    </div>
  </section>

  <section class="sec" id="prevendita" style="padding-top:0">
    <div class="wrap">
      <div class="promo">
        <div>
          <span class="label" style="color:#fff">{testi.prevendita.label}</span>
          <h2 class="d" style="margin-top:12px">{testi.prevendita.titolo}</h2>
          <p>{testi.prevendita.testo}</p>
        </div>
        {/*
          Porta alla landing della prevendita, che ha un funnel suo con
          contratto e pagamento: i form di questo sito non c'entrano, e il
          campo SEDE di RICHIESTE non conosce nemmeno Piediripa e Urban.
        */}
        <a
          href={siteConfig.prevenditaUrl}
          class="btn btn-cream btn-full"
          style="max-width:340px"
          target="_blank"
          rel="noopener"
        >
          {testi.prevendita.cta} ↗
        </a>
      </div>
    </div>
  </section>

  <section class="sec band" id="wiki">
    <div class="wrap wiki">
      <div>
        <span class="label">{testi.wiki.label}</span>
        <h2 class="d">{testi.wiki.titolo}</h2>
        <p>{testi.wiki.testo}</p>
        {/* La wiki vera è fase 2 (Starlight su /wiki): per ora l'help desk è
            la cosa più vicina che esiste davvero, meglio di un link morto. */}
        <a href="/lume-life#help" class="btn btn-out">{testi.wiki.cta}</a>
      </div>
      <div class="wiki-vis">
        <div class="q">🔍 Cerca nella wiki…</div>
        <div class="row">Come prenoto un corso <span>→</span></div>
        <div class="row">Orari e chiusure <span>→</span></div>
        <div class="row">Regolamento piscina <span>→</span></div>
        <div class="row">Congelare l’abbonamento <span>→</span></div>
      </div>
    </div>
  </section>

  </main>
  <Footer />
</Layout>

<script>
  /* ─── Galleria dell'hero ───────────────────────────────
     Il video del centro visibile parte da sé sopra la sua foto, e quando
     finisce passa al centro dopo: la durata del filmato è il tempo della
     slide. Senza video (o se l'autoplay viene negato) le foto si alternano a
     tempo come prima. Chi ha chiesto meno movimento vede la prima foto e
     cambia dai pallini, e chi naviga col risparmio dati o in 3G non scarica
     nessun video. Tutto si ferma quando la scheda passa in secondo piano —
     banda e CPU spese per nessuno — e quando qualcuno sceglie a mano. */
  const galleria = document.querySelector('[data-hero-galleria]');

  if (galleria) {
    const slide = Array.from(galleria.querySelectorAll('[data-hero-slide]'));
    const punti = Array.from(galleria.querySelectorAll('[data-hero-punto]'));
    const nome = galleria.querySelector('[data-hero-nome]');
    const clip = galleria.querySelector('[data-hero-clip]');

    let ridotto = false;
    try {
      ridotto = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    } catch (e) {}

    /* Il risparmio dati è una richiesta esplicita, la rete lenta un fatto
       misurato: in entrambi i casi tre megabyte di drone non si spediscono. */
    let magra = false;
    try {
      const rete = (navigator as any).connection;
      magra = Boolean(rete && (rete.saveData || /^(slow-2g|2g|3g)$/.test(rete.effectiveType || '')));
    } catch (e) {}

    const conVideo = clip instanceof HTMLVideoElement && !ridotto && !magra;

    let attiva = 0;
    let giro = 0;

    const ferma = () => {
      if (!giro) return;
      window.clearTimeout(giro);
      giro = 0;
    };

    /* Il video della slide visibile, e nient'altro: il precedente viene
       staccato prima, così il browser non tiene in memoria filmati che
       nessuno sta guardando. Se l'autoplay viene negato la foto resta al suo
       posto e il giro riparte a tempo: nessun riquadro fermo. */
    const suona = () => {
      if (!(clip instanceof HTMLVideoElement) || !conVideo) return;
      const src = slide[attiva].getAttribute('data-hero-video');
      clip.classList.remove('pronto');
      if (!src) {
        clip.removeAttribute('src');
        clip.load();
        aTempo();
        return;
      }
      if (clip.getAttribute('src') !== src) clip.setAttribute('src', src);
      const avvio = clip.play();
      if (avvio && avvio.catch) avvio.catch(() => aTempo());
    };

    const mostra = (n: number) => {
      attiva = (n + slide.length) % slide.length;
      slide.forEach((s, i) => s.classList.toggle('is-attiva', i === attiva));
      punti.forEach((p, i) => p.setAttribute('aria-current', i === attiva ? 'true' : 'false'));
      const etichetta = slide[attiva].getAttribute('data-hero-slide');
      if (nome && etichetta) nome.textContent = etichetta;
      suona();
    };

    /* Il ripiego a tempo: un solo passo alla volta, non un intervallo, così
       basta non riarmarlo per fermare il giro. */
    const aTempo = () => {
      if (giro || ridotto || slide.length < 2) return;
      giro = window.setTimeout(() => {
        giro = 0;
        mostra(attiva + 1);
      }, 5200);
    };

    const avvia = () => {
      if (conVideo) suona();
      else aTempo();
    };

    if (clip instanceof HTMLVideoElement && conVideo) {
      clip.addEventListener('canplay', () => clip.classList.add('pronto'));
      clip.addEventListener('ended', () => mostra(attiva + 1));
      /* Video mancante o rotto: si torna alle foto a tempo, non si resta
         appesi su una slide che aspetta un `ended` che non arriverà. */
      clip.addEventListener('error', () => {
        clip.classList.remove('pronto');
        aTempo();
      });
    }

    punti.forEach((p, i) =>
      p.addEventListener('click', () => {
        ferma();
        mostra(i);
      }),
    );

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        ferma();
        if (clip instanceof HTMLVideoElement) clip.pause();
      } else {
        avvia();
      }
    });
    avvia();
  }

  /* ─── Video del centro a richiesta ─────────────────────
     Il `src` non esiste nel markup: lo mette il click, ed è quello del centro
     la cui foto è visibile in quel momento (data-hero-video sulla slide).
     Chi cambia foto coi pallini e poi apre il video sente parlare del centro
     che sta guardando, non di un altro. */
  const reel = document.querySelector('[data-hero-reel]');
  const reelVideo = document.querySelector('[data-hero-reel-video]');
  const apriReel = document.querySelector('[data-hero-showreel]');

  if (reel instanceof HTMLDialogElement && reelVideo instanceof HTMLVideoElement && apriReel) {
    const chiudi = () => {
      reelVideo.pause();
      if (reel.open) reel.close();
    };

    apriReel.addEventListener('click', () => {
      const corrente = document.querySelector('.hero-slide.is-attiva');
      const src = corrente ? corrente.getAttribute('data-hero-video') : '';
      if (src && reelVideo.getAttribute('src') !== src) reelVideo.setAttribute('src', src);
      // Il poster è il fermo immagine scelto dal CMS; se manca, la foto che
      // si sta già guardando: in entrambi i casi niente stacco visivo.
      const posterCustom = corrente ? corrente.getAttribute('data-hero-poster') : '';
      if (posterCustom) {
        reelVideo.setAttribute('poster', posterCustom);
      } else if (corrente instanceof HTMLImageElement && corrente.currentSrc) {
        reelVideo.setAttribute('poster', corrente.currentSrc);
      }
      const nomeCentro = corrente ? corrente.getAttribute('data-hero-slide') : '';
      if (nomeCentro) reel.setAttribute('aria-label', `Video drone — ${nomeCentro}`);
      reel.showModal();
      // Il clip muto dell'hero si mette in pausa: due copie dello stesso
      // filmato in corsa sarebbero banda buttata, e una si sente.
      const muto = document.querySelector('[data-hero-clip]');
      if (muto instanceof HTMLVideoElement) muto.pause();
      const avvio = reelVideo.play();
      if (avvio && typeof avvio.catch === 'function') avvio.catch(() => {});
    });

    const chiusura = reel.querySelector('[data-hero-reel-x]');
    if (chiusura) chiusura.addEventListener('click', chiudi);

    // Il target è il <dialog> stesso solo quando si clicca il backdrop.
    reel.addEventListener('click', (e) => {
      if (e.target === reel) chiudi();
    });
    reel.addEventListener('close', () => {
      reelVideo.pause();
      // E l'hero riprende da dove l'aveva lasciato.
      const muto = document.querySelector('[data-hero-clip]');
      if (muto instanceof HTMLVideoElement && muto.getAttribute('src')) {
        const ripresa = muto.play();
        if (ripresa && typeof ripresa.catch === 'function') ripresa.catch(() => {});
      }
    });
  }
</script>


---
import { Picture } from 'astro:assets';
import salaPesi from '../assets/pagine/sala-pesi.jpg';
import reformerFoto from '../assets/pagine/reformer.jpg';
import functional from '../assets/pagine/functional.jpg';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';
import { vociAbbonamento } from '../data/tassonomie';

const centri = (await getCollection('centri')).sort((a, b) => a.data.ordine - b.data.ordine);
const discipline = (await getCollection('discipline')).sort((a, b) => a.data.ordine - b.data.ordine);

// In homepage una vetrina, non il catalogo: una disciplina per categoria, così
// si capisce l'ampiezza dell'offerta senza srotolare trenta card.
const vetrina = Object.values(
  discipline.reduce<Record<string, (typeof discipline)[number]>>((acc, d) => {
    acc[d.data.categoria] ??= d;
    return acc;
  }, {}),
).slice(0, 8);

// I piani non stanno più qui: erano tre oggetti cablati che nessuno fuori dal
// repo poteva cambiare, e che divergevano da /abbonamenti al primo ritocco.
const piani = (await getCollection('abbonamenti'))
  .filter((p) => p.data.pubblicato)
  .sort((a, b) => a.data.ordine - b.data.ordine);

/** In home solo le prime voci: il confronto completo vive su /abbonamenti. */
function assaggio(p: (typeof piani)[number]) {
  const voci = (p.data.voci ?? {}) as Record<string, boolean | string>;
  return vociAbbonamento
    .filter((v) => voci[v.id] !== undefined)
    .slice(0, 4)
    .map((v) => (typeof voci[v.id] === 'string' ? `${v.label}: ${String(voci[v.id]).toLowerCase()}` : v.label));
}
---

<Layout>
  <Header />
  <main id="contenuto">

  <header class="hero">
    <div class="wrap">
      <div class="hero-grid">
        <div class="hero-video">
          <video
            data-hero-video
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            poster="/media/hero-poster.jpg"
          >
            <source src="/media/lume-hero.mp4" type="video/mp4" />
          </video>
          <div class="hero-chip"><b></b>Lume Fitness Club</div>
          <!--
            Il video è un loop in autoplay da 2,3 MB: serve un comando per
            fermarlo. Era un <div> decorativo con il glifo ▶ come icona.
          -->
          <button type="button" class="hero-vcap" data-hero-toggle aria-label="Metti in pausa il video">
            <svg class="ico-pausa" width="11" height="11" viewBox="0 0 12 12" aria-hidden="true" fill="currentColor">
              <rect x="1" y="1" width="3.5" height="10" rx="1" /><rect x="7.5" y="1" width="3.5" height="10" rx="1" />
            </svg>
            <svg class="ico-play" width="11" height="11" viewBox="0 0 12 12" aria-hidden="true" fill="currentColor">
              <path d="M2 1l9 5-9 5z" />
            </svg>
            Showreel
          </button>
        </div>
        <div class="hero-copy">
          <span class="label">Benessere a 360°</span>
          <h1 class="d">Illumina<br />la tua <em>forza</em></h1>
          <p>Quattro centri nelle Marche. Attrezzature d’élite, discipline per ogni obiettivo e uno staff che ti segue passo dopo passo.</p>
          <div class="hero-cta">
            <a href="/abbonamenti" class="btn btn-red btn-full">Inizia ora</a>
            <a href="/centri" class="btn btn-out btn-full">Scopri i centri</a>
          </div>
        </div>
      </div>
      <div class="stats">
        <div class="stat"><b>4</b><span>Centri</span></div>
        <div class="stat"><b>600<em>+</em></b><span>Iscritti</span></div>
        <div class="stat"><b>4.97</b><span>Recensioni</span></div>
        <div class="stat"><b>{discipline.length}<em>+</em></b><span>Discipline</span></div>
      </div>
    </div>
  </header>

  <section class="sec band">
    <div class="wrap about">
      <div>
        <span class="label">Chi siamo</span>
        <h2 class="d">Più di una palestra.<br />Un modo di stare bene.</h2>
        <p>Lume Fitness Club nasce per rendere l’allenamento un’esperienza completa: corpo, mente ed energia. Sale ampie e luminose, tecnologia Technogym, corsi in licenza Les Mills, piscina e Reformer Pilates.</p>
        <p>Ogni centro ha la sua identità, ma un unico standard: qualità, cura e risultati concreti.</p>
        <a href="/centri" class="btn btn-out" style="margin-top:12px">I nostri centri</a>
      </div>
      <div class="about-imgs">
        <Picture class="tall" src={salaPesi} alt="Sala pesi Lume" widths={[500, 1000]} sizes="(min-width:1024px) 40vw, 100vw" formats={['avif', 'webp']}
      />
        <Picture src={reformerFoto} alt="Reformer Pilates" widths={[300, 600]} sizes="20vw" style="height:180px" formats={['avif', 'webp']}
      />
        <Picture src={functional} alt="Area functional" widths={[300, 600]} sizes="20vw" style="height:180px" formats={['avif', 'webp']}
      />
      </div>
    </div>
  </section>

  <section class="sec" id="centri">
    <div class="wrap">
      <div class="sec-head">
        <span class="label">I centri</span>
        <h2 class="d">Quattro case, una sola energia</h2>
        <p>Trova il centro Lume più vicino a te. Ognuno con le sue sale, i suoi corsi e il suo carattere.</p>
      </div>
      <div class="grid4">
        {centri.map((c) => (
          <a class={`centro ${c.data.stato === 'aperto' ? '' : 'soon'}`} href={`/centri/${c.id}`}>
            {c.data.stato === 'aperto' && c.data.immagine && (
              <Picture src={c.data.immagine} alt={c.data.nome} widths={[400, 800]} sizes="(min-width:1024px) 25vw, 100vw" formats={['avif', 'webp']}
            />
            )}
            <span class={`badge ${c.data.stato === 'aperto' ? 'open' : 'wait'}`}>
              {c.data.stato === 'aperto' ? 'Aperto' : 'Prossima apertura'}
            </span>
            <div class="centro-in">
              <h3>{c.data.nome.replace('Lume ', '')}</h3>
              <p>{c.data.servizi.slice(0, 4).join(' · ')}</p>
              <div class="lnk">{c.data.stato === 'aperto' ? 'Scopri →' : 'Iscriviti alla prevendita →'}</div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="sec band" id="discipline">
    <div class="wrap">
      <div class="sec-head">
        <span class="label">Discipline</span>
        <h2 class="d">Allenati come vuoi</h2>
        <p>Dalla forza al benessere in acqua: {discipline.length} attività fra corsi di gruppo, funzionale, mente e corpo, Reformer e piscina.</p>
      </div>
      <div class="grid3">
        {vetrina.map((d) => (
          <a class="card-d" href={`/discipline/${d.id}`} data-cat={d.data.categoria}>
            {d.data.immagine && (
              <Picture src={d.data.immagine} alt={d.data.nome} widths={[400, 800]} sizes="(min-width:1024px) 25vw, 100vw" formats={['avif', 'webp']}
            />
            )}
            <div class="card-d-in">
              <span>{d.data.categoria}</span>
              <h3>{d.data.nome}</h3>
            </div>
          </a>
        ))}
      </div>
      <div style="margin-top:26px">
        <a href="/discipline" class="btn btn-out">Tutte le {discipline.length} discipline</a>
      </div>
    </div>
  </section>

  <section class="sec" id="abbonamenti">
    <div class="wrap">
      <div class="sec-head center" style="margin-left:auto;margin-right:auto">
        <span class="label">Abbonamenti</span>
        <h2 class="d">Scegli il tuo piano</h2>
        <p>Attivazione rapida e gestione diretta dal portale PerfectGym.</p>
      </div>
      <div class="plans">
        {piani.map((p) => (
          <article class={`plan ${p.data.consigliato ? 'hot' : ''}`}>
            {p.data.consigliato && <span class="plan-tag">Il più scelto</span>}
            <div class="plan-testa">
              <h3 class="pn">{p.data.nome}</h3>
              <p class="plan-per">{p.data.per}</p>
            </div>
            <div class="plan-prezzo">
              <div class="pr">{p.data.mensile}&nbsp;€<small>/mese</small></div>
            </div>
            <div class="plan-voci">
              <ul>{assaggio(p).map((v) => <li>{v}</li>)}</ul>
            </div>
            <a href="/abbonamenti" class={`btn ${p.data.consigliato ? 'btn-red' : 'btn-out'} btn-full`}>
              Vedi il piano {p.data.nome}
            </a>
          </article>
        ))}
      </div>
      <p class="pg-note">
        Mensile o annuale, prevendita dei nuovi centri e domande frequenti:
        <a href="/abbonamenti" style="color:var(--red-txt);text-decoration:underline">tutti i dettagli sugli abbonamenti</a>.
      </p>
    </div>
  </section>

  <section class="sec" id="prevendita" style="padding-top:0">
    <div class="wrap">
      <div class="promo">
        <div>
          <span class="label" style="color:#fff">Prevendita attiva</span>
          <h2 class="d" style="margin-top:12px">I nuovi centri stanno arrivando</h2>
          <p>Blocca la tariffa lancio per Piediripa e Urban. Posti limitati.</p>
        </div>
        <a href="#" class="btn btn-cream btn-full" style="max-width:340px">Accedi alla prevendita</a>
      </div>
    </div>
  </section>

  <section class="sec band" id="wiki">
    <div class="wrap wiki">
      <div>
        <span class="label">Wiki Lume</span>
        <h2 class="d">Tutte le risposte, in un posto</h2>
        <p>Orari, regolamenti, guide agli allenamenti e domande frequenti. La knowledge base di Lume, sempre aggiornata.</p>
        <a href="#" class="btn btn-out">Apri la Wiki</a>
      </div>
      <div class="wiki-vis">
        <div class="q">🔍 Cerca nella wiki…</div>
        <div class="row">Come prenoto un corso <span>→</span></div>
        <div class="row">Orari e chiusure <span>→</span></div>
        <div class="row">Regolamento piscina <span>→</span></div>
        <div class="row">Congelare l’abbonamento <span>→</span></div>
      </div>
    </div>
  </section>

  </main>
  <Footer />
</Layout>

<script>
  // Il loop in autoplay non deve partire per chi ha chiesto meno movimento.
  const video = document.querySelector('[data-hero-video]');
  const toggle = document.querySelector('[data-hero-toggle]');

  if (video instanceof HTMLVideoElement && toggle) {
    const mostraStato = () => {
      const inPausa = video.paused;
      toggle.classList.toggle('is-in-pausa', inPausa);
      toggle.setAttribute('aria-label', inPausa ? 'Riproduci il video' : 'Metti in pausa il video');
    };

    let ridotto = false;
    try {
      ridotto = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    } catch (e) {}
    if (ridotto) {
      video.removeAttribute('autoplay');
      video.pause();
    }

    toggle.addEventListener('click', () => {
      if (video.paused) video.play();
      else video.pause();
    });
    video.addEventListener('play', mostraStato);
    video.addEventListener('pause', mostraStato);
    mostraStato();
  }
</script>


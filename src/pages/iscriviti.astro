---
/**
 * Landing della richiesta di iscrizione — destinazione del redirect da
 * `n8n.lumeflow.it/form/iscrizioni`.
 *
 * Non è un checkout e non lo diventa: pagamento e contratto restano su
 * PerfectGym. Questa pagina serve a far parlare con un consulente chi non è
 * ancora pronto a inserire un IBAN — cioè la maggioranza di chi arriva qui.
 */
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormInline from '../components/forms/FormInline.astro';

const passaggi = [
  { n: '1', titolo: 'Ci dici cosa cerchi', testo: 'Centro, attività di interesse e la formula che ti sembra più adatta.' },
  { n: '2', titolo: 'Ti chiama un consulente', testo: 'Entro un giorno lavorativo, dal centro che hai scelto.' },
  { n: '3', titolo: 'Provi e decidi', testo: 'Vedi le sale, capisci gli orari, e solo dopo scegli il piano.' },
];
---

<Layout
  title="Iscriviti a Lume — Lume Fitness Club"
  description="Richiedi la proposta di abbonamento per il centro Lume che preferisci. Un consulente ti contatta entro un giorno lavorativo."
>
  <Header />

  <main>
    <section class="sec">
      <div class="wrap">
        <div class="isc-grid">
          <div>
            <span class="label">Iscrizioni</span>
            <h1 class="d">Parliamone prima<br />di firmare</h1>
            <p class="isc-lead">
              Non ti chiediamo una carta di credito per iniziare. Ci dici cosa cerchi, ti proponiamo
              la formula giusta, e la scelta la fai dopo aver visto il centro.
            </p>

            <div class="isc-passaggi">
              {
                passaggi.map((p) => (
                  <div class="isc-passo">
                    <b>{p.n}</b>
                    <div>
                      <h3>{p.titolo}</h3>
                      <p>{p.testo}</p>
                    </div>
                  </div>
                ))
              }
            </div>

            <p class="isc-nota">
              Sai già cosa vuoi? Puoi anche
              <a href="/#abbonamenti">vedere i piani</a> e attivare l’abbonamento in autonomia dal
              portale PerfectGym.
            </p>
          </div>

          <div class="isc-form">
            <FormInline flusso="iscrizione" medium="PaginaIscriviti" />
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .isc-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    align-items: start;
  }
  .isc-lead {
    max-width: 50ch;
    margin-bottom: 32px;
  }
  .isc-passaggi {
    display: grid;
    gap: 20px;
    margin-bottom: 30px;
  }
  .isc-passo {
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 16px;
    align-items: start;
  }
  .isc-passo b {
    font-family: 'Anton', sans-serif;
    font-weight: 400;
    font-size: 20px;
    width: 42px;
    height: 42px;
    border-radius: var(--lf-r-s);
    border: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--red);
  }
  .isc-passo h3 {
    font-family: 'Anton', sans-serif;
    font-weight: 400;
    text-transform: uppercase;
    font-size: 16px;
    letter-spacing: 0.03em;
    margin: 10px 0 5px;
  }
  .isc-passo p {
    font-size: 14px;
    color: var(--mut);
    margin: 0;
  }
  .isc-nota {
    font-size: 13px;
    color: var(--mut);
    border-top: 1px solid var(--line);
    padding-top: 20px;
  }
  .isc-nota a {
    color: var(--red);
    text-decoration: underline;
  }

  @media (min-width: 1024px) {
    .isc-grid {
      grid-template-columns: 1fr 0.85fr;
      gap: 48px;
    }
    .isc-form {
      position: sticky;
      top: 96px;
    }
  }
</style>

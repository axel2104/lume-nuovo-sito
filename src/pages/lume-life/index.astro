---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SezioneEventi from '../../components/editoriale/SezioneEventi.astro';
import SezioneNews from '../../components/editoriale/SezioneNews.astro';
import SezioneHelpdesk from '../../components/editoriale/SezioneHelpdesk.astro';
import SezioneServizi from '../../components/editoriale/SezioneServizi.astro';
import Newsletter from '../../components/forms/Newsletter.astro';
---

<Layout
  title="Lume Life — eventi, news e servizi | Lume Fitness Club"
  description="La vita dei centri Lume: prossimi eventi, novità dai club, servizi e risposte alle domande più frequenti."
>
  <Header />

  <main id="contenuto">
    <section class="sec">
      <div class="wrap">
        <div class="sec-head">
          <span class="label">Lume Life</span>
          <h2 class="d">Il club non è solo allenarsi</h2>
          <p>
            Eventi, novità dai centri, servizi e risposte pratiche. Tutto quello che succede attorno
            alla sala, in un posto solo.
          </p>
        </div>

        <nav class="ll-nav" aria-label="Sezioni di Lume Life">
          <a href="#eventi">Eventi</a>
          <a href="#news">News</a>
          <a href="#servizi">Servizi</a>
          <a href="#help">Help desk</a>
        </nav>
      </div>
    </section>

    <SezioneEventi />
    <SezioneNews />
    <SezioneServizi />
    <SezioneHelpdesk />

    <section class="sec">
      <div class="wrap">
        {/* La newsletter sta qui e non nel footer: questo è l'unico posto del
            sito dove chi legge ha appena dimostrato interesse per i contenuti.
            Nel footer sarebbe JavaScript su ogni pagina per pochissime
            iscrizioni. */}
        <Newsletter
          titolo="Ti teniamo aggiornato"
          testo="Eventi, novità dai centri e promozioni. Una email al mese, niente di più."
          medium="LumeLifeNewsletter"
        />
      </div>
    </section>

    <section class="sec">
      <div class="wrap">
        <div class="promo">
          <div>
            <h2 class="d">Non trovi quello che cerchi?</h2>
            <p>Scrivici o fatti richiamare: rispondiamo a tutti, davvero.</p>
          </div>
          <button type="button" class="btn btn-cream" data-open-form="info" data-medium="LumeLife">
            Contattaci
          </button>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

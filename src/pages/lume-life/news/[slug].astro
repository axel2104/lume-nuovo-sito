---
import { Picture } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Newsletter from '../../../components/forms/Newsletter.astro';
import { categorieNews, etichetta } from '../../../data/tassonomie';
import { dataEstesa } from '../../../lib/richtext';

export async function getStaticPaths() {
  const news = await getCollection('news', ({ data }) => data.pubblicato);
  return news.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
// I campi vivono sotto `.data`: leggerli da `entry` darebbe undefined, e i meta
// SEO resterebbero vuoti senza che nessuno se ne accorga.
const d = entry.data;
const { Content } = await render(entry);

const correlate = (await getCollection('news', ({ data }) => data.pubblicato))
  .filter((n) => n.id !== entry.id)
  .sort((a, b) => b.data.data.getTime() - a.data.data.getTime())
  .slice(0, 3);
---

<Layout title={`${d.titolo} — LUMe Fitness Club`} description={d.sintesi} image={d.immagine}>
  <Header />

  <main id="contenuto">
    <article class="sec">
      <div class="wrap">
        <a class="ed-back" href="/lume-life#news">← Tutte le news</a>

        <header class="art-head">
          <span class="ed-meta">
            {etichetta(categorieNews, d.categoria)} · {dataEstesa(d.data)}
            {d.autore && ` · ${d.autore}`}
          </span>
          <h1 class="d">{d.titolo}</h1>
          <p class="art-sub">{d.sintesi}</p>
        </header>

        <Picture
          class="art-img"
          src={d.immagine}
          alt={d.immagineAlt}
          widths={[800, 1200, 1800]}
          sizes="(min-width:1024px) 1000px, 100vw"
          loading="eager"
          formats={['avif', 'webp']}
        />

        <div class="art-body">
          <Content />
        </div>

        {
          d.ctaLabel && d.ctaHref && (
            <a class="btn btn-red art-cta" href={d.ctaHref}>
              {d.ctaLabel}
            </a>
          )
        }
      </div>

      {/* Chi arriva in fondo a un articolo è il lettore più qualificato che
          abbiamo: è qui che l'iscrizione ha senso chiederla. */}
      <div class="art-nl">
        <Newsletter medium={`NewsArticolo:${entry.id}`} />
      </div>
    </article>

    {
      correlate.length > 0 && (
        <section class="sec band">
          <div class="wrap">
            <div class="sec-head">
              <span class="label">Continua</span>
              <h2 class="d">Altre news</h2>
            </div>
            <div class="ed-grid">
              {correlate.map((n) => (
                <a class="ed-card" href={`/lume-life/news/${n.id}`}>
                  <div class="ed-thumb">
                    <Picture
                      src={n.data.immagine}
                      alt={n.data.immagineAlt}
                      widths={[400, 800]}
                      sizes="(min-width:1024px) 33vw, 100vw"
                      loading="lazy"
                      formats={['avif', 'webp']}
                    />
                  </div>
                  <div class="ed-body">
                    <span class="ed-meta">{dataEstesa(n.data.data)}</span>
                    <h3>{n.data.titolo}</h3>
                    <p>{n.data.sintesi}</p>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </section>
      )
    }
  </main>

  <Footer />
</Layout>

<style>
  .art-nl {
    max-width: 1000px;
    margin: 44px auto 0;
  }
</style>

---
import { Picture } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BandaCta from '../../components/BandaCta.astro';
import { getCollection, render } from 'astro:content';
import { SEDI } from '../../config/forms';
import { siteConfig } from '../../config/site';

export async function getStaticPaths() {
  const centri = await getCollection('centri');
  return centri.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const c = entry.data;
const { Content } = await render(entry);
const aperto = c.stato === 'aperto';

/**
 * I form raccolgono lead solo per i centri che il campo SEDE di Airtable
 * conosce. Un centro aperto ma assente da quella lista mostrerebbe form che
 * generano record scartati, quindi qui torna ai contatti generici.
 */
const raccogliLead = aperto && Boolean(SEDI[entry.id]);

/** `perfectgymUrl` ha default '#': un link a '#' è peggio di nessun link. */
const portaleAttivo = Boolean(c.perfectgymUrl && c.perfectgymUrl !== '#');

// Discipline disponibili in questo centro
const tutte = await getCollection('discipline');
const disc = tutte
  .filter((d) => d.data.centri.includes(entry.id))
  .sort((a, b) => a.data.ordine - b.data.ordine);

/**
 * I numeri in testa rispondono alla prima domanda di chi valuta una palestra:
 * "quanto è grande, quanto c'è da fare". Sono tutti calcolati dai contenuti,
 * così restano veri da soli quando una sala o un corso cambia nel CMS.
 */
const planning = c.planning || [];
const mqTotali = c.superficie ?? c.sale.reduce((t, s) => t + (s.mq || 0), 0);
const GIORNI = ['Lun', 'Mar', 'Mer', 'Gio', 'Ven', 'Sab', 'Dom'];
const perGiorno = GIORNI.map((_, i) => planning.filter((p) => String(p.giorno) === String(i + 1)).length);
const maxGiorno = Math.max(1, ...perGiorno);

/**
 * Repertorio per le sale senza foto vera (campo `foto` nel contenuto, si
 * carica dal CMS). Scelta per parola chiave sul nome: la prima chiave che
 * compare nel nome vince. Man mano che arrivano le foto vere questa mappa
 * serve sempre meno.
 */
const FOTO_SALE: Array<[string, string]> = [
  ['crossfit', '/media/crossfit.jpg'],
  ['reformer', '/media/reformer.jpg'],
  ['boxing', '/media/boxing.jpg'],
  ['intensityou', '/media/boxing.jpg'],
  ['spinning', '/media/cardio.jpg'],
  ['walking', '/media/cardio.jpg'],
  ['les mills', '/media/weights.jpg'],
  ['pesi', '/media/gym1.jpg'],
];
const fotoSala = (nome: string) => {
  const n = nome.toLowerCase();
  for (const [k, f] of FOTO_SALE) if (n.includes(k)) return f;
  return '/media/gym2.jpg';
};

/**
 * Le FAQ del club, non del piano: chi è su una pagina centro vuole sapere
 * come si entra, come si prenota e cosa si può fare — non quanto costa.
 */
const faq = (await getCollection('helpdesk'))
  .filter((v) => v.data.pubblicato && ['accesso', 'prenotazioni', 'regolamento'].includes(v.data.categoria))
  .sort((a, b) => a.data.ordine - b.data.ordine);

// Description e dati strutturati della pagina: ExerciseGym con indirizzo,
// contatti e coordinate — è il segnale che alimenta i risultati locali
// ("palestra macerata" mostra scheda e mappa). Tutto dai contenuti del CMS.
const base = Astro.site ?? new URL('https://lumefitness.it');
const description = c.indirizzo
  ? `${c.nome} a ${c.citta}: ${c.indirizzo}. Sale, discipline, orari e planning del centro — vieni a provare.`
  : `${c.nome} a ${c.citta}: sale, discipline, orari e planning del centro.`;
const jsonldCentro = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ExerciseGym',
  name: c.nome,
  url: new URL(Astro.url.pathname, base).toString(),
  ...(c.indirizzo && {
    address: {
      '@type': 'PostalAddress',
      streetAddress: c.indirizzo,
      addressLocality: c.citta,
      addressCountry: 'IT',
    },
  }),
  ...(c.telefono && { telephone: c.telefono }),
  ...(c.email && { email: c.email }),
  ...(c.coordinate && {
    geo: {
      '@type': 'GeoCoordinates',
      latitude: c.coordinate.lat,
      longitude: c.coordinate.lng,
    },
  }),
  parentOrganization: { '@id': new URL('/#org', base).toString() },
});
---

<Layout title={`${c.nome} — Lume Fitness Club`} description={description}>
  <script type="application/ld+json" slot="head" set:html={jsonldCentro} />
  <Header />
  <main id="contenuto">
  <section class="sec" style="padding-top:0">
    <div class="wrap">
      <div class={`page-hero ${aperto ? '' : 'soon'}`}>
        {/*
          Anche un centro non ancora aperto ha un'immagine di testa: per chi è
          in prevendita è un render, ed è proprio la cosa che sta valutando.
          Una pagina nera con il solo nome non aiuta nessuno a decidere.
        */}
        {
          c.immagine && (
            <Picture
              src={c.immagine}
              alt={c.nome}
              widths={[800, 1400, 2000]}
              sizes="100vw"
              loading="eager"
              fetchpriority="high"
              formats={['avif', 'webp']}
            />
          )
        }
        {/*
          Il video sta SOPRA la foto, non al suo posto: la foto è il fermo
          immagine e resta l'unica cosa che si vede finché il video non è
          caricato, per chi ha chiesto meno movimento e per chi naviga con il
          risparmio dati. Nessun `src` nel markup — lo mette il client solo
          quando decide di caricarlo, altrimenti tre megabyte e mezzo
          partirebbero a ogni visita anche a chi non li vuole.
        */}
        {aperto && c.video && (
          <>
            <video
              class="hero-clip"
              data-centro-video
              data-src={c.video}
              muted
              loop
              playsinline
              preload="none"
              aria-hidden="true"
            />
            <button
              type="button"
              class="hero-vcap hero-vcap-dx"
              data-centro-toggle
              hidden
              aria-label="Metti in pausa il video"
            >
              <svg class="ico-pausa" width="11" height="11" viewBox="0 0 12 12" aria-hidden="true" fill="currentColor">
                <rect x="1" y="1" width="3.5" height="10" rx="1" /><rect x="7.5" y="1" width="3.5" height="10" rx="1" />
              </svg>
              <svg class="ico-play" width="11" height="11" viewBox="0 0 12 12" aria-hidden="true" fill="currentColor">
                <path d="M2 1l9 5-9 5z" />
              </svg>
              Il centro
            </button>
          </>
        )}
        <div class="inner">
          <span class={`badge ${aperto ? 'open' : 'wait'}`} style="position:static;display:inline-block;margin-bottom:12px">
            {aperto ? 'Aperto' : 'Prossima apertura'}
          </span>
          <h1 class="d">{c.nome.replace('Lume ', '')}</h1>
          <p style="color:#cfcfcf;margin-top:6px">{c.citta}</p>
        </div>
      </div>

      {(mqTotali > 0 || planning.length > 0) && (
        <div class="stats centro-stats">
          {mqTotali > 0 && (
            <div class="stat">
              <b>{mqTotali.toLocaleString('it-IT')} <em>m²</em></b>
              <span>di spazio</span>
            </div>
          )}
          {c.sale.length > 0 && (
            <div class="stat">
              <b>{c.sale.length}</b>
              <span>sale e ambienti</span>
            </div>
          )}
          {disc.length > 0 && (
            <div class="stat">
              <b>{disc.length}</b>
              <span>discipline</span>
            </div>
          )}
          {planning.length > 0 && (
            <div class="stat">
              <b>{planning.length}</b>
              <span>lezioni a settimana</span>
            </div>
          )}
        </div>
      )}

      <div style="max-width:760px;margin-top:28px;color:#cbcbcb;font-size:17px">
        <Content />
      </div>

      {c.sale.length > 0 && (
        <div style="margin-top:40px">
          <span class="label">Le sale</span>
          <div class="sale-vis">
            {c.sale.map((s) => (
              <article class="sala-vis">
                <div class="sala-vis-foto">
                  {s.foto ? (
                    <Picture
                      src={s.foto}
                      alt={s.nome}
                      widths={[400, 800]}
                      sizes="(max-width: 700px) 100vw, 400px"
                      formats={['avif', 'webp']}
                      loading="lazy"
                    />
                  ) : (
                    <img src={fotoSala(s.nome)} alt={s.nome} loading="lazy" />
                  )}
                  {s.mq != null && <span class="sala-vis-mq">{s.mq} m²</span>}
                </div>
                <div class="sala-vis-body">
                  <h3>{s.nome}</h3>
                  {s.dotazione && <p>{s.dotazione}</p>}
                </div>
              </article>
            ))}
          </div>
          {!aperto ? (
            <p class="pg-note" style="margin-top:14px">
              Le immagini sono render del progetto esecutivo: metrature e
              finiture sono quelle di progetto e possono cambiare in cantiere.
            </p>
          ) : (
            c.sale.some((s) => !s.foto) && (
              <p class="pg-note" style="margin-top:14px">
                Le foto vere delle sale stanno arrivando: quelle mancanti sono
                immagini di repertorio.
              </p>
            )
          )}
        </div>
      )}

      {/*
        I render riusano la griglia delle sale: stessa card, stessa foto in
        16/9, al posto di nome e dotazione c'è la didascalia. Un secondo
        componente per mostrare un'immagine con una riga sotto non serve.
      */}
      {c.render.length > 0 && (
        <div style="margin-top:44px">
          <span class="label">Com'è il progetto</span>
          <div class="sale-vis">
            {c.render.map((r) => (
              <article class="sala-vis">
                <div class="sala-vis-foto">
                  <Picture
                    src={r.foto}
                    alt={r.didascalia}
                    widths={[400, 800]}
                    sizes="(max-width: 700px) 100vw, 400px"
                    formats={['avif', 'webp']}
                    loading="lazy"
                  />
                  <span class="sala-vis-mq">Render</span>
                </div>
                <div class="sala-vis-body">
                  <h3>{r.didascalia}</h3>
                </div>
              </article>
            ))}
          </div>
        </div>
      )}

      {disc.length > 0 && (
        <div style="margin-top:44px">
          <span class="label">Cosa puoi fare qui</span>
          <div class="disc-vis">
            {disc.map((d) => (
              <a class="disc-vis-card" href={`/discipline/${d.id}`}>
                {d.data.immagine && (
                  <Picture
                    src={d.data.immagine}
                    alt={d.data.nome}
                    widths={[400, 800]}
                    sizes="(max-width: 700px) 50vw, 320px"
                    formats={['avif', 'webp']}
                  />
                )}
                <div class="disc-vis-body">
                  <h3>{d.data.nome}</h3>
                  {d.data.breve && <p>{d.data.breve}</p>}
                </div>
              </a>
            ))}
          </div>
        </div>
      )}

      {/*
        Anche i centri in prevendita con un palinsesto lo mostrano: Urban ha
        36 lezioni e una pagina /planning/urban, e la pagina del centro
        diceva lo stesso «sarà pubblicato all'apertura» di chi non ha ancora
        niente. Quello che manca non è la data di apertura, è l'orario — e se
        c'è, si fa vedere, con la nota del centro a dire che è provvisorio.
      */}
      {planning.length > 0 && (
        <div class="planning">
          <div class="d">Una settimana qui</div>
          <p>
            {planning.length} lezioni {aperto ? 'in programma ogni settimana' : 'nel palinsesto previsto'}. Ecco come si
            distribuiscono — l'orario completo, con sale e istruttori, è nella
            pagina del planning.
          </p>
          {!aperto && c.planningNota && <p class="planning-nota">{c.planningNota}</p>}
          <div class="settimana" aria-label="Lezioni per giorno della settimana">
            {GIORNI.map((g, i) => (
              <div class="giorno">
                <div class="giorno-bar" style={`height:${Math.round((perGiorno[i] / maxGiorno) * 100)}%`} />
                <b>{perGiorno[i]}</b>
                <span>{g}</span>
              </div>
            ))}
          </div>
          <a href={`/planning/${entry.id}`} class="btn btn-out" style="margin-top:16px">
            Vedi l’orario dei corsi
          </a>
        </div>
      )}

      {planning.length === 0 && (
        <div class="planning">
          <div class="d">Planning {c.nome.replace('Lume ', '')}</div>
          <p>L’orario dei corsi sarà pubblicato all’apertura del centro.</p>
        </div>
      )}

      {aperto && faq.length > 0 && (
        <div style="margin-top:44px">
          <span class="label">Domande frequenti</span>
          <div class="faq">
            {faq.map((v) => (
              <details>
                <summary>{v.data.titolo}</summary>
                <div class="faq-in">
                  <p>{v.data.sintesi}</p>
                  <a href={`/lume-life/help/${v.id}`}>Leggi la risposta completa</a>
                </div>
              </details>
            ))}
          </div>
        </div>
      )}

      <div class="info-grid">
        {c.indirizzo && (
          <div class="info-card">
            <h4>Dove siamo</h4>
            <p>{c.indirizzo}</p>
            {c.telefono && <p style="color:#9a9a9a">{c.telefono}</p>}
            {c.email && <p style="color:#9a9a9a">{c.email}</p>}
          </div>
        )}
        {c.orari && (
          <div class="info-card">
            <h4>Orari</h4>
            <p>Lun–Ven &nbsp; {c.orari.feriali}</p>
            <p>Sabato &nbsp; {c.orari.sabato}</p>
            <p>Domenica &nbsp; {c.orari.domenica}</p>
          </div>
        )}
        {c.servizi.length > 0 && (
          <div class="info-card">
            <h4>Servizi</h4>
            <div class="chips">{c.servizi.map((s) => <span class="chip">{s}</span>)}</div>
          </div>
        )}
      </div>

      {/*
        Le CTA della sede portano il centro già selezionato: chi è su questa
        pagina ha già risposto alla domanda "quale centro", e richiederla nel
        form sarebbe attrito gratuito. `data-medium` porta lo slug, così su
        Airtable si distingue Macerata da Montecassiano come sorgente.
      */}
      {raccogliLead ? (
        <div style="margin-top:34px">
          <BandaCta
            titolo={`Vieni a vedere ${c.nome.replace('Lume ', '')}`}
            testo="Prova una settimana o fissa una visita guidata: ti facciamo vedere le sale e ti spieghiamo come funziona, senza impegno."
            larghezzaCta="280px"
          >
            <button
              type="button"
              class="btn btn-red btn-full"
              data-open-form="prova"
              data-medium={`Centro:${entry.id}`}
              data-centro={entry.id}
            >
              Prova 7 giorni
            </button>
            {/*
              Un link, non un pulsante di form: porta al calendario con la sede
              gia' scelta. Chi vuole solo fissare una visita non deve passare
              da un form per arrivarci.
            */}
            <a href={`/prenota?centro=${entry.id}`} class="btn btn-out btn-full">
              Prenota una visita
            </a>
            <button
              type="button"
              class="btn btn-out btn-full"
              data-open-form="iscrizione"
              data-medium={`CentroAbbonamento:${entry.id}`}
              data-centro={entry.id}
            >
              Richiedi un abbonamento
            </button>
            <button
              type="button"
              class="btn btn-out btn-full"
              data-open-form="info"
              data-medium={`CentroInfo:${entry.id}`}
              data-centro={entry.id}
            >
              Fatti richiamare
            </button>
            {portaleAttivo && (
              <a href={c.perfectgymUrl} class="btn btn-out btn-full">
                Attiva online sul portale
              </a>
            )}
          </BandaCta>
        </div>
      ) : (
        <div style="margin-top:28px">
          <a
            href={siteConfig.prevenditaUrl}
            class="btn btn-red"
            target="_blank"
            rel="noopener"
          >
            Iscriviti alla prevendita ↗
          </a>
        </div>
      )}
    </div>
  </section>
  </main>
  <Footer />
</Layout>

<style>
  .centro-stats {
    margin-top: 24px;
    grid-template-columns: repeat(4, 1fr);
  }
  @media (max-width: 700px) {
    .centro-stats {
      grid-template-columns: 1fr 1fr;
    }
  }

  .sale-vis {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 14px;
    margin-top: 16px;
  }
  .sala-vis {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 16px;
    overflow: hidden;
  }
  .sala-vis-foto {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }
  .sala-vis-foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .sala-vis-mq {
    position: absolute;
    top: 10px;
    right: 10px;
    background: rgba(10, 10, 10, 0.85);
    border: 1px solid var(--line);
    color: var(--red-txt);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    padding: 5px 10px;
    border-radius: 999px;
  }
  .sala-vis-body {
    padding: 16px 18px 18px;
  }
  .sala-vis-body h3 {
    font-family: 'Anton', sans-serif;
    text-transform: uppercase;
    font-size: 19px;
    letter-spacing: 0.02em;
    margin: 0 0 6px;
  }
  .sala-vis-body p {
    color: var(--mut);
    font-size: 14px;
    margin: 0;
  }

  .disc-vis {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 14px;
    margin-top: 16px;
  }
  .disc-vis-card {
    display: block;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 16px;
    overflow: hidden;
    color: inherit;
    transition: border-color 0.2s;
  }
  .disc-vis-card:hover {
    border-color: var(--red-txt);
  }
  .disc-vis-card img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
  }
  .disc-vis-body {
    padding: 14px 16px 16px;
  }
  .disc-vis-body h3 {
    font-family: 'Anton', sans-serif;
    text-transform: uppercase;
    font-size: 17px;
    margin: 0 0 4px;
  }
  .disc-vis-body p {
    color: var(--mut);
    font-size: 13px;
    margin: 0;
  }

  .settimana {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 8px;
    margin-top: 18px;
    align-items: end;
  }
  .giorno {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    height: 120px;
    justify-content: flex-end;
  }
  .giorno-bar {
    width: 100%;
    min-height: 3px;
    background: var(--red);
    border-radius: 6px 6px 0 0;
  }
  .giorno b {
    font-family: 'Anton', sans-serif;
    font-size: 16px;
  }
  .giorno span {
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--mut);
  }

  .faq {
    margin-top: 16px;
    display: grid;
    gap: 8px;
  }
  .faq details {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 0;
  }
  .faq summary {
    cursor: pointer;
    padding: 16px 18px;
    font-weight: 600;
    min-height: 44px;
    list-style: none;
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq summary::after {
    content: '+';
    float: right;
    color: var(--red-txt);
    font-family: 'Anton', sans-serif;
  }
  .faq details[open] summary::after {
    content: '–';
  }
  .faq-in {
    padding: 0 18px 16px;
    color: var(--mut);
    font-size: 15px;
  }
  .faq-in a {
    color: var(--red-txt);
  }
</style>

<script>
  import { initVideoCentro } from '../../lib/videoCentro.client.js';

  document.querySelectorAll('[data-centro-video]').forEach((el) => {
    if (el instanceof HTMLVideoElement) initVideoCentro(el);
  });
</script>

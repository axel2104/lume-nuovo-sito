---
import { Picture } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BandaCta from '../../components/BandaCta.astro';
import { getCollection, render } from 'astro:content';
import { SEDI } from '../../config/forms';
import { siteConfig } from '../../config/site';

export async function getStaticPaths() {
  const centri = await getCollection('centri');
  return centri.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const c = entry.data;
const { Content } = await render(entry);
const aperto = c.stato === 'aperto';

/**
 * I form raccolgono lead solo per i centri che il campo SEDE di Airtable
 * conosce. Un centro aperto ma assente da quella lista mostrerebbe form che
 * generano record scartati, quindi qui torna ai contatti generici.
 */
const raccogliLead = aperto && Boolean(SEDI[entry.id]);

/** `perfectgymUrl` ha default '#': un link a '#' è peggio di nessun link. */
const portaleAttivo = Boolean(c.perfectgymUrl && c.perfectgymUrl !== '#');

// Discipline disponibili in questo centro
const tutte = await getCollection('discipline');
const disc = tutte
  .filter((d) => d.data.centri.includes(entry.id))
  .sort((a, b) => a.data.ordine - b.data.ordine);

/**
 * I numeri in testa rispondono alla prima domanda di chi valuta una palestra:
 * "quanto è grande, quanto c'è da fare". Sono tutti calcolati dai contenuti,
 * così restano veri da soli quando una sala o un corso cambia nel CMS.
 */
const planning = c.planning || [];
const mqTotali = c.superficie ?? c.sale.reduce((t, s) => t + (s.mq || 0), 0);
const GIORNI = ['Lun', 'Mar', 'Mer', 'Gio', 'Ven', 'Sab', 'Dom'];
const perGiorno = GIORNI.map((_, i) => planning.filter((p) => String(p.giorno) === String(i + 1)).length);
const maxGiorno = Math.max(1, ...perGiorno);

/**
 * Repertorio per le sale senza foto vera (campo `foto` nel contenuto, si
 * carica dal CMS). Scelta per parola chiave sul nome: la prima chiave che
 * compare nel nome vince. Man mano che arrivano le foto vere questa mappa
 * serve sempre meno.
 */
const FOTO_SALE: Array<[string, string]> = [
  ['crossfit', '/media/crossfit.jpg'],
  ['reformer', '/media/reformer.jpg'],
  ['boxing', '/media/boxing.jpg'],
  ['intensityou', '/media/boxing.jpg'],
  ['spinning', '/media/cardio.jpg'],
  ['walking', '/media/cardio.jpg'],
  ['les mills', '/media/weights.jpg'],
  ['pesi', '/media/gym1.jpg'],
];
const fotoSala = (nome: string) => {
  const n = nome.toLowerCase();
  for (const [k, f] of FOTO_SALE) if (n.includes(k)) return f;
  return '/media/gym2.jpg';
};

/**
 * Le FAQ del club, non del piano: chi è su una pagina centro vuole sapere
 * come si entra, come si prenota e cosa si può fare — non quanto costa.
 */
const faq = (await getCollection('helpdesk'))
  .filter((v) => v.data.pubblicato && ['accesso', 'prenotazioni', 'regolamento'].includes(v.data.categoria))
  .sort((a, b) => a.data.ordine - b.data.ordine);

// Description e dati strutturati della pagina: ExerciseGym con indirizzo,
// contatti e coordinate — è il segnale che alimenta i risultati locali
// ("palestra macerata" mostra scheda e mappa). Tutto dai contenuti del CMS.
const base = Astro.site ?? new URL('https://lumefitness.it');
const description = c.indirizzo
  ? `${c.nome} a ${c.citta}: ${c.indirizzo}. Sale, discipline, orari e planning del centro — vieni a provare.`
  : `${c.nome} a ${c.citta}: sale, discipline, orari e planning del centro.`;
const jsonldCentro = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ExerciseGym',
  name: c.nome,
  url: new URL(Astro.url.pathname, base).toString(),
  ...(c.indirizzo && {
    address: {
      '@type': 'PostalAddress',
      streetAddress: c.indirizzo,
      addressLocality: c.citta,
      addressCountry: 'IT',
    },
  }),
  ...(c.telefono && { telephone: c.telefono }),
  ...(c.email && { email: c.email }),
  ...(c.coordinate && {
    geo: {
      '@type': 'GeoCoordinates',
      latitude: c.coordinate.lat,
      longitude: c.coordinate.lng,
    },
  }),
  parentOrganization: { '@id': new URL('/#org', base).toString() },
});

/**
 * Il listino della sede, se ce l'ha.
 *
 * Piediripa non ce l'ha ancora, e finche' non ce l'ha la sua pagina non
 * mostra nessun blocco prezzi.
 */
const listino = c.listino;

/**
 * Un totale annuale diviso in dodici, arrotondato all'euro.
 *
 * Sul listino queste cifre sono stampate accanto a quelle annuali (660 → 55,
 * 465 → 39, 850 → 71): sono la stessa cosa detta due volte. Scriverle nei
 * contenuti vorrebbe dire tenere allineati due numeri che non possono
 * divergere per definizione — e che infatti, prima o poi, divergono.
 */
const alMese = (totale: number) => Math.round(totale / 12);

/**
 * Cosa questo piano aggiunge rispetto al piano piu' grande che contiene per
 * intero — la stessa regola delle schede di /abbonamenti.
 *
 * Le schede mostrano il delta e non l'elenco completo: fra Sala e Gold ci
 * sono tre voci di differenza su sette, e tre elenchi interi affiancati
 * costringono a leggerli riga per riga per trovarle.
 *
 * Il riferimento si cerca nei dati e non nella scheda precedente: se un
 * giorno i piani si riordinano dal CMS, una scheda non puo' annunciare
 * «tutto di X, piu'» seguito da un elenco vuoto.
 */
type PianoSede = NonNullable<typeof listino>['piani'][number];
const sintesiVoci = (piani: PianoSede[], i: number) => {
  const p = piani[i];
  const contenuti = piani.filter(
    (q, j) => j !== i && q.attivita.length > 0 && q.attivita.every((v) => p.attivita.includes(v)),
  );
  const base = [...contenuti].sort((a, b) => b.attivita.length - a.attivita.length)[0];
  const voci = base ? p.attivita.filter((v) => !base.attivita.includes(v)) : p.attivita;
  return { base, voci };
};
---

<Layout title={`${c.nome} — Lume Fitness Club`} description={description}>
  <script type="application/ld+json" slot="head" set:html={jsonldCentro} />
  <Header />
  <main id="contenuto">
  <section class="sec" style="padding-top:0">
    <div class="wrap">
      <div class={`page-hero ${aperto ? '' : 'soon'}`}>
        {/*
          Anche un centro non ancora aperto ha un'immagine di testa: per chi è
          in prevendita è un render, ed è proprio la cosa che sta valutando.
          Una pagina nera con il solo nome non aiuta nessuno a decidere.
        */}
        {
          c.immagine && (
            <Picture
              src={c.immagine}
              alt={c.nome}
              widths={[800, 1400, 2000]}
              sizes="100vw"
              loading="eager"
              fetchpriority="high"
              formats={['avif', 'webp']}
            />
          )
        }
        {/*
          Il video sta SOPRA la foto, non al suo posto: la foto è il fermo
          immagine e resta l'unica cosa che si vede finché il video non è
          caricato, per chi ha chiesto meno movimento e per chi naviga con il
          risparmio dati. Nessun `src` nel markup — lo mette il client solo
          quando decide di caricarlo, altrimenti tre megabyte e mezzo
          partirebbero a ogni visita anche a chi non li vuole.
        */}
        {aperto && c.video && (
          <>
            <video
              class="hero-clip"
              data-centro-video
              data-src={c.video}
              muted
              loop
              playsinline
              preload="none"
              aria-hidden="true"
            />
            <button
              type="button"
              class="hero-vcap hero-vcap-dx"
              data-centro-toggle
              hidden
              aria-label="Metti in pausa il video"
            >
              <svg class="ico-pausa" width="11" height="11" viewBox="0 0 12 12" aria-hidden="true" fill="currentColor">
                <rect x="1" y="1" width="3.5" height="10" rx="1" /><rect x="7.5" y="1" width="3.5" height="10" rx="1" />
              </svg>
              <svg class="ico-play" width="11" height="11" viewBox="0 0 12 12" aria-hidden="true" fill="currentColor">
                <path d="M2 1l9 5-9 5z" />
              </svg>
              Il centro
            </button>
          </>
        )}
        <div class="inner">
          <span class={`badge ${aperto ? 'open' : 'wait'}`} style="position:static;display:inline-block;margin-bottom:12px">
            {aperto ? 'Aperto' : 'Prossima apertura'}
          </span>
          <h1 class="d">{c.nome.replace('Lume ', '')}</h1>
          <p style="color:#cfcfcf;margin-top:6px">{c.citta}</p>
        </div>
      </div>

      {(mqTotali > 0 || planning.length > 0) && (
        <div class="stats centro-stats">
          {mqTotali > 0 && (
            <div class="stat">
              <b>{mqTotali.toLocaleString('it-IT')} <em>m²</em></b>
              <span>di spazio</span>
            </div>
          )}
          {c.sale.length > 0 && (
            <div class="stat">
              <b>{c.sale.length}</b>
              <span>sale e ambienti</span>
            </div>
          )}
          {disc.length > 0 && (
            <div class="stat">
              <b>{disc.length}</b>
              <span>discipline</span>
            </div>
          )}
          {planning.length > 0 && (
            <div class="stat">
              <b>{planning.length}</b>
              <span>lezioni a settimana</span>
            </div>
          )}
        </div>
      )}

      <div style="max-width:760px;margin-top:28px;color:#cbcbcb;font-size:17px">
        <Content />
      </div>

      {c.sale.length > 0 && (
        <div style="margin-top:40px">
          <span class="label">Le sale</span>
          <div class="sale-vis">
            {c.sale.map((s) => (
              <article class="sala-vis">
                <div class="sala-vis-foto">
                  {s.foto ? (
                    <Picture
                      src={s.foto}
                      alt={s.nome}
                      widths={[400, 800]}
                      sizes="(max-width: 700px) 100vw, 400px"
                      formats={['avif', 'webp']}
                      loading="lazy"
                    />
                  ) : (
                    <img src={fotoSala(s.nome)} alt={s.nome} loading="lazy" />
                  )}
                  {s.mq != null && <span class="sala-vis-mq">{s.mq} m²</span>}
                </div>
                <div class="sala-vis-body">
                  <h3>{s.nome}</h3>
                  {s.dotazione && <p>{s.dotazione}</p>}
                </div>
              </article>
            ))}
          </div>
          {!aperto ? (
            <p class="pg-note" style="margin-top:14px">
              Le immagini sono render del progetto esecutivo: metrature e
              finiture sono quelle di progetto e possono cambiare in cantiere.
            </p>
          ) : (
            c.sale.some((s) => !s.foto) && (
              <p class="pg-note" style="margin-top:14px">
                Le foto vere delle sale stanno arrivando: quelle mancanti sono
                immagini di repertorio.
              </p>
            )
          )}
        </div>
      )}

      {/*
        I render riusano la griglia delle sale: stessa card, stessa foto in
        16/9, al posto di nome e dotazione c'è la didascalia. Un secondo
        componente per mostrare un'immagine con una riga sotto non serve.
      */}
      {c.render.length > 0 && (
        <div style="margin-top:44px">
          <span class="label">Com'è il progetto</span>
          <div class="sale-vis">
            {c.render.map((r) => (
              <article class="sala-vis">
                <div class="sala-vis-foto">
                  <Picture
                    src={r.foto}
                    alt={r.didascalia}
                    widths={[400, 800]}
                    sizes="(max-width: 700px) 100vw, 400px"
                    formats={['avif', 'webp']}
                    loading="lazy"
                  />
                  <span class="sala-vis-mq">Render</span>
                </div>
                <div class="sala-vis-body">
                  <h3>{r.didascalia}</h3>
                </div>
              </article>
            ))}
          </div>
        </div>
      )}

      {disc.length > 0 && (
        <div style="margin-top:44px">
          <span class="label">Cosa puoi fare qui</span>
          <div class="disc-vis">
            {disc.map((d) => (
              <a class="disc-vis-card" href={`/discipline/${d.id}`}>
                {d.data.immagine && (
                  <Picture
                    src={d.data.immagine}
                    alt={d.data.nome}
                    widths={[400, 800]}
                    sizes="(max-width: 700px) 50vw, 320px"
                    formats={['avif', 'webp']}
                  />
                )}
                <div class="disc-vis-body">
                  <h3>{d.data.nome}</h3>
                  {d.data.breve && <p>{d.data.breve}</p>}
                </div>
              </a>
            ))}
          </div>
        </div>
      )}

      {/*
        Anche i centri in prevendita con un palinsesto lo mostrano: Urban ha
        36 lezioni e una pagina /planning/urban, e la pagina del centro
        diceva lo stesso «sarà pubblicato all'apertura» di chi non ha ancora
        niente. Quello che manca non è la data di apertura, è l'orario — e se
        c'è, si fa vedere, con la nota del centro a dire che è provvisorio.
      */}
      {planning.length > 0 && (
        <div class="planning">
          <div class="d">Una settimana qui</div>
          <p>
            {planning.length} lezioni {aperto ? 'in programma ogni settimana' : 'nel palinsesto previsto'}. Ecco come si
            distribuiscono — l'orario completo, con sale e istruttori, è nella
            pagina del planning.
          </p>
          {!aperto && c.planningNota && <p class="planning-nota">{c.planningNota}</p>}
          <div class="settimana" aria-label="Lezioni per giorno della settimana">
            {GIORNI.map((g, i) => (
              <div class="giorno">
                <div class="giorno-bar" style={`height:${Math.round((perGiorno[i] / maxGiorno) * 100)}%`} />
                <b>{perGiorno[i]}</b>
                <span>{g}</span>
              </div>
            ))}
          </div>
          <a href={`/planning/${entry.id}`} class="btn btn-out" style="margin-top:16px">
            Vedi l’orario dei corsi
          </a>
        </div>
      )}

      {planning.length === 0 && (
        <div class="planning">
          <div class="d">Planning {c.nome.replace('Lume ', '')}</div>
          <p>L’orario dei corsi sarà pubblicato all’apertura del centro.</p>
        </div>
      )}

      {aperto && faq.length > 0 && (
        <div style="margin-top:44px">
          <span class="label">Domande frequenti</span>
          <div class="faq">
            {faq.map((v) => (
              <details>
                <summary>{v.data.titolo}</summary>
                <div class="faq-in">
                  <p>{v.data.sintesi}</p>
                  <a href={`/lume-life/help/${v.id}`}>Leggi la risposta completa</a>
                </div>
              </details>
            ))}
          </div>
        </div>
      )}

      <div class="info-grid">
        {c.indirizzo && (
          <div class="info-card">
            <h4>Dove siamo</h4>
            <p>{c.indirizzo}</p>
            {c.telefono && <p style="color:#9a9a9a">{c.telefono}</p>}
            {c.email && <p style="color:#9a9a9a">{c.email}</p>}
          </div>
        )}
        {c.orari && (
          <div class="info-card">
            <h4>Orari</h4>
            <p>Lun–Ven &nbsp; {c.orari.feriali}</p>
            <p>Sabato &nbsp; {c.orari.sabato}</p>
            <p>Domenica &nbsp; {c.orari.domenica}</p>
          </div>
        )}
        {c.servizi.length > 0 && (
          <div class="info-card">
            <h4>Servizi</h4>
            <div class="chips">{c.servizi.map((s) => <span class="chip">{s}</span>)}</div>
          </div>
        )}
      </div>

      {/*
        Il listino della sede, subito prima delle CTA: chi e' arrivato fin qui
        ha gia' visto sale, orari e servizi, e la domanda che resta e' quanto
        costa. Metterlo dopo il pulsante "Richiedi un abbonamento" vorrebbe
        dire chiedere di agire prima di aver dato il prezzo.

        Senza listino il blocco non esiste: nessun riquadro vuoto, nessun
        "prezzi in aggiornamento".
      */}
      {listino && listino.piani.length > 0 && (
        <div class="listino-sede" style="margin-top:44px">
          <span class="label">Abbonamenti {c.nome.replace('Lume ', '')}</span>
          {listino.nota && <p class="listino-nota">{listino.nota}</p>}

          {/*
            Le radio stanno prima delle schede nel DOM perche' `:has()` sul
            contenitore deve poterle vedere. Nessun JavaScript: e' lo stesso
            meccanismo di /abbonamenti, e senza `:has()` resta visibile la
            soluzione unica, che e' la formula che conviene.

            Una formula alla volta perche' tre prezzi per piano, ognuno con la
            sua rata e il suo totale, sono dodici numeri in una scheda: chi
            legge non confronta piu' niente, guarda un tabellone.
          */}
          <fieldset class="pf">
            <legend class="sr-only">Come vuoi pagare</legend>
            <input type="radio" name="formula-sede" id="f-annuale" checked />
            <label for="f-annuale">Soluzione unica<span>la più conveniente</span></label>
            <input type="radio" name="formula-sede" id="f-rate" />
            <label for="f-rate">Dilazionato<span>12 rate</span></label>
            <input type="radio" name="formula-sede" id="f-mensile" />
            <label for="f-mensile">Mensile<span>senza vincolo</span></label>
          </fieldset>

          <div class="plans">
            {listino.piani.map((piano, i) => {
              const { base, voci } = sintesiVoci(listino.piani, i);
              /*
                Dodici mesi di mensile contro dodici mesi pagati in una volta.
                L'attivazione si paga in tutte e due, quindi si semplifica e
                non entra nel conto.
              */
              const risparmio = piano.mensile * 12 - piano.annuale;
              return (
                <article class={piano.evidenza ? 'plan hot' : 'plan'}>
                  {piano.evidenza && <span class="plan-tag">Il più scelto</span>}

                  <div class="plan-testa">
                    <h3 class="pn">{piano.nome}</h3>
                    {piano.per && <p class="plan-per">{piano.per}</p>}
                  </div>

                  {/*
                    In evidenza il costo al mese, perche' e' la cifra con cui
                    si ragiona quando si sceglie una palestra. Ma subito sotto,
                    non in fondo, cosa si paga davvero: 55 €/mese in soluzione
                    unica vuol dire 660 € in una volta, e chi legge deve
                    saperlo prima di chiedere, non in reception.
                  */}
                  <div class="plan-prezzo">
                    <div data-formula="annuale">
                      <div class="pr">
                        {alMese(piano.annuale)}&nbsp;€<small>/mese</small>
                      </div>
                      <p class="plan-nota">
                        <b>{piano.annuale} €</b> pagati in una volta.
                        {risparmio > 0 && (
                          <>
                            {' '}Su dodici mesi risparmi <b>{risparmio} €</b> rispetto al mensile.
                          </>
                        )}
                      </p>
                      <ul class="plan-cond">
                        <li>Durata 12 mesi</li>
                        <li>Attivazione {listino.attivazione} € una volta sola</li>
                      </ul>
                    </div>

                    <div data-formula="rate">
                      <div class="pr">
                        {alMese(piano.rate)}&nbsp;€<small>/mese</small>
                      </div>
                      <p class="plan-nota">
                        <b>{piano.rate} €</b> in tutto, in 12 rate con Pagodil® o Pagolight®.
                      </p>
                      <ul class="plan-cond">
                        <li>Durata 12 mesi, nessun interesse</li>
                        <li>Attivazione {listino.attivazione} € una volta sola</li>
                      </ul>
                    </div>

                    <div data-formula="mensile">
                      <div class="pr">
                        {piano.mensile}&nbsp;€<small>/mese</small>
                      </div>
                      <p class="plan-nota">Rinnovo automatico, nessun vincolo di durata.</p>
                      <ul class="plan-cond">
                        <li>Disdici quando vuoi</li>
                        <li>Attivazione {listino.attivazione} € una volta sola</li>
                      </ul>
                    </div>
                  </div>

                  {voci.length > 0 && (
                    <div class="plan-voci">
                      <p class="plan-delta">{base ? `Tutto di ${base.nome}, più` : 'Comprende'}</p>
                      <ul>{voci.map((v) => <li>{v}</li>)}</ul>
                    </div>
                  )}

                  {/*
                    Il pulsante porta centro e piano gia' scelti: chi e' su
                    questa scheda ha risposto a entrambe le domande, e
                    richiederle nel form sarebbe attrito gratuito. Sui centri
                    in prevendita non c'e', perche' li' l'unica azione
                    possibile e' la prevendita, ed e' gia' in fondo alla
                    pagina.
                  */}
                  {/*
                    Un pulsante per formula, dentro il suo `data-formula`:
                    senza JavaScript la pagina non sa quale radio e' spuntata,
                    e il lead deve portarsi dietro anche COME si vuole pagare.
                    Richiederlo al telefono e' una domanda a cui l'utente ha
                    gia' risposto.
                  */}
                  {raccogliLead && (
                    <div class="plan-azioni">
                      {(['annuale', 'rate', 'mensile'] as const).map((f) => {
                        const portale = piano.pgm?.[f];
                        return (
                          <div data-formula={f}>
                            <div class="plan-coppia">
                            {/*
                              Dove il piano esiste sul portale si va dritti al
                              checkout. Dove non esiste — sul portale il mensile
                              c'e' solo per il GOLD — resta il form: un pulsante
                              «Attiva ora» che apre un carrello vuoto e' peggio
                              di nessun pulsante.
                            */}
                            {portale && (
                              <a
                                href={portale}
                                class={`btn ${piano.evidenza ? 'btn-red' : 'btn-out'} btn-full`}
                                rel="noopener"
                              >
                                Attiva ora ↗
                              </a>
                            )}
                            {/*
                              La richiamata resta sempre, e sotto al checkout.
                              Chi e' deciso clicca sopra; chi ha una domanda
                              lascia un contatto invece di uscire dal sito — e
                              senza questo pulsante il lead di chi si ferma
                              davanti al portale non lo vedrebbe nessuno.
                            */}
                            <button
                              type="button"
                              class={portale ? 'btn-lieve' : `btn ${piano.evidenza ? 'btn-red' : 'btn-out'} btn-full`}
                              data-open-form="iscrizione"
                              data-medium={`CentroPiano:${entry.id}:${piano.nome}:${f}`}
                              data-centro={entry.id}
                              data-abbonamento={piano.nome}
                            >
                              {portale ? 'Fatti richiamare' : `Richiedi ${piano.nome}`}
                            </button>
                            </div>
                          </div>
                        );
                      })}
                    </div>
                  )}
                </article>
              );
            })}
          </div>

          {/* Anche la riga Over 65 segue il selettore: una formula alla volta. */}
          {listino.over65?.annuale && (
            <p class="listino-over">
              <b>{listino.over65.titolo}</b>
              {listino.over65.per && <> — {listino.over65.per}</>}:{' '}
              <span data-formula="annuale">
                {alMese(listino.over65.annuale)} € al mese, {listino.over65.annuale} € in una volta.
              </span>
              {listino.over65.rate && (
                <span data-formula="rate">
                  {alMese(listino.over65.rate)} € al mese, {listino.over65.rate} € in tutto in 12
                  rate.
                </span>
              )}
              {listino.over65.mensile && (
                <span data-formula="mensile">
                  {listino.over65.mensile} € al mese, senza vincolo di durata.
                </span>
              )}
            </p>
          )}
        </div>
      )}

      {/*
        Le CTA della sede portano il centro già selezionato: chi è su questa
        pagina ha già risposto alla domanda "quale centro", e richiederla nel
        form sarebbe attrito gratuito. `data-medium` porta lo slug, così su
        Airtable si distingue Macerata da Montecassiano come sorgente.
      */}
      {raccogliLead ? (
        <div style="margin-top:34px">
          <BandaCta
            titolo={`Vieni a vedere ${c.nome.replace('Lume ', '')}`}
            testo="Prova una settimana o fissa una visita guidata: ti facciamo vedere le sale e ti spieghiamo come funziona, senza impegno."
            larghezzaCta="280px"
          >
            <button
              type="button"
              class="btn btn-red btn-full"
              data-open-form="prova"
              data-medium={`Centro:${entry.id}`}
              data-centro={entry.id}
            >
              Prova 7 giorni
            </button>
            {/*
              Un link, non un pulsante di form: porta al calendario con la sede
              gia' scelta. Chi vuole solo fissare una visita non deve passare
              da un form per arrivarci.
            */}
            <a href={`/prenota?centro=${entry.id}`} class="btn btn-out btn-full">
              Prenota una visita
            </a>
            <button
              type="button"
              class="btn btn-out btn-full"
              data-open-form="iscrizione"
              data-medium={`CentroAbbonamento:${entry.id}`}
              data-centro={entry.id}
            >
              Richiedi un abbonamento
            </button>
            <button
              type="button"
              class="btn btn-out btn-full"
              data-open-form="info"
              data-medium={`CentroInfo:${entry.id}`}
              data-centro={entry.id}
            >
              Fatti richiamare
            </button>
            {portaleAttivo && (
              <a href={c.perfectgymUrl} class="btn btn-out btn-full">
                Attiva online sul portale
              </a>
            )}
          </BandaCta>
        </div>
      ) : (
        <div style="margin-top:28px">
          <a
            href={siteConfig.prevenditaUrl}
            class="btn btn-red"
            target="_blank"
            rel="noopener"
          >
            Iscriviti alla prevendita ↗
          </a>
        </div>
      )}
    </div>
  </section>
  </main>
  <Footer />
</Layout>

<style>
  .centro-stats {
    margin-top: 24px;
    grid-template-columns: repeat(4, 1fr);
  }
  @media (max-width: 700px) {
    .centro-stats {
      grid-template-columns: 1fr 1fr;
    }
  }

  .sale-vis {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 14px;
    margin-top: 16px;
  }
  .sala-vis {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 16px;
    overflow: hidden;
  }
  .sala-vis-foto {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }
  .sala-vis-foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .sala-vis-mq {
    position: absolute;
    top: 10px;
    right: 10px;
    background: rgba(10, 10, 10, 0.85);
    border: 1px solid var(--line);
    color: var(--red-txt);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    padding: 5px 10px;
    border-radius: 999px;
  }
  .sala-vis-body {
    padding: 16px 18px 18px;
  }
  .sala-vis-body h3 {
    font-family: 'Anton', sans-serif;
    text-transform: uppercase;
    font-size: 19px;
    letter-spacing: 0.02em;
    margin: 0 0 6px;
  }
  .sala-vis-body p {
    color: var(--mut);
    font-size: 14px;
    margin: 0;
  }

  .disc-vis {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 14px;
    margin-top: 16px;
  }
  .disc-vis-card {
    display: block;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 16px;
    overflow: hidden;
    color: inherit;
    transition: border-color 0.2s;
  }
  .disc-vis-card:hover {
    border-color: var(--red-txt);
  }
  .disc-vis-card img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
  }
  .disc-vis-body {
    padding: 14px 16px 16px;
  }
  .disc-vis-body h3 {
    font-family: 'Anton', sans-serif;
    text-transform: uppercase;
    font-size: 17px;
    margin: 0 0 4px;
  }
  .disc-vis-body p {
    color: var(--mut);
    font-size: 13px;
    margin: 0;
  }

  .settimana {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 8px;
    margin-top: 18px;
    align-items: end;
  }
  .giorno {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    height: 120px;
    justify-content: flex-end;
  }
  .giorno-bar {
    width: 100%;
    min-height: 3px;
    background: var(--red);
    border-radius: 6px 6px 0 0;
  }
  .giorno b {
    font-family: 'Anton', sans-serif;
    font-size: 16px;
  }
  .giorno span {
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--mut);
  }

  .faq {
    margin-top: 16px;
    display: grid;
    gap: 8px;
  }
  .faq details {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 0;
  }
  .faq summary {
    cursor: pointer;
    padding: 16px 18px;
    font-weight: 600;
    min-height: 44px;
    list-style: none;
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq summary::after {
    content: '+';
    float: right;
    color: var(--red-txt);
    font-family: 'Anton', sans-serif;
  }
  .faq details[open] summary::after {
    content: '–';
  }
  .faq-in {
    padding: 0 18px 16px;
    color: var(--mut);
    font-size: 15px;
  }
  .faq-in a {
    color: var(--red-txt);
  }

  /* ── Listino della sede ───────────────────────────────────────────────
     Le schede riusano `.plan` di global.css, le stesse di /abbonamenti:
     badge, nome, prezzo e spunte sono gia' quelli, e riscriverli qui
     avrebbe creato due stili per la stessa cosa destinati a divergere.
     Qui resta solo quello che cambia. */
  .listino-nota {
    margin: 10px 0 20px;
    max-width: 64ch;
    color: var(--txt);
  }
  /* `.plans` su /abbonamenti e' tarata su tre piani, con quello consigliato
     piu' largo (1fr 1.14fr 1fr). I centri non ne hanno sempre tre — Urban ne
     ha due — e su due colonne quella griglia lascia un buco a destra. */
  .listino-sede .plans {
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    margin-bottom: 0;
    align-items: start;
  }
  /* La seconda azione non e' un secondo pulsante: e' un rimando. Due
     pulsanti pieni affiancati si contendono il click e non vince nessuno. */
  .btn-lieve {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    width: 100%;
    padding: 0 12px;
    background: none;
    border: 0;
    border-radius: 999px;
    font: inherit;
    font-size: 13.5px;
    color: var(--mut);
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }
  .btn-lieve:hover {
    color: var(--txt);
  }
  .btn-lieve:focus-visible {
    outline: 2px solid var(--red-txt);
    outline-offset: 2px;
  }

  .listino-over {
    margin: 18px 0 0;
    font-size: 14px;
    color: var(--mut);
    font-variant-numeric: tabular-nums;
  }
  .listino-over b {
    color: var(--txt);
  }
</style>

<script>
  import { initVideoCentro } from '../../lib/videoCentro.client.js';

  document.querySelectorAll('[data-centro-video]').forEach((el) => {
    if (el instanceof HTMLVideoElement) initVideoCentro(el);
  });

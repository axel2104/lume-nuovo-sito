---
import { Picture } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BandaCta from '../../components/BandaCta.astro';
import { getCollection } from 'astro:content';

const centri = (await getCollection('centri')).sort((a, b) => a.data.ordine - b.data.ordine);
---

<Layout
  title="I nostri centri — Lume Fitness Club"
  description="I centri Lume nelle Marche: Macerata, Montecassiano, Urban e Motion. Sale pesi, corsi, piscina e scuola nuoto — scegli il più vicino a te."
>
  <Header />
  <main id="contenuto">
  <section class="sec">
    <div class="wrap">
      <div class="sec-head">
        <span class="label">I centri</span>
        <h2 class="d">Quattro case, una sola energia</h2>
        <p>Scegli il centro Lume più vicino a te.</p>
      </div>
      <div class="grid4">
        {centri.map((c) => (
          <a class={`centro ${c.data.stato === 'aperto' ? '' : 'soon'}`} href={`/centri/${c.id}`}>
            {/* Anche i centri in prevendita hanno un'immagine: la loro è un
                render, ed è quello che c'è da far vedere. */}
            {c.data.immagine && (
              <Picture
                src={c.data.immagine}
                alt={c.data.nome}
                widths={[400, 800, 1200]}
                sizes="(min-width:1024px) 25vw, (min-width:640px) 50vw, 100vw"
                formats={['avif', 'webp']}
              />
            )}
            <span class={`badge ${c.data.stato === 'aperto' ? 'open' : 'wait'}`}>
              {c.data.stato === 'aperto' ? 'Aperto' : 'Prossima apertura'}
            </span>
            <div class="centro-in">
              <h3>{c.data.nome.replace('Lume ', '')}</h3>
              <p>{c.data.citta}</p>
              <div class="lnk">{c.data.stato === 'aperto' ? 'Scopri →' : 'Prevendita →'}</div>
            </div>
          </a>
        ))}
      </div>

      {/* La pagina elencava i centri e finiva: chi ha appena scelto dove
          allenarsi non aveva nessun passo successivo da fare. */}
      <div style="margin-top:34px">
        <BandaCta
          titolo="Non sai quale scegliere?"
          testo="Raccontaci cosa cerchi e ti indirizziamo al centro giusto — o provane uno per una settimana."
        >
          <button type="button" class="btn btn-red btn-full" data-open-form="prova" data-medium="IndiceCentri">
            Prova 7 giorni
          </button>
          <button type="button" class="btn btn-out btn-full" data-open-form="info" data-medium="IndiceCentriInfo">
            Fatti consigliare
          </button>
        </BandaCta>
      </div>
    </div>
  </section>
  </main>
  <Footer />
</Layout>

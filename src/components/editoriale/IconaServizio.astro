---
/**
 * Icone dei servizi. Ogni id corrisponde a una voce di `iconeServizi`
 * in `src/data/tassonomie.ts`: aggiungere un'icona significa aggiungere
 * una voce lì e un `case` qui.
 */
interface Props {
  id: string;
}
const { id } = Astro.props;
---

<svg
  class="srv-icon"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {id === 'coach' && (<><circle cx="12" cy="7" r="3.2" /><path d="M4.5 20a7.5 7.5 0 0 1 15 0" /></>)}
  {id === 'nutrizione' && (<><path d="M12 8c-1-2.5-3.5-3-5-1.5S5 11 6.5 15c1 2.6 2.6 4.5 4 4.5.8 0 1-.5 1.5-.5s.7.5 1.5.5c1.4 0 3-1.9 4-4.5 1.5-4 .5-7-1-8.5S13 5.5 12 8Z" /><path d="M12 8V4.5" /><path d="M12 5.5c1.6 0 2.8-1 3-2.5-1.6-.2-3 .8-3 2.5Z" /></>)}
  {id === 'fisio' && (<><path d="M9 11V5.5a1.5 1.5 0 0 1 3 0V11" /><path d="M12 10.5V4.8a1.5 1.5 0 0 1 3 0V11" /><path d="M15 11V7.3a1.5 1.5 0 0 1 3 0V14a6 6 0 0 1-6 6h-.7a5 5 0 0 1-4.1-2.2L4 13.5a1.6 1.6 0 0 1 2.5-2L9 14" /></>)}
  {id === 'armadietto' && (<><rect x="5" y="3" width="14" height="18" rx="2" /><path d="M12 3v18" /><path d="M9 8v2M15 8v2" /></>)}
  {id === 'shop' && (<><path d="M5 8h14l-1 12H6L5 8Z" /><path d="M9 8V6a3 3 0 0 1 6 0v2" /></>)}
  {id === 'medical' && (<><rect x="3" y="6" width="18" height="14" rx="2" /><path d="M9 6V4h6v2" /><path d="M12 10v6M9 13h6" /></>)}
  {id === 'bimbi' && (<><path d="M12 3 5 10l7 11 7-11-7-7Z" /><path d="M5 10h14M12 3v18" /></>)}
  {id === 'convenzioni' && (<><path d="M3 10V5.5A1.5 1.5 0 0 1 4.5 4H9l11 11-5 5L4 9" /><circle cx="7.5" cy="7.5" r="1.2" /></>)}
</svg>

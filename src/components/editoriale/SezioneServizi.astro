---
import { getCollection, render } from 'astro:content';
import IconaServizio from './IconaServizio.astro';

const servizi = (await getCollection('servizi', ({ data }) => data.pubblicato)).sort(
  (a, b) => a.data.ordine - b.data.ordine,
);

// Il testo del pannello è il corpo Markdown del file: lo rendiamo qui, una
// volta sola, invece di passarlo come stringa a un mini-renderer.
const conTesto = await Promise.all(
  servizi.map(async (s) => ({ s, Content: (await render(s)).Content })),
);
---

{
  conTesto.length > 0 && (
    <section class="sec" id="servizi">
      <div class="wrap">
        <div class="sec-head">
          <span class="label">Servizi</span>
          <h2 class="d">Oltre l’allenamento</h2>
          <p>
            Tutto quello che ruota attorno alla sala: professionisti, convenzioni e servizi pensati
            per farti stare bene dentro e fuori dal centro.
          </p>
        </div>

        <div class="srv-grid">
          {conTesto.map(({ s, Content }) => (
            <details class="srv-card">
              <summary>
                <IconaServizio id={s.data.icona} />
                <strong>{s.data.titolo}</strong>
                <span>{s.data.breve}</span>
                <em aria-hidden="true">+</em>
              </summary>
              <div class="srv-det">
                <Content />
              </div>
              {s.data.href && (
                <a class="ed-more" href={s.data.href}>
                  Scopri di più
                </a>
              )}
            </details>
          ))}
        </div>

        {/* Fisioterapia, nutrizione e personal training si vendono parlando:
            senza una CTA la sezione informava e si fermava lì. */}
        <div class="srv-cta">
          <button type="button" class="btn btn-out" data-open-form="info" data-medium="SezioneServizi">
            Parla con noi di un servizio
          </button>
        </div>
      </div>
    </section>
  )
}

<style>
  .srv-cta {
    margin-top: 26px;
  }
</style>

---
import { consensoGestito } from '../config/site';

const anno = new Date().getFullYear();

/**
 * Il numero è uno per tutti i centri: chi risponde smista.
 * Il formato `tel:` va senza spazi, quello visibile con: sono due cose diverse.
 */
const telefono = { visibile: '0733 232905', link: '+390733232905' };

const social = [
  { nome: 'Instagram', url: 'https://www.instagram.com/lumefitnessclub/' },
  { nome: 'Facebook', url: 'https://www.facebook.com/lumefitnessclub/' },
];
---

<footer class="site">
  <div class="wrap">
    <div class="foot">
      <div class="brand">
        <div class="logo">LUM<span style="color:var(--red)">e</span>.</div>
        <p class="tag">Lume Fitness Club — Benessere a 360°. Quattro centri nelle Marche.</p>
      </div>
      <div>
        <h4>Centri</h4>
        <ul>
          <li><a href="/centri/macerata">Macerata</a></li>
          <li><a href="/centri/montecassiano">Montecassiano</a></li>
          <li><a href="/centri/piediripa">Piediripa</a></li>
          <li><a href="/centri/urban">Urban</a></li>
        </ul>
      </div>
      <div>
        <h4>Esplora</h4>
        <ul>
          <li><a href="/discipline">Discipline</a></li>
          <li><a href="/lume-life">Lume Life</a></li>
          <li><a href="/lume-life#eventi">Eventi</a></li>
          <li><a href="/lume-life#help">Help desk</a></li>
          <li><a href="/abbonamenti">Abbonamenti</a></li>
          <li><a href="/scuola-nuoto">Scuola nuoto bambini</a></li>
          <li><a href="/planning/macerata">Planning Macerata</a></li>
          <li><a href="/planning/montecassiano">Planning Montecassiano</a></li>
          <li><a href="/prova">Prova 7 giorni</a></li>
          <li><a href="/iscriviti">Iscriviti</a></li>
        </ul>
      </div>
      <div>
        <h4>Contatti</h4>
        <ul>
          <li><a href="/contatti">Scrivici</a></li>
          <li><a href="mailto:info@lumefitness.it">info@lumefitness.it</a></li>
          <li><a href={`tel:${telefono.link}`}>{telefono.visibile}</a></li>
          <li class="foot-social">
            {
              social.map((s) => (
                <a href={s.url} target="_blank" rel="noopener me">
                  {s.nome}
                </a>
              ))
            }
          </li>
        </ul>
      </div>
    </div>
    <div class="copy">
      <span>© {anno} Lume Fitness Club</span>
      <span>
        <a href="/privacy">Privacy</a> ·
        <a href="/cookie-policy">Cookie</a>
        {/*
          `iubenda-cs-preferences-link` riapre l'intero banner. La classe
          `iubenda-advertising-preferences-link` che stava qui prima apre solo
          le preferenze pubblicitarie TCF: sulla maggior parte delle
          configurazioni non apre niente, e il link resta un salto a inizio
          pagina. E senza gestore configurato non lo mostriamo affatto:
          "Preferenze cookie" che non fa nulla è peggio che assente.
        */}
        {consensoGestito && (
          <>
            {' · '}
            <a href="#" class="iubenda-cs-preferences-link">Preferenze cookie</a>
          </>
        )}
      </span>
    </div>
  </div>
</footer>

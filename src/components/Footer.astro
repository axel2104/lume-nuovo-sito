---
import { getCollection } from 'astro:content';
import { consensoGestito } from '../config/site';

const anno = new Date().getFullYear();

// L'ordine dei pin in mappa (1-4) segue il campo `ordine` dei contenuti:
// la legenda sotto l'immagine usa lo stesso numero, quindi NON riordinare
// qui in modo diverso dallo script scripts/genera_mappa_centri.py.
const centri = (await getCollection('centri')).sort(
  (a, b) => a.data.ordine - b.data.ordine
);

/**
 * Il numero è uno per tutti i centri: chi risponde smista.
 * Il formato `tel:` va senza spazi, quello visibile con: sono due cose diverse.
 */
const telefono = { visibile: '0733 232905', link: '+390733232905' };

const social = [
  { nome: 'Instagram', url: 'https://www.instagram.com/lumefitnessclub/' },
  { nome: 'Facebook', url: 'https://www.facebook.com/lumefitnessclub/' },
];
---

<footer class="site">
  <div class="wrap">
    {/*
      Mappa statica generata da scripts/genera_mappa_centri.py a partire dal
      campo `coordinate` dei centri: se cambia un indirizzo o apre un centro,
      va rilanciato lo script, l'immagine non si aggiorna da sola. È statica
      di proposito (ARCHITETTURA.md: niente isole JS per la mappa): le
      indicazioni stradali partono dal link, che apre Google Maps solo a chi
      lo sceglie — niente cookie di terze parti nel footer di ogni pagina.
    */}
    <span class="label">Le sedi</span>
    <div class="foot-mappa">
      <div class="foot-mappa-img">
        <picture>
          <source srcset="/media/mappa-centri.webp" type="image/webp" />
          <img
            src="/media/mappa-centri.png"
            width="1700"
            height="1100"
            alt="Mappa della zona di Macerata con la posizione dei quattro centri Lume"
            loading="lazy"
            decoding="async"
          />
        </picture>
        <span class="foot-mappa-cred">© OpenStreetMap contributors</span>
      </div>
      <ol class="foot-mappa-elenco">
        {
          centri.map((c, i) => (
            <li>
              <span class:list={['foot-mappa-num', { aperto: c.data.stato === 'aperto' }]}>
                {i + 1}
              </span>
              <span class="foot-mappa-txt">
                <b>{c.data.nome}</b>
                <small>{c.data.indirizzo ?? `${c.data.citta} — indirizzo in arrivo`}</small>
              </span>
              {c.data.indirizzo ? (
                <a
                  class="foot-mappa-link"
                  href={`https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(c.data.indirizzo)}`}
                  target="_blank"
                  rel="noopener"
                >
                  Indicazioni
                </a>
              ) : (
                <a class="foot-mappa-link" href={`/centri/${c.id}`}>
                  Prevendita
                </a>
              )}
            </li>
          ))
        }
      </ol>
    </div>
    <div class="foot">
      <div class="brand">
        <div class="logo"><img src="/logo-lume.png" alt="" width="34" height="34" /><span class="logo-txt">LUME<span class="logo-sub">Fitness Club</span></span></div>
        <p class="tag">Lume Fitness Club — Benessere a 360°. Quattro centri nelle Marche.</p>
      </div>
      <div>
        <h4>Centri</h4>
        <ul>
          <li><a href="/centri/macerata">Macerata</a></li>
          <li><a href="/centri/montecassiano">Montecassiano</a></li>
          <li><a href="/centri/piediripa">Piediripa</a></li>
          <li><a href="/centri/urban">Urban</a></li>
        </ul>
      </div>
      <div>
        <h4>Esplora</h4>
        <ul>
          <li><a href="/discipline">Discipline</a></li>
          <li><a href="/lume-life">Lume Life</a></li>
          <li><a href="/lume-life#eventi">Eventi</a></li>
          <li><a href="/lume-life#help">Help desk</a></li>
          <li><a href="/abbonamenti">Abbonamenti</a></li>
          <li><a href="/scuola-nuoto">Scuola nuoto bambini</a></li>
          <li><a href="/planning/macerata">Planning Macerata</a></li>
          <li><a href="/planning/montecassiano">Planning Montecassiano</a></li>
          <li><a href="/prova">Prova 7 giorni</a></li>
          <li><a href="/invita">Invita un amico</a></li>
          <li><a href="/iscriviti">Iscriviti</a></li>
        </ul>
      </div>
      <div>
        <h4>Contatti</h4>
        <ul>
          <li><a href="/contatti">Scrivici</a></li>
          <li><a href="mailto:info@lumefitness.it">info@lumefitness.it</a></li>
          <li><a href={`tel:${telefono.link}`}>{telefono.visibile}</a></li>
          <li class="foot-social">
            {
              social.map((s) => (
                <a href={s.url} target="_blank" rel="noopener me">
                  {s.nome}
                </a>
              ))
            }
          </li>
        </ul>
      </div>
    </div>
    <div class="copy">
      <span>© {anno} Lume Fitness Club</span>
      <span>
        <a href="/regolamento">Termini e Condizioni</a> ·
        <a href="/privacy">Privacy</a> ·
        <a href="/cookie-policy">Cookie</a>
        {/*
          `iubenda-cs-preferences-link` riapre l'intero banner. La classe
          `iubenda-advertising-preferences-link` che stava qui prima apre solo
          le preferenze pubblicitarie TCF: sulla maggior parte delle
          configurazioni non apre niente, e il link resta un salto a inizio
          pagina. E senza gestore configurato non lo mostriamo affatto:
          "Preferenze cookie" che non fa nulla è peggio che assente.
        */}
        {consensoGestito && (
          <>
            {' · '}
            <a href="#" class="iubenda-cs-preferences-link">Preferenze cookie</a>
          </>
        )}
      </span>
    </div>
  </div>
</footer>

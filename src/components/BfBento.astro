---
/** Foto in stile bento della landing Black Week: stessa griglia, stessa altezza, stessi angoli in ogni sezione. */
interface Props { foto: { src: string; alt: string }[] }
const { foto } = Astro.props;
---
<div class={`bento n${foto.length}`}>
  {foto.map((f) => <img src={f.src} alt={f.alt} loading="lazy" width="900" height="600" />)}
</div>

<style>
  .bento { display: grid; gap: 10px; height: 340px; grid-template-rows: 1fr 1fr; }
  .bento img { width: 100%; height: 100%; min-height: 0; object-fit: cover; border-radius: 22px; display: block; }
  .bento.n2 { grid-template-columns: 1fr 1fr; grid-template-rows: 1fr; }
  .bento.n3 { grid-template-columns: 2fr 1fr; }
  .bento.n4 { grid-template-columns: 2fr 1fr 1fr; }
  .bento.n3 img:first-child, .bento.n4 img:first-child, .bento.n4 img:last-child { grid-row: span 2; }
  @media (max-width: 600px) {
    .bento { height: 260px; }
    .bento.n4 { grid-template-columns: 2fr 1fr; }
    .bento.n4 img:last-child { grid-row: auto; }
  }
</style>

---
/**
 * Markup puro del lead form. Nessuna logica: tutti gli id sono generati dal
 * `prefix`, così due istanze (modal + inline) convivono nella stessa pagina
 * senza collisioni. La logica vive in `src/lib/leadForm.client.js` e si aggancia
 * al contratto di id / data-attribute definito qui sotto.
 *
 * Centri e interessi non sono hardcoded: arrivano dalle content collection,
 * così il form resta allineato al catalogo senza manutenzione doppia.
 */
import { getCollection } from 'astro:content';
import { interessiLead } from '../data/tassonomie';

interface Props {
  /** Prefisso breve e univoco per gli id, es. "lm" (modal) o "li" (inline). */
  prefix: string;
}

const { prefix: P } = Astro.props;

const centri = (await getCollection('centri')).sort((a, b) => a.data.ordine - b.data.ordine);

// Gli interessi NON derivano da `discipline.categoria`: quella tassonomia
// descrive come ti muovi (Acqua, Combat, Mente & corpo) e serve a navigare il
// catalogo, non a instradare un contatto. Su "Acqua" collassavano acquagym
// adulti, scuola nuoto bambini, acqua nido e agonismo: quattro conversazioni
// commerciali diverse. `interessiLead` le tiene distinte, con le stesse
// etichette dei Typeform da cui arrivano i lead oggi.
const interessi = interessiLead;

const prefissi = ['+39', '+41', '+44', '+33', '+49', '+34', '+1'];
---

<div class="lf" data-lead-form>
  <!-- Indicatore di avanzamento -->
  <div class="lf-dots" aria-hidden="true">
    <span data-step-dot="1" class="on"></span>
    <span data-step-dot="2"></span>
    <span data-step-dot="3"></span>
  </div>

  <!-- ─── STEP 1 — email, centro, interessi ─────────────────────────── -->
  <div data-step="1">
    <h3 class="lf-title d">Parliamone</h3>
    <p class="lf-sub">Dicci dove vuoi allenarti e come possiamo aiutarti. Ci vogliono trenta secondi.</p>

    <label class="lf-lab" for={`${P}-email`}>La tua email</label>
    <input
      class="lf-in"
      type="email"
      id={`${P}-email`}
      name="email"
      placeholder="nome@esempio.it"
      autocomplete="email"
      inputmode="email"
      required
    />

    <span class="lf-lab">Quale centro ti interessa</span>
    <div class="lf-chips">
      {
        centri.map((c) => (
          <label class="lf-chip">
            <input
              type="radio"
              name={`${P}-centro`}
              value={c.id}
              data-label={c.data.nome}
              data-pg={c.data.perfectgymUrl}
            />
            <span>
              {c.data.nome}
              {c.data.stato !== 'aperto' && <em>prossima apertura</em>}
            </span>
          </label>
        ))
      }
    </div>

    {
      interessi.length > 0 && (
        <>
          <span class="lf-lab">Cosa ti interessa <small>(opzionale)</small></span>
          <div class="lf-chips">
            {interessi.map((v) => (
              <label class="lf-chip">
                <input type="checkbox" name={`${P}-attivita`} value={v.id} data-label={v.label} />
                <span>{v.label}</span>
              </label>
            ))}
          </div>
        </>
      )
    }

    <p class="lf-err" id={`${P}-step1-err`} role="alert" hidden></p>

    <button type="button" class="btn btn-red btn-full lf-next" id={`${P}-step1-next`}>
      <span class="lf-btn-txt">Continua</span>
      <span class="loader" aria-hidden="true"></span>
    </button>
  </div>

  <!-- ─── STEP 2 — anagrafica (solo nuovi contatti) ──────────────────── -->
  <div data-step="2" hidden>
    <h3 class="lf-title d">Piacere di conoscerti</h3>
    <p class="lf-sub">Due informazioni e ti mettiamo in contatto con il centro giusto.</p>

    <div class="lf-row2">
      <div>
        <label class="lf-lab" for={`${P}-nome`}>Nome</label>
        <input class="lf-in" type="text" id={`${P}-nome`} autocomplete="given-name" />
      </div>
      <div>
        <label class="lf-lab" for={`${P}-cognome`}>Cognome</label>
        <input class="lf-in" type="text" id={`${P}-cognome`} autocomplete="family-name" />
      </div>
    </div>

    <label class="lf-lab" for={`${P}-cell`}>Cellulare</label>
    <div class="lf-tel">
      <select class="lf-in lf-pfx" id={`${P}-pfx`} aria-label="Prefisso internazionale">
        {prefissi.map((p) => <option value={p}>{p}</option>)}
      </select>
      <input
        class="lf-in"
        type="tel"
        id={`${P}-cell`}
        placeholder="333 1234567"
        autocomplete="tel-national"
        inputmode="tel"
      />
    </div>

    <label class="lf-check">
      <input type="checkbox" id={`${P}-privacy`} />
      <span>
        Ho letto e accetto l’<a href="/privacy" target="_blank" rel="noopener">informativa privacy</a>.
        <b aria-hidden="true">*</b>
      </span>
    </label>
    <label class="lf-check">
      <input type="checkbox" id={`${P}-marketing`} />
      <span>Voglio ricevere novità, promozioni ed eventi di Lume.</span>
    </label>

    <p class="lf-err" id={`${P}-step2-err`} role="alert" hidden></p>

    <div class="lf-actions">
      <button type="button" class="btn btn-out" id={`${P}-step2-back`} data-step-back="1">Indietro</button>
      <button type="button" class="btn btn-red lf-grow" id={`${P}-step2-next`}>Continua</button>
    </div>
  </div>

  <!-- ─── STEP 3 — scelta azione ─────────────────────────────────────── -->
  <div data-step="3" hidden>
    <h3 class="lf-title d">Come preferisci?</h3>
    <p class="lf-sub">Scegli il modo più comodo per te. Rispondiamo sempre.</p>

    <div class="lf-opts">
      <button type="button" class="lf-opt" data-action="callback">
        <strong>Fatti richiamare</strong>
        <span>Scegli giorno e ora, ti chiamiamo noi.</span>
      </button>
      <button type="button" class="lf-opt" data-action="visit">
        <strong>Vieni a trovarci</strong>
        <span>Prenota una visita guidata del centro.</span>
      </button>
      <button type="button" class="lf-opt" data-action="message">
        <strong>Scrivici</strong>
        <span>Raccontaci cosa ti serve, ti rispondiamo via email.</span>
      </button>
    </div>

    <div class="lf-actions">
      <button type="button" class="btn btn-out" id={`${P}-step3-back`} data-step-back="1">Indietro</button>
    </div>
  </div>

  <!-- ─── STEP 4a — richiamata ───────────────────────────────────────── -->
  <div data-step="4-callback" hidden>
    <h3 class="lf-title d">Quando ti chiamiamo?</h3>
    <p class="lf-sub">Scegli il momento migliore nei prossimi giorni.</p>

    <div class="lf-cal" id={`${P}-cal-cb`} data-cal-type="cb"></div>

    <div id={`${P}-slots-wrap-cb`} data-cal-type="cb" hidden>
      <span class="lf-lab">Orario</span>
      <div id={`${P}-cal-slots-cb`}></div>
    </div>

    <label class="lf-lab" for={`${P}-cb-reason`}>Di cosa vuoi parlare <small>(opzionale)</small></label>
    <textarea class="lf-in" id={`${P}-cb-reason`} rows="3" placeholder="Es. vorrei capire quale abbonamento fa per me"></textarea>

    <p class="lf-err" id={`${P}-cb-err`} role="alert" hidden></p>

    <div class="lf-actions">
      <button type="button" class="btn btn-out" data-step-back="3">Indietro</button>
      <button type="button" class="btn btn-red lf-grow" id={`${P}-cb-confirm`}>
        <span class="lf-btn-txt">Conferma richiamata</span>
        <span class="loader" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <!-- ─── STEP 4b — visita in sede ───────────────────────────────────── -->
  <div data-step="4-visit" hidden>
    <h3 class="lf-title d">Quando passi?</h3>
    <p class="lf-sub">Ti facciamo fare il giro del centro e ti spieghiamo tutto di persona.</p>

    <div class="lf-cal" id={`${P}-cal-visit`} data-cal-type="visit"></div>

    <div id={`${P}-slots-wrap-visit`} data-cal-type="visit" hidden>
      <span class="lf-lab">Orario</span>
      <div id={`${P}-cal-slots-visit`}></div>
    </div>

    <label class="lf-lab" for={`${P}-visit-reason`}>Qualcosa che dovremmo sapere <small>(opzionale)</small></label>
    <textarea class="lf-in" id={`${P}-visit-reason`} rows="3" placeholder="Es. vengo con un'amica, ci interessa il Reformer"></textarea>

    <p class="lf-err" id={`${P}-visit-err`} role="alert" hidden></p>

    <div class="lf-actions">
      <button type="button" class="btn btn-out" data-step-back="3">Indietro</button>
      <button type="button" class="btn btn-red lf-grow" id={`${P}-visit-confirm`}>
        <span class="lf-btn-txt">Conferma visita</span>
        <span class="loader" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <!-- ─── STEP 4c — messaggio libero ─────────────────────────────────── -->
  <div data-step="4-message" hidden>
    <h3 class="lf-title d">Raccontaci</h3>
    <p class="lf-sub">Scrivi qui la tua richiesta: ti rispondiamo via email.</p>

    <textarea class="lf-in" id={`${P}-msg-text`} rows="6" placeholder="Come possiamo aiutarti?"></textarea>

    <p class="lf-err" id={`${P}-msg-err`} role="alert" hidden></p>

    <div class="lf-actions">
      <button type="button" class="btn btn-out" data-step-back="3">Indietro</button>
      <button type="button" class="btn btn-red lf-grow" id={`${P}-msg-send`}>
        <span class="lf-btn-txt">Invia messaggio</span>
        <span class="loader" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <!-- ─── Conferme ───────────────────────────────────────────────────── -->
  <div data-step="confirm-callback" hidden>
    <div class="lf-ok">✓</div>
    <h3 class="lf-title d">Ti chiamiamo noi</h3>
    <p class="lf-sub">Ti richiamiamo <b id={`${P}-cb-when`}></b>.</p>
    <p class="lf-recap" id={`${P}-cb-summary`}></p>
    <button type="button" class="btn btn-cream btn-full" data-lm-close>Perfetto</button>
  </div>

  <div data-step="confirm-visit" hidden>
    <div class="lf-ok">✓</div>
    <h3 class="lf-title d">Ti aspettiamo</h3>
    <p class="lf-sub">Visita prenotata per <b id={`${P}-visit-when`}></b>.</p>
    <p class="lf-recap" id={`${P}-visit-summary`}></p>
    <button type="button" class="btn btn-cream btn-full" data-lm-close>Perfetto</button>
  </div>

  <div data-step="confirm-message" hidden>
    <div class="lf-ok">✓</div>
    <h3 class="lf-title d">Messaggio inviato</h3>
    <p class="lf-sub">Ti rispondiamo entro un giorno lavorativo.</p>
    <p class="lf-recap" id={`${P}-msg-summary`}></p>
    <button type="button" class="btn btn-cream btn-full" data-lm-close>Chiudi</button>
  </div>

  <!--
    Passo verso il portale, comune alle tre conferme: compare solo per chi e'
    arrivato da un piano di /abbonamenti e solo se quella sede ha un URL vero.
    Uno solo qui invece di tre copie dentro i blocchi di conferma.
  -->
  <p class="lf-pg" data-pg-link hidden>
    Vuoi completare subito? <a href="#" target="_blank" rel="noopener">Attiva l'abbonamento su PerfectGym</a>
  </p>
</div>

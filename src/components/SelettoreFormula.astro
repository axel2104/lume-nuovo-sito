---
/**
 * Le tre formule di pagamento, come tre pillole da spuntare.
 *
 * Nessun JavaScript: sono radio, e a nascondere i prezzi delle altre due
 * formule ci pensa `:has()` in `global.css`, che cerca `data-pf` dentro il
 * `.pf-scope` piu' vicino. L'attributo e non l'`id`, perche' una pagina puo'
 * avere molti listini — /abbonamenti li ha tutti — e regole scritte su un
 * `id` funzionano per il primo e lasciano muti gli altri.
 *
 * Il `prefisso` serve comunque: `id` e `name` devono restare unici nella
 * pagina, o le radio di due listini diventano un gruppo solo e spuntarne una
 * spegne l'altra.
 *
 * L'ordine non e' neutro: si parte dalla soluzione unica perche' e' quella
 * che conviene, e si chiude col mensile, che e' la via d'uscita per chi non
 * vuole impegnarsi. Invertirlo vorrebbe dire aprire dal prezzo piu' alto.
 */
import { FORMULE } from '../data/abbonamenti';

type Props = {
  /** Prefisso degli `id` e nome del gruppo. Un valore diverso per selettore. */
  prefisso?: string;
};

const { prefisso = 'f' } = Astro.props;

---

<fieldset class="pf">
  <legend class="sr-only">Come vuoi pagare</legend>
  {FORMULE.map((f, i) => (
    <>
      <input
        type="radio"
        name={`formula-${prefisso}`}
        id={`${prefisso}-${f.id}`}
        data-pf={f.id}
        checked={i === 0}
      />
      <label for={`${prefisso}-${f.id}`}>{f.label}<span>{f.nota}</span></label>
    </>
  ))}
</fieldset>

---
/**
 * Form "Contattaci" embeddato in pagina. Stessa logica del modal, prefisso
 * diverso: le due istanze possono convivere nella stessa pagina.
 */
import LeadFormBody from './LeadFormBody.astro';
---

<div id="lfi-root" class="lf-inline">
  <LeadFormBody prefix="li" />
</div>

<script>
  import { initLeadForm } from '../lib/leadForm.client.js';

  const root = document.getElementById('lfi-root');
  if (root) {
    const form = initLeadForm(root, { prefix: 'li' });
    form?.open(location.pathname, 'Form inline');
  }
</script>

# Copia questo file in `.env` e compila i valori.
# Tutte le variabili PUBLIC_* finiscono nel bundle client: non metterci segreti.

# Google Tag Manager — vuoto = GTM non viene caricato
PUBLIC_GTM_ID=

# Iubenda Cookie Solution — servono entrambi perché il banner venga caricato.
# Finché sono vuoti il tracciamento parte SENZA gate di consenso: va bene in
# sviluppo, non deve mai andare in produzione così.
PUBLIC_IUBENDA_SITE_ID=
PUBLIC_IUBENDA_COOKIE_POLICY_ID=

# Webhook n8n — vuoti = fallback (check risponde "nuovo", lead loggato in console)
PUBLIC_WEBHOOK_CHECK=
PUBLIC_WEBHOOK_LEAD=

# Ping di pageview — opzionale, vuoto = disattivato.
# Il body arriva come text/plain (obbligatorio per evitare il preflight CORS di
# sendBeacon): il workflow n8n deve fare JSON.parse() sul body grezzo PRIMA di
# mappare i campi. Campi attesi: vid, pagina, referrer, utm.
# `created_at` va messo con default now() a livello di database, mai dal client.
PUBLIC_WEBHOOK_VISIT=

# ─── Keystatic (editor dei contenuti) ────────────────────────────────────
# In sviluppo non serve nulla: `npm run dev` e vai su /keystatic, scrive sui
# file locali. Queste variabili servono solo per l'editor ONLINE, che salva
# facendo commit su GitHub.
# Si ottengono in automatico visitando /keystatic/setup sul sito deployato:
# la procedura crea la GitHub App e stampa i valori da incollare qui e su
# Netlify (Site settings -> Environment variables).
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

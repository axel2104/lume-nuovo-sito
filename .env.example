# Copia questo file in `.env` e compila i valori.
# Tutte le variabili PUBLIC_* finiscono nel bundle client: non metterci segreti.

# Google Tag Manager — vuoto = GTM non viene caricato
PUBLIC_GTM_ID=

# Meta Pixel — il dataset ID di Events Manager (15-16 cifre).
#
# Vuoto = nessun pixel: il codice resta in pagina ma non parte. Nessun default
# di proposito, al contrario degli ID Iubenda qui sotto: un pixel scritto nel
# codice manderebbe eventi al dataset di produzione anche dalle anteprime di
# deploy, e in Events Manager quei numeri non si separano più. In produzione si
# incolla nelle env di Netlify.
#
# Il pixel parte solo col consenso alla finalità 5 di Iubenda (targeting e
# pubblicità) e manda tre eventi standard: Lead, Schedule,
# CompleteRegistration. Il token della Conversions API non va qui: è un
# segreto, e la CAPI vivrà in n8n.
PUBLIC_META_PIXEL_ID=

# Iubenda Cookie Solution.
#
# NON servono: gli ID reali dell'account Lume sono già i default in
# src/config/site.ts (siteId 3771007, cookiePolicyId 91706111). Sono
# identificativi PUBBLICI — stanno in chiaro nell'HTML di ogni sito che usa
# Iubenda — quindi non c'è niente da proteggere, e averli nel codice evita che
# una build fatta prima di configurare l'ambiente vada online senza banner.
#
# Queste variabili servono solo per puntare a un ALTRO account, tipicamente in
# un ambiente di prova. Se le compili, hanno la precedenza sui default.
PUBLIC_IUBENDA_SITE_ID=
PUBLIC_IUBENDA_COOKIE_POLICY_ID=

# Webhook n8n — vuoti = fallback (check risponde "nuovo", lead loggato in console)
#
# CHECK riceve { email, sede, centro, attivita, flusso, pagina, cta, utm, vid }
# e deve rispondere { stato: "nuovo" | "esiste[_gruppo]" | "iscritto[_gruppo]" }.
# Da questa risposta dipende una regola commerciale, non solo la UI: il pass
# prova viene negato a chi è già stato iscritto. Se il webhook è giù il form
# tratta tutti come "nuovo" — meglio un lead da qualificare che un utente
# bloccato da un errore che non è suo.
#
# LEAD riceve il payload completo del form. Il contratto campo per campo, con la
# mappatura sulla tabella RICHIESTE di Airtable, è in docs/FORM.md.
# Gli endpoint esistono (creati il 3 settembre 2026), ma qui restano vuoti:
# chi copia questo file in .env per lavorare in locale non deve ritrovarsi a
# scrivere lead veri in Airtable. In produzione si incollano nelle env di
# Netlify:
#   PUBLIC_WEBHOOK_CHECK=https://n8n.lumeflow.it/webhook/lume-verifica
#   PUBLIC_WEBHOOK_LEAD=https://n8n.lumeflow.it/webhook/lume-lead
# CHECK per ultima: la sua risposta e' pubblica e i campi opzionali nome,
# cognome e cellulare esporrebbero i dati di un iscritto a chiunque provi
# un'email. Vedi docs/N8N.md.
PUBLIC_WEBHOOK_CHECK=
PUBLIC_WEBHOOK_LEAD=

# Ping di pageview — opzionale, vuoto = disattivato.
# Il body arriva come text/plain (obbligatorio per evitare il preflight CORS di
# sendBeacon): il workflow n8n deve fare JSON.parse() sul body grezzo PRIMA di
# mappare i campi. Campi attesi: vid, pagina, referrer, utm.
# `created_at` va messo con default now() a livello di database, mai dal client.
# In produzione: https://n8n.lumeflow.it/webhook/lume-visita
PUBLIC_WEBHOOK_VISIT=

# Webhook planning — restituisce l'orario corsi aggiornato di un centro.
#
# Interrogato dal BROWSER con ?centro=<slug>, deve rispondere:
#   { "aggiornatoIl": "2026-08-20T04:00:00+02:00", "lezioni": [ ... ] }
#
# Essendo chiamato dal browser serve CORS: il workflow deve rispondere con
# Access-Control-Allow-Origin sul dominio del sito. Senza quell'header la
# richiesta muore nel browser e la pagina resta sullo snapshot dei contenuti
# senza nessun errore visibile — il classico guasto silenzioso.
#
# Vuoto = nessun aggiornamento tentato, si mostra solo lo snapshot.
# Contratto completo in docs/PLANNING.md
# Deciso: questa resta vuota. Il planning vive nei contenuti, non c'e' nessun
# workflow n8n che lo serve.
PUBLIC_WEBHOOK_PLANNING=

# ─── Cal.com (prenotazione visite e richiamate) ──────────────────────────
# Origine dell'istanza da cui caricare l'embed.
#   cloud        → https://cal.com  (valore di default se lasciata vuota)
#   self-hosted  → https://cal.lumefitness.it
# Il passaggio da cloud a self-hosted è solo questa variabile: nessuna modifica
# al codice. Gli event type per sede stanno nei contenuti, non qui — campo
# `calcom.visita` / `calcom.richiamata` in src/content/centri/*.md — perché sono
# dati editoriali che cambiano per centro, non configurazione di ambiente.
#
# Finché gli event type sono vuoti i form registrano il lead e mostrano
# "ti contattiamo noi" al posto del calendario. Nessuna rottura, solo un
# appuntamento in meno.
PUBLIC_CALCOM_ORIGIN=

# ─── Keystatic (editor dei contenuti) ────────────────────────────────────
# In sviluppo non serve nulla: `npm run dev` e vai su /keystatic, scrive sui
# file locali. Queste variabili servono solo per l'editor ONLINE, che salva
# facendo commit su GitHub.
#
# COME OTTENERLE (va fatto in LOCALE, non sul sito pubblicato: la procedura
# scrive un .env su disco e su Netlify il filesystem e' in sola lettura):
#   1. crea un file .env con dentro solo:  PUBLIC_KEYSTATIC_STORAGE=github
#   2. npm run dev  e apri http://localhost:4321/keystatic
#   3. segui la procedura: crea la GitHub App e installala sul repo.
#      Al termine trovi le quattro variabili qui sotto scritte nel tuo .env
#   4. nelle impostazioni della GitHub App aggiungi anche la callback di
#      produzione, altrimenti online GitHub rifiuta il redirect:
#      https://lumesitoproposta.netlify.app/api/keystatic/github/oauth/callback
#   5. copia le quattro variabili su Netlify e RILANCIA UN DEPLOY: le
#      variabili non si applicano alle build gia' fatte
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# Mostra l'orario di esempio del planning quando un centro non ha ancora il suo.
# Serve solo per vedere il layout su un'anteprima.
#
# DA RIMUOVERE dalle variabili Netlify: il planning ora è quello reale, con 101
# lezioni a Macerata e 51 a Montecassiano, e questa variabile può solo
# confondere chi guarda.
PUBLIC_PLANNING_ESEMPIO=

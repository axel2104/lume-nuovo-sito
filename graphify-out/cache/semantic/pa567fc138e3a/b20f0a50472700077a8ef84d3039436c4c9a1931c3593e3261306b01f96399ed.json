{"nodes": [{"id": "docs_n8n", "label": "N8N.md \u2014 specifica dei quattro webhook", "file_type": "document", "source_file": "docs/N8N.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_n8n_webhook_check", "label": "Webhook di verifica (PUBLIC_WEBHOOK_CHECK / lume-verifica)", "file_type": "concept", "source_file": "docs/N8N.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Se il workflow \u00e8 gi\u00f9 il sito tratta l'utente come 'nuovo' e prosegue: meglio un lead da qualificare a mano che un visitatore bloccato da un guasto che non \u00e8 suo. I campi opzionali nome/cognome/cellulare sono sconsigliati perch\u00e9 l'endpoint \u00e8 pubblico e consentirebbe enumerazione dell'anagrafica soci."}, {"id": "docs_n8n_webhook_lead", "label": "Webhook del lead (PUBLIC_WEBHOOK_LEAD / lume-lead)", "file_type": "concept", "source_file": "docs/N8N.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Il lead va registrato prima di notifiche e integrazioni: i nodi che seguono possono fallire in silenzio, e la prima riga scritta \u00e8 la ricevuta che dimostra che il contatto \u00e8 arrivato. Si risponde 200 anche se la notifica fallisce, per evitare doppioni da reinvio."}, {"id": "docs_n8n_webhook_visit", "label": "Beacon di pageview (PUBLIC_WEBHOOK_VISIT / lume-visita)", "file_type": "concept", "source_file": "docs/N8N.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Il body \u00e8 JSON con Content-Type text/plain: sendBeacon con content-type non safelisted scatenerebbe un preflight CORS che fallisce silenziosamente; text/plain \u00e8 safelisted e la richiesta parte sempre."}, {"id": "docs_n8n_webhook_booking", "label": "Webhook Cal.com BOOKING_CREATED (lume-booking)", "file_type": "concept", "source_file": "docs/N8N.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Il lead viene scritto prima che l'utente veda il calendario, cos\u00ec chi abbandona la prenotazione resta un contatto acquisito: BOOKING_CREATED deve ritrovare e completare il record esistente (chiave vid, poi email), non crearne uno nuovo."}, {"id": "docs_n8n_airtable_richieste", "label": "Airtable \u2014 base LUME FITNESS, tabella RICHIESTE", "file_type": "concept", "source_file": "docs/N8N.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Le stringhe delle select sono un contratto: la creazione automatica delle opzioni va disattivata, perch\u00e9 un typo nel sito genererebbe silenziosamente un'opzione nuova e i filtri salvati dei consulenti smetterebbero di restituire quei record."}, {"id": "docs_n8n_perfectgym_api", "label": "PerfectGym OData API (lumefitness.perfectgym.com)", "file_type": "concept", "source_file": "docs/N8N.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_n8n_vid", "label": "vid \u2014 identificativo persistente del browser", "file_type": "concept", "source_file": "docs/N8N.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Il vid lega il lead alle pagine viste e alle prenotazioni Cal.com: con quello si ricostruisce il percorso di navigazione che ha portato al lead, cosa che email e telefono non permettono."}], "edges": [{"source": "docs_n8n", "target": "docs_n8n_webhook_check", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/N8N.md", "source_location": null, "weight": 1.0}, {"source": "docs_n8n", "target": "docs_n8n_webhook_lead", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/N8N.md", "so
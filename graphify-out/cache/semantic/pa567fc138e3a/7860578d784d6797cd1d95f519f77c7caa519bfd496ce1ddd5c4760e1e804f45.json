{"nodes": [{"id": "docs_supabase", "label": "SUPABASE.md \u2014 anagrafica e richieste, fase 1", "file_type": "document", "source_file": "docs/SUPABASE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Il browser non ha mai una credenziale di database: il sito manda a n8n, n8n scrive prima su Supabase (ricevuta del lead) e poi su Airtable, perch\u00e9 un nodo Airtable pu\u00f2 fallire in silenzio e un lead perso \u00e8 perso."}, {"id": "docs_supabase_utenti", "label": "Tabella Supabase utenti", "file_type": "concept", "source_file": "docs/SUPABASE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_supabase_richieste", "label": "Tabella Supabase richieste", "file_type": "concept", "source_file": "docs/SUPABASE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Una tabella sola per tutti i flussi e non quattro: i flussi hanno gli stessi campi con valori diversi, e su Airtable \u00e8 gi\u00e0 cos\u00ec \u2014 rende la copia verso Airtable un mapping diretto campo per campo."}, {"id": "docs_supabase_trova_o_crea_utente", "label": "trova_o_crea_utente() e trigger aggancia_utente()", "file_type": "concept", "source_file": "docs/SUPABASE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "La deduplica sta in Postgres e non in n8n: un workflow che cerca prima e inserisce dopo perde la corsa contro s\u00e9 stesso appena due form partono insieme. Il trigger non solleva mai: un errore nell'anagrafica non deve trasformarsi in un lead perso."}, {"id": "docs_supabase_rls_zero_policy", "label": "RLS attiva con zero policy", "file_type": "rationale", "source_file": "docs/SUPABASE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ogni tabella ha RLS attiva e nessuna policy: \u00e8 il modo di dire 'passa solo la service key'. Una policy anon su queste tabelle \u00e8 un elenco di lead pubblicato."}, {"id": "docs_supabase_dedup_mai_telefono", "label": "Deduplica su id PerfectGym o email, mai sul telefono", "file_type": "rationale", "source_file": "docs/SUPABASE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "I corsi junior si iscrivono col numero del genitore: unire sul telefono fonderebbe madre e figlio in una persona sola, l'errore pi\u00f9 difficile da disfare."}], "edges": [{"source": "docs_supabase", "target": "docs_form", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/SUPABASE.md", "source_location": null, "weight": 1.0}, {"source": "docs_supabase", "target": "docs_n8n_webhook_lead", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/SUPABASE.md", "source_location": null, "weight": 1.0}, {"source": "docs_supabase", "target": "docs_n8n_airtable_richieste", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/SUPABASE.md", "source_location": null, "weight": 1.0}, {"source": "docs_supabase", "target": "docs_supabase_utenti", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/SUPABASE.md", "source_location": null, "weight": 1.0}, {"source": "docs_supabase", "target": "docs_supabase_richieste", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/SUPABASE.md", "source_location": null, "weight": 1.0}, {"source": "docs_supabase", "target": "docs_supabase_trova_o_crea_utente", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/SUPABASE.md", "source_location": null, "weight": 1.0}, {"source": "docs_supabase", "target": "docs_supabase_rls_zero_po
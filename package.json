    "verifica:browser": "npm run verifica:pagine && npm run verifica:form && npm run verifica:form-completo && npm run verifica:video",
    "verifica:pagine": "node verifica/pagine.mjs",
    "verifica:form": "node verifica/form.mjs",
    "verifica:form-completo": "node verifica/form-completo.mjs",
    "verifica:video": "node verifica/video.mjs",
    "verifica:tutto": "npm run build && npm run verifica && npm run verifica:browser"
  },
  "dependencies": {
    "@astrojs/netlify": "^8.2.0",
    "@astrojs/react": "^6.0.2",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@keystatic/astro": "^5.2.0",
    "@keystatic/core": "^0.6.4",
    "astro": "^7.1.3",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.2"
  }
}

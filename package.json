{
  "name": "lume-fitness-club",
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro check && astro build",
    "build:fast": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "node --test \"test/**/*.test.mjs\"",
    "verifica": "npm run verifica:contenuti && npm run test",
